      "records": [
        {
          "index": 0,
          "address": 52762,
          "offset_in_resource": 1,
          "length": 22,
          "text_escaped": "Недостаточно кредитов!"
        },
        {
          "index": 1,
          "address": 52785,
          "offset_in_resource": 24,
          "length": 22,
          "text_escaped": "В наличии уже имеется!"
        },
        {
          "index": 2,
          "address": 52808,
          "offset_in_resource": 47,
          "length": 19,
          "text_escaped": "Превышение тоннажа!"
        },
        {
          "index": 3,
          "address": 52828,
          "offset_in_resource": 67,
          "length": 32,
          "text_escaped": "Ваш корабль находится в розыске!"
        },
        {
          "index": 4,
          "address": 52861,
          "offset_in_resource": 100,
          "length": 32,
          "text_escaped": "Отсутствует объект модернизации!"
        },
        {
          "index": 5,
          "address": 52894,
          "offset_in_resource": 133,
          "length": 33,
          "text_escaped": "Превышено разрешённое количество!"
        },
        {
          "index": 6,
          "address": 52928,
          "offset_in_resource": 167,
          "length": 36,
          "text_escaped": "Оснащение не может быть установлено!"
        },
        {
          "index": 7,
          "address": 52965,
          "offset_in_resource": 204,
          "length": 45,
          "text_escaped": "В системе такой вид оснащения не реализуется!"
        },
        {
          "index": 8,
          "address": 53011,
          "offset_in_resource": 250,
          "length": 14,
          "text_escaped": "Нет в наличии!"
        },
        {
          "index": 9,
          "address": 53026,
          "offset_in_resource": 265,
          "length": 57,
          "text_escaped": "Сделка незаконна!\\x0DВы облагаетесь штрафом в 1000 кредитов!"
        },
        {
          "index": 10,
          "address": 53084,
          "offset_in_resource": 323,
          "length": 42,
          "text_escaped": "Превышение максимальной разрешенной суммы!"
        },
        {
          "index": 11,
          "address": 53127,
          "offset_in_resource": 366,
          "length": 22,
          "text_escaped": "Сделка прошла успешно!"
        },
        {
          "index": 12,
          "address": 53150,
          "offset_in_resource": 389,
          "length": 35,
          "text_escaped": "Подобный тип оснащения уже имеется!"
        },
        {
          "index": 13,
          "address": 53186,
          "offset_in_resource": 425,
          "length": 55,
          "text_escaped": "За неоплату стоянки, Вы выдворяетесь в открытый космос!"
        },
        {
          "index": 14,
          "address": 53242,
          "offset_in_resource": 481,
          "length": 160,
          "text_escaped": "Вы находитесь в розыске!\\x0DВсе тяжёлое вооружение с вашего корабля будет демонтировано в пользу государства.\\x0DПомимо всего, Вы будете оштрафованы на 1000 кредитов."
        },
        {
          "index": 15,
          "address": 53403,
          "offset_in_resource": 642,
          "length": 159,
          "text_escaped": "Галактическая полиция предупреждает Вас о том, что Вы уже числитесь как неблагоприятный гражданин.\\x0DВ целях предупреждения Вы будете оштрафованы на 50 кредитов."
        },
        {
          "index": 16,
          "address": 53563,
          "offset_in_resource": 802,
          "length": 126,
          "text_escaped": "За неисполнение контракта вы оштафовуетесть на 1000 кредитов. \\x0DОштрафование произедено по типу 5-ти кратная оплата за стоянку!"
        }
      ],
      "consumer": "Source/Station/DrawQueuedMessagePanel.asm"
