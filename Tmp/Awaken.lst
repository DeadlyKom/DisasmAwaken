  39++F154 C8                           RET Z                                                           ; выход, если бит 0 маски сброшен, старшие пары не изменились
  40++F155
  41++F155 7C                           LD A, H
  42++F156 0E 2C                        LD C, #2C
  43++F158 CD 88 F1                     CALL @Controls.DrawCounterNibble.Entry
  44++F15B 7C                           LD A, H
  45++F15C 0F                           RRCA
  46++F15D 0F                           RRCA
  47++F15E 0F                           RRCA
  48++F15F 0F                           RRCA
  49++F160 0E 2B                        LD C, #2B
  50++F162 CD 88 F1                     CALL @Controls.DrawCounterNibble.Entry
  51++F165                              ; проверка переноса из второй пары перед обновлением E
  52++F165 CB 48                        BIT 1, B
  53++F167 C8                           RET Z                                                           ; выход, если бит 1 маски сброшен, две старшие пары не изменились
  54++F168
  55++F168 7B                           LD A, E
  56++F169 0E 29                        LD C, #29
  57++F16B CD 88 F1                     CALL @Controls.DrawCounterNibble.Entry
  58++F16E 7B                           LD A, E
  59++F16F 0F                           RRCA
