  11++A020              ;   таблицы #8200,#8300,#8400 подготовлены исходным построителем, стек и источник не пересекают изменяемый экран
  12++A020              ; Out:
  13++A020              ;   HL увеличен на 128, BC=(входной BC-128) AND #FFFF, AF=#0042, AF' рабочий
  14++A020              ;   при X=0..26 скопированы четыре байта каждой из 32 строк от знакоместа X+1,Y+1
  15++A020              ;   при X=27 возможен дополнительный рост D из-за переноса четырёх LDI, в том числе запись в атрибуты, это исходное поведение
