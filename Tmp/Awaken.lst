  37++C3CE 21 D4 C3                     LD HL, @Text.ReadOtherKeyCodes.NoSuffix
  38++C3D1 C3 EE C7                     JP @Text.ParseFieldSuffix.Entry
  39++C3D4
  40++C3D4                              ; возврат без суффикса, поле характеристики не вычислялось
  41++C3D4 C9           NoSuffix:       RET
  42++C3D5
  43++C3D5                              endmodule
  44++C3D5                              endmodule
