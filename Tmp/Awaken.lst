  57++A7A1 DD 23                        INC IX
  58++A7A3 DD 23                        INC IX
  59++A7A5 28 06                        JR Z, @Station.CloseAllItems.RemoveDraw                         ; переход, если Flags AND #C0 равен нулю, удалить элемент
  60++A7A7
  61++A7A7                              ; проверка совместно установленных битов 6 и 5 через инверсию Flags
  62++A7A7 7E                           LD A, (HL)
  63++A7A8 2F                           CPL
  64++A7A9 E6 60                        AND @InterfaceFlags.ClosePairMask
  65++A7AB 20 DE                        JR NZ, @Station.CloseAllItems.NextDraw                          ; переход, если хотя бы один из битов 6 и 5 сброшен, сохранить этот элемент
