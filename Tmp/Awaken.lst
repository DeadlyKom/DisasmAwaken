  12++A86B              ;   альтернативные и индексные регистры, I и IFF сохранены, SP обычного возврата равен входному SP+2
  13++A86B              ;   порт и тень выбирают сначала банк 0 с ROM 1, затем банк 6 с ROM 1, старшие биты сохраняются
  14++A86B              ; Corrupt:
  15++A86B              ;   HL, DE, AF
  16++A86B              ; Note:
  17++A86B              ;   A строки сохраняется через первый выбор банка, затем передаётся QueueTextRow
  18++A86B              ;   последний выбор страницы заменяет основной AF, исходный RAM-банк не восстанавливается
  19++A86B                              ; сохранение строки вокруг выбора станционного банка
  20++A86B F5           Entry:          PUSH AF
  21++A86C                              ; выбор банка 0 с ROM 1 перед работой со списком и записью элемента
  22++A86C 3E 10                        LD A, #10
  23++A86E CD 96 63                     CALL @Station.SelectRamBank.Entry
  24++A871                              ; возврат исходного A строки и F перед основным вызовом
  25++A871 F1                           POP AF
  26++A872                              ; подготовка строки и геометрии настоящими станционными процедурами
  27++A872 CD 5F A8                     CALL @Station.QueueTextRow.Entry
  28++A875                              ; возврат LANG в банк 6, финальный AF будет результатом выбора страницы
  29++A875 3E 16                        LD A, #16
  30++A877 CD 96 63                     CALL @Station.SelectRamBank.Entry
  31++A87A C9                           RET
  32++A87B
  33++A87B                              endmodule
  34++A87B                              endmodule
