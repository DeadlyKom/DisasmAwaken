   4++C657              ; Подробный разбор [создание указателя, рамка оператора и отдельный вход Store](../../Docs/ScalarWriters.md)
   5++C657              ; -----------------------------------------
   6++C657              ; Создание указателя писателя байта по #984B
   7++C657              ; исходная запись 5, файловые смещения #0657..#066D
   8++C657              ; In:
   9++C657              ;   Entry принимает HL' следующую позицию стека выражений, доступны два байта записи
  10++C657              ;   для Invoke на CPU-стеке FFieldInvokeFrame, Operator адрес операции, AfterStore адрес продолжения
  11++C657              ;   Invoke принимает BC правый операнд, поле #984B доступно для чтения и записи
  12++C657              ;   оператор получает DE текущее значение, BC правый операнд, возвращает DE через RET с банком LANG 6
  13++C657              ;   Store можно вызвать отдельно с DE результатом и обычным адресом возврата
  14++C657              ; Out:
  15++C657              ;   Entry сохраняет HL, BC и AF, DE адрес Invoke, добавленный в стек выражений
  16++C657              ;   Entry увеличивает HL' на два, DE' становится адресом Invoke, BC', AF', IX, IY, I и IFF сохранены
  17++C657              ;   Invoke заменяет Operator в FFieldInvokeFrame адресом Store, образуя FFieldOperatorFrame, и входит в оператор через JP (HL)
  18++C657              ;   после Invoke и Store поле получает младший E без насыщения, старший D результата не записывается
  19++C657              ;   регистры после Invoke определяются оператором и Store, Store устанавливает A=E, F сохраняет
  20++C657              ;   SP после Entry либо отдельного Store равен входному SP+2, после полного Invoke равен входному SP+4
  21++C657              ; Corrupt:
  22++C657              ;   Entry - DE, HL', DE'
  23++C657              ;   Invoke - HL, DE и регистры по договору выбранного оператора
  24++C657              ;   Store - AF только A
  25++C657              ; Note:
  26++C657              ;   Entry не записывает целевое поле и не исполняет операцию, только добавляет статический указатель
  27++C657              ;   Invoke загружает текущее поле, а не значение на момент создания указателя, код писателя не генерируется заново
  28++C657              ;   байтовые Invoke читают слово, но обнуляют H, соседний байт поля не является частью операнда
  29++C657              ;   игровые единицы поля не выводятся из этой операции записи
  30++C657              ; -----------------------------------------
  31++C657                              ; выбор статического входа Invoke как значения писателя поля
  32++C657 11 5D C6     Entry:          LD DE, @Text.PushByteUWriter.Invoke
  33++C65A                              ; добавление адреса Invoke в стек выражений без выполнения записи поля
  34++C65A C3 B9 C1                     JP @Text.PushExpressionWord.Entry
  35++C65D
  36++C65D                              ; снятие адреса оператора из FFieldInvokeFrame в DE
  37++C65D D1           Invoke:         POP DE
  38++C65E                              ; выбор Store как возврата оператора
  39++C65E 21 69 C6                     LD HL, @Text.PushByteUWriter.Store
  40++C661                              ; замена слова Operator адресом Store, остальная рамка сохраняется
  41++C661 E5                           PUSH HL
  42++C662                              ; чтение текущего значения целевого поля в HL перед обменом с адресом оператора
  43++C662 2A 4B 98                     LD HL, (#984B)
  44++C665 26 00                        LD H, #00
  45++C667 EB                           EX DE, HL
  46++C668 E9                           JP (HL)
  47++C669
  48++C669                              ; сохранение младшего E через A без изменения F в исходное поле
  49++C669 7B           Store:          LD A, E
  50++C66A 32 4B 98                     LD (#984B), A
  51++C66D C9                           RET
  52++C66E
  53++C66E                              endmodule
  54++C66E                              endmodule
  55++C66E
