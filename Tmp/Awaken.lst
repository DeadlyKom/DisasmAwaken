   1++D4CB                              module Controls
   2++D4CB                              module PrepareCircleRightClip
   3++D4CB                              ; Документация [алгоритм и проверка](../../Docs/ControlsCircleSetup.md)
   4++D4CB                              ; -----------------------------------------
   5++D4CB                              ; Подготовка левого криволинейного края и фиксированного правого столбца 31
   6++D4CB                              ; исходная запись 22, банк 1, смещения #14CB..#14E3
   7++D4CB                              ; In:
   8++D4CB                              ;   HL, DE, BC и AF входных аргументов не задают
   9++D4CB                              ;   банк 1 выбран, WorkX, WorkY, CenterY, Radius, Flags и Mode доступны для чтения
  10++D4CB                              ;   на CPU-стеке внешний возврат, ещё два байта нужны для настоящих CALL, IRQ не вмешиваются
  11++D4CB                              ; Out:
  12++D4CB                              ;   для X=(128+WorkX-Radius) AND FF и P=8000+32*CenterY+(X DIV 8)
  13++D4CB                              ;   HL=(P AND FF00) OR ((LOW P) OR 31), D=Radius, E=LOW P
  14++D4CB                              ;   B=(FF << (7-(X AND 7))) AND FF, C=FF, A=LOW HL, F соответствует OR этого A
  15++D4CB                              ;   C'=(-Radius) AND FF, E'=0, остальные альтернативные регистры, IX и IY сохраняются
  16++D4CB                              ;   I, IM и IFF сохраняются, SP=входной SP+2, R получает 58+4*(X AND 7) M1
  17++D4CB                              ; Corrupt:
  18++D4CB                              ;   HL, DE, BC, AF, E', C', два байта CPU-стека, R
  19++D4CB                              ; Note:
  20++D4CB                              ;   маска B включает X, правая маска C=FF сохраняет весь фиксированный край в последующем рисователе
  21++D4CB                              ;   чтение Mode и AND A не влияют на выход, последующий OR полностью заменяет эти флаги
  22++D4CB                              ;   вычисленный адрес не разыменовывается, пиксели и рабочие поля не записываются
  23++D4CB                              ;   без ограничений CenterY это лишь байтово-точная адресная формула, а не обещание допустимого растра
  24++D4CB                              ; -----------------------------------------
  25++D4CB                              ; подготовка радиуса и альтернативного состояния без рисования
  26++D4CB CD 04 D5     Entry:          CALL @Controls.LoadCircleMidpoint.Entry
  27++D4CE                              ; выбор центральной строки для левого криволинейного края
  28++D4CE 3A 83 D1                     LD A, (@ControlsCircleSetupState.CenterY)
  29++D4D1 4F                           LD C, A
  30++D4D2                              ; вычисление X левого края как 128+WorkX-Radius по модулю байта
  31++D4D2 3E 80                        LD A, #80
  32++D4D4 80                           ADD A, B
  33++D4D5 92                           SUB D
  34++D4D6                              ; построение адреса и включающей маски левого края настоящим помощником
  35++D4D6 CD 15 D5                     CALL @Controls.BuildLeftSpanMask.Entry
  36++D4D9                              ; чтение Mode сохранено, его промежуточные флаги ниже заменяет OR
  37++D4D9 3A 8C D1                     LD A, (@ControlsInteriorRowsState.Mode)
  38++D4DC A7                           AND A
  39++D4DD                              ; вычисление адреса фиксированного правого столбца 31 без записи пикселей
  40++D4DD 7B                           LD A, E
  41++D4DE F6 1F                        OR #1F
  42++D4E0 6F                           LD L, A
  43++D4E1                              ; выбор полностью сохраняющей маски фиксированного правого края
  44++D4E1 0E FF                        LD C, #FF
  45++D4E3 C9                           RET
  46++D4E4
  47++D4E4                              endmodule
  48++D4E4                              endmodule
