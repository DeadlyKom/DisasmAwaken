   6++AC38                              ; исходная запись 17, общий код фиксированного банка 2, смещения #4C38..#4C43
   7++AC38                              ; In:
   8++AC38                              ;   HL входных аргументов не задаёт, DE сохраняется, BC задаёт C для копирования в B, AF сохраняется
   9++AC38                              ;   IX указывает младший байт читаемого слова, оба байта доступны в текущем отображении, на стеке внешний возврат, IRQ не вмешиваются
  10++AC38                              ; Out:
  11++AC38                              ;   HL содержит слово из входных (IX) и (IX+1), DE сохраняется, B=входной C, C сохраняется, AF сохраняется
  12++AC38                              ;   HL', DE', BC', AF' сохраняются, IX=(входной IX+2) AND FFFF, IY, I, IM и IFF сохраняются
  13++AC38                              ;   SP=входной SP+2, R получает 10 M1, RAM не записывается
  14++AC38                              ; Corrupt:
  15++AC38                              ;   HL, BC в части B, IX, R
  16++AC38                              ; Note:
  17++AC38                              ;   адрес второго байта и итоговый IX переходят через FFFF по модулю слова, знакового расширения нет
  18++AC38                              ;   при совпадении IX с рамкой возврата читаются её фактические байты, чтение их не меняет
  19++AC38                              ;   дополнительная рамка CPU-стека не создаётся
