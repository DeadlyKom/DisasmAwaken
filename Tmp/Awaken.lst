   1++F188                              module Controls
   2++F188                              module DrawCounterNibble
   3++F188                              ; Документация [алгоритм и проверка](../../Docs/ControlsBcdCounter.md)
   4++F188                              ; -----------------------------------------
   5++F188                              ; Рисование младшей тетрады через общую пару знаков с сохранением основных регистров
   6++F188                              ; исходная запись 23, банк 1, смещения #16AA..#16CC
   7++F188                              ; In:
   8++F188                              ;   HL и DE сохраняются, BC задаёт C колонку 0..255 и сохраняется целиком
   9++F188                              ;   AF задаёт младшую тетраду A, старшие четыре бита не используются
  10++F188                              ;   банк 1 выбран, таблица знаков C600 и экран доступны, на CPU-стеке внешний возврат
  11++F188                              ; Out:
  12++F188                              ;   HL, DE, BC сохранены, выбранная тетрада нарисована в шести строках с H=51..56 и L=floor(C/2)
  13++F188                              ;   код пары равен 10+(входной A AND 0F), значения 0..9 дают цифры, 0A..0F пунктуацию
  14++F188                              ;   основные пары сохраняются через EXX, альтернативные пары становятся рабочими и не восстанавливаются
  15++F188                              ;   IX и IY, I, IM и IFF сохраняются, SP=входной SP+2, дополнительные два байта CPU-стека занимает CALL рисователя
  16++F188                              ; Corrupt:
  17++F188                              ;   AF, HL', DE', BC', AF', шесть экранных байтов, два байта CPU-стека, R
  18++F188                              ; Note:
  19++F188                              ;   проверки колонки и прокрутки нет, C=FF оборачивает увеличенный C в нуль и сохраняет правильную чётность маски
  20++F188                              ;   подпрограмма пригодна для тетрады произвольного байта, её имя не обещает шестнадцатеричные буквы A..F
  21++F188                              ; -----------------------------------------
  22++F188                              ; сохранение основных HL, DE и BC обменом с альтернативным набором
  23++F188 D9           Entry:          EXX
  24++F189                              ; выбор младшей тетрады и смещение к парным знакам цифр в общей таблице
  25++F189 E6 0F                        AND #0F
  26++F18B C6 10                        ADD A, #10
  27++F18D 6F                           LD L, A
  28++F18E CB 85                        RES 0, L
  29++F190 26 00                        LD H, #00
  30++F192 54                           LD D, H
  31++F193 5D                           LD E, L
  32++F194 29                           ADD HL, HL
  33++F195 19                           ADD HL, DE
  34++F196 11 00 C6                     LD DE, #C600
  35++F199 19                           ADD HL, DE
  36++F19A EB                           EX DE, HL
  37++F19B                              ; сохранение чётности индекса знака в альтернативном A для DrawGlyphRows
  38++F19B 08                           EX AF, AF'
  39++F19C                              ; выбор верхней растровой строки числового поля, y=129
  40++F19C 26 51                        LD H, #51
  41++F19E D9                           EXX
  42++F19F 79                           LD A, C
  43++F1A0 D9                           EXX
  44++F1A1 4F                           LD C, A
  45++F1A2                              ; вычисление байта экрана по исходной колонке без изменения основных BC
  46++F1A2 CB 3F                        SRL A
  47++F1A4 6F                           LD L, A
  48++F1A5 0C                           INC C
  49++F1A6                              ; вызов общего рисователя на альтернативных HL, DE и BC
  50++F1A6 CD F1 EF                     CALL @Controls.DrawGlyphRows.Entry
  51++F1A9 D9                           EXX
  52++F1AA C9                           RET
  53++F1AB
  54++F1AB                              endmodule
  55++F1AB                              endmodule
