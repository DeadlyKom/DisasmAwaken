  69++D9D8 E6 F8                        AND @SmallMaskConst.PixelsMask
  70++D9DA                              ; повторное обновление Row00 альтернативной маской после построения остальных строк
  71++D9DA 32 90 D9                     LD (@ControlsSmallMaskRows.Row00), A
  72++D9DD C9                           RET
