   3++CA8D                              ; Документация [алгоритм и проверка](../../Docs/ControlsBufferPoints.md)
   4++CA8D                              ; -----------------------------------------
   5++CA8D                              ; Получение байта из изменяемого 16-битового состояния генератора
   6++CA8D                              ; исходная запись 22, банк 1, смещения #0A8D..#0AB2
   7++CA8D                              ; In:
   8++CA8D                              ;   HL, DE, BC сохраняются, AF входных аргументов не задаёт, Seed читается из операнда CA8F
   9++CA8D                              ;   HL', DE', BC' используются как рабочие, AF', IX и IY входных аргументов не задают
  10++CA8D                              ;   банк 1 выбран, изменяемый операнд Seed доступен для записи, на CPU-стеке внешний возврат
  11++CA8D                              ; Out:
  12++CA8D                              ;   HL, DE, BC сохранены, A равен младшему байту нового Seed
  13++CA8D                              ;   t=(7*Seed-4) AND FFFF, u=(HIGH(t)-LOW(t)) AND FFFF, v=(t-u) AND FFFF, новый Seed=(v-1) AND FFFF
  14++CA8D                              ;   F соответствует 16-битовому SBC t-u до последующего DEC HL, а не проверке возвращаемого A
  15++CA8D                              ;   HL' равен новому Seed, DE'=u, BC'=LOW(t), AF', IX и IY сохраняются
  16++CA8D                              ;   I, IM и IFF сохраняются, портов и дополнительных PUSH нет, SP=входной SP+2
  17++CA8D                              ; Corrupt:
  18++CA8D                              ;   AF, HL', DE', BC', два байта Seed, R
  19++CA8D                              ; Note:
  20++CA8D                              ;   оба OR A сбрасывают Carry перед SBC, входные флаги на результат не влияют
  21++CA8D                              ;   для исходного Seed=0 до цикла выполняются 59 переходов, затем период равен 387, это не полный 16-битовый цикл
  22++CA8D                              ; -----------------------------------------
  23++CA8D                              ; сохранение основных пар через EXX перед вычислением нового состояния генератора
  24++CA8D D9           Entry:          EXX
  25++CA8E                              ; чтение существующего изменяемого 16-битового состояния Seed
  26++CA8E 01 00 00                     LD BC, #0000
  27++CA91 60                           LD H, B
  28++CA92 69                           LD L, C
  29++CA93 54                           LD D, H
  30++CA94 5D                           LD E, L
  31++CA95                              ; вычисление промежуточного 4*Seed-4 по модулю 65536
  32++CA95 2B                           DEC HL
  33++CA96 29                           ADD HL, HL
  34++CA97 29                           ADD HL, HL
  35++CA98 EB                           EX DE, HL
  36++CA99 60                           LD H, B
  37++CA9A 69                           LD L, C
  38++CA9B                              ; вычисление t=7*Seed-4 добавлением удвоенного и исходного Seed
  39++CA9B 29                           ADD HL, HL
  40++CA9C 19                           ADD HL, DE
  41++CA9D 09                           ADD HL, BC
  42++CA9E 54                           LD D, H
  43++CA9F 5D                           LD E, L
  44++CAA0                              ; вычисление разности старшего и младшего байтов промежуточного t
  45++CAA0 6C                           LD L, H
  46++CAA1 26 00                        LD H, #00
  47++CAA3 44                           LD B, H
  48++CAA4 4B                           LD C, E
  49++CAA5 B7                           OR A
  50++CAA6 ED 42                        SBC HL, BC
  51++CAA8 EB                           EX DE, HL
  52++CAA9 B7                           OR A
  53++CAAA                              ; вычитание полученной разности из t без входного заёма
  54++CAAA ED 52                        SBC HL, DE
  55++CAAC                              ; вычисление нового Seed уменьшением промежуточного v на один без изменения флагов SBC
  56++CAAC 2B                           DEC HL
  57++CAAD 22 8F CA                     LD (@ControlsBufferPointsState.Seed), HL
  58++CAB0 7D                           LD A, L
  59++CAB1 D9                           EXX
  60++CAB2 C9                           RET
  61++CAB3
