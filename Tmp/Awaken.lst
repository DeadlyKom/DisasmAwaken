  42++C4FD 06 1E                        LD B, #1E
  43++C4FF                              ; чтение текущего кодированного байта активности
  44++C4FF 1A           NextRow:        LD A, (DE)
  45++C500                              ; проверка старшего разряда перед декодированием инверсией
  46++C500 B7                           OR A
  47++C501 F2 05 C5                     JP P, @Text.CheckThresholdSet30.CheckActive                     ; переход, если bit7 активности снят, использовать исходный байт
  48++C504
  49++C504                              ; декодирование старшего байта инверсией, FF становится нулём
  50++C504 2F                           CPL
