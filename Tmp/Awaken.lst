   1++E7E0                              module D3D
   2++E7E0                              module SubtractPreviewClipTopLeft
   3++E7E0                              ; Документация [физический разрыв левого кэша, перенос низкой половины, точные регистры и ограниченный смысл Z](../../Docs/PreviewClipProducts.md)
   4++E7E0                              ; -----------------------------------------
   5++E7E0                              ; Разность кэшей Top и Left с заёмом младшего слова и возвратом старшего
   6++E7E0                              ; исходная запись 6, банк 4, файловые смещения #27E0..#27F3
   7++E7E0                              ; In:
   8++E7E0                              ;   HL не является входом, DE сохраняется, BC не является входом, AF - A сохраняется, входной Carry сбрасывается
   9++E7E0                              ;   кэши Top и Left содержат готовые 32-битные значения, низкая и высокая половины имеют исходные физические адреса
  10++E7E0                              ;   для Left младшее слово C2EE и старшее C2FA разнесены, промежуточные байты не входят в кэш
  11++E7E0                              ; Out:
  12++E7E0                              ;   HL содержит старшее слово (Top-Left) по модулю 2^32, младшая разность не возвращается
  13++E7E0                              ;   DE сохранён, BC содержит старшее слово второго кэша Left
  14++E7E0                              ;   AF - A сохранён, F от старшего SBC HL, BC с заёмом младшей половины
  15++E7E0                              ;   Z=1 означает нулевую старшую половину разности, младшая при этом может быть ненулевой
  16++E7E0                              ;   HL', DE', BC', AF', IX, IY, I, IFF и IM сохранены, SP после RET равен входному+2, память не записывается
  17++E7E0                              ; Corrupt:
  18++E7E0                              ;   HL, BC, AF - только F
  19++E7E0                              ; Note:
  20++E7E0                              ;   сброс Carry выполняется только перед младшей половиной, загрузки двух старших слов его не меняют
  21++E7E0                              ;   это не проверка равенства полных кэшей через Z, знак S принадлежит обёрнутой 32-битной разности
  22++E7E0                              ;   условия предварительной подготовки кэшей задают обработчики, полный разбор их путей ещё не завершён
  23++E7E0                              ; -----------------------------------------
  24++E7E0                              ; чтение младших слов кэшей Top и Left из фактических полей
  25++E7E0 2A DC C2     Entry:          LD HL, (@PreviewClipTopProduct.Value.LowWord)
  26++E7E3 ED 4B EE C2                  LD BC, (@PreviewClipLeftLow.Value.Word)
  27++E7E7                              ; сброс входного Carry перед младшей разностью с сохранением A
  28++E7E7 B7                           OR A
  29++E7E8                              ; расчёт младшей половины и её заёма, сам младший результат дальше теряется
  30++E7E8 ED 42                        SBC HL, BC
  31++E7EA                              ; чтение старших слов без изменения Carry младшей разности
  32++E7EA 2A DE C2                     LD HL, (@PreviewClipTopProduct.Value.HighWord)
  33++E7ED ED 4B FA C2                  LD BC, (@PreviewClipLeftHigh.Value.Word)
  34++E7F1                              ; расчёт старшей половины с унаследованным заёмом, Z относится только к этой половине
  35++E7F1 ED 42                        SBC HL, BC
  36++E7F3 C9                           RET
  37++E7F4
  38++E7F4                              endmodule
  39++E7F4                              endmodule
