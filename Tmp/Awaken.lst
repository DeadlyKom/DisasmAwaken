  26++43D2 11 00 80                     LD DE, #8000
  27++43D5 01 20 00                     LD BC, #0020
  28++43D8                              ; сохранение старшего и младшего байтов текущего адреса в соседние страницы таблиц
  29++43D8 72           BuildLine:      LD (HL), D
  30++43D9 24                           INC H
  31++43DA 73                           LD (HL), E
  32++43DB 25                           DEC H
