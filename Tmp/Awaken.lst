   1++CCD4                              module Station
   2++CCD4                              module ResetBandMode
   3++CCD4              ; Документация [Station](../../Docs/FunctionDetails/Station.md)
   4++CCD4              ; Подробный разбор [самомодификация режима полосовой рамки](../../Docs/StationSpans.md)
   5++CCD4              ; -----------------------------------------
   6++CCD4              ; Восстановление шести исходных операндов обычной полосовой рамки
   7++CCD4              ; исходная запись 4, файловые смещения #6CD4..#6CF2
   8++CCD4              ; In:
   9++CCD4              ;   шесть слов StationRaster для обычной полосовой рамки доступны для записи
  10++CCD4              ; Out:
  11++CCD4              ;   HL и BC сохранены, DE=#C1ED, AF сохранён побитно
  12++CCD4              ;   шесть операндов восстановлены, StationRaster.FillMode и BandPattern не меняются
  13++CCD4              ; Corrupt:
  14++CCD4              ;   DE
  15++CCD4              ; Note:
  16++CCD4              ;   альтернативные и индексные регистры, I и IFF сохраняются, SP восстанавливается
  17++CCD4              ;   восстанавливается фиксированный обычный набор, прежние значения не читаются
  18++CCD4              ;   режим нужен последующим рисователям, текущие пиксели не меняются
  19++CCD4              ; -----------------------------------------
  20++CCD4                              ; восстановление обычных боковых узоров в шести исходных операндах
  21++CCD4 11 C0 C1     Entry:          LD DE, @Station.SetOutlinePattern.Entry
  22++CCD7 ED 53 FF C0                  LD (@StationRaster.BandSides), DE
  23++CCDB ED 53 44 C1                  LD (@StationRaster.BandBottom1), DE
  24++CCDF ED 53 95 C0                  LD (@StationRaster.BandDefault), DE
  25++CCE3 ED 53 F2 C0                  LD (@StationRaster.BandLine11), DE
  26++CCE7                              ; восстановление нулевых разделителей строки 12 и начала нижнего знакоместа
  27++CCE7 11 ED C1                     LD DE, @Station.ClearSpanPattern.Entry
  28++CCEA ED 53 3E C1                  LD (@StationRaster.BandBottom0), DE
  29++CCEE ED 53 F8 C0                  LD (@StationRaster.BandLine12), DE
  30++CCF2 C9                           RET
  31++CCF3
  32++CCF3                              endmodule
  33++CCF3                              endmodule
