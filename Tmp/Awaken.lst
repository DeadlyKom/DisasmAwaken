   2++AC14                              module GenerateMissionOffer
   3++AC14              ; Документация [Station](../../Docs/FunctionDetails/Station.md)
   4++AC14              ; Подробный разбор [пересев RNG, чтение ROM и два произведения награды](../../Docs/MissionOffer.md)
   5++AC14              ; -----------------------------------------
   6++AC14              ; Генерация координат предложения, требуемого тоннажа и награды по расстоянию
   7++AC14              ; исходная запись 4, файловые смещения #4C14..#4C73
   8++AC14              ; In:
   9++AC14              ;   SignatureInput.Entry содержит текущие FirstWord и SecondWord, младший байт RandomStates.Seed1 доступен
  10++AC14              ;   банковая тень и аппаратная страница согласованы, выбраны банк 0 и ROM 1, bit5 порта снят
  11++AC14              ;   ROM[0..FF] читаема как данные и не меняется, выбранные страницы KARTA и Station доступны
  12++AC14              ;   для возврата требуется, чтобы последовательность RNG встретила ROM-байт не меньше 8
  13++AC14              ;   код и данные допускают запись полей предложения и трёх байтов Seed1, CPU-стек вне банкового окна
  14++AC14              ; Out:
  15++AC14              ;   HL старшее слово полного произведения distance*20*RequiredTonnage, DE младшее слово этого произведения
  16++AC14              ;   BC содержит выход MeasureCoordinateDistance при distance*20<256, иначе B сохранён от этого выхода, C=0
  17++AC14              ;   AF - A=(входная CurrentPage AND F8) OR 10, F от последнего OR банкового интерфейса
  18++AC14              ;   MissionOffer.Entry.FirstWord=current.FirstWord, SecondWord=слово последнего принятого NextRandom1
  19++AC14              ;   RequiredTonnage=ROM[lowT]>>3, значение 1..31, Reward=(distance*20*RequiredTonnage) AND FFFF
  20++AC14              ;   MessageIndex=0, четыре UnknownWord04..UnknownWord0A между ключом и наградой не меняются
  21++AC14              ;   HL'=адрес RandomStates.Seed1, DE'=current.FirstWord, BC'=current.SecondWord
  22++AC14              ;   AF' соответствует MeasureCoordinateDistance, при нулевом расстоянии либо раннем переполнении сохранён
  23++AC14              ;   IX, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  24++AC14              ;   аппаратная страница и тень выбирают сначала KARTA 1, затем Station 0 с сохранением старших битов и ROM 1
  25++AC14              ;   Seed1 содержит последнее новое слово и HighByte, MapState.LastDistance результат вызванного измерителя
  26++AC14              ; Corrupt:
  27++AC14              ;   HL, DE, BC, AF, HL', DE', BC', AF' по арифметическому пути
  28++AC14              ; Note:
  29++AC14              ;   перед каждой попыткой current.SecondWord записывается в Seed1.LowWord+1 и Seed1.HighByte, младший байт Seed1 сохраняется
  30++AC14              ;   после NextRandom1 альтернативный B равен нулю, C равен lowT, поэтому EXX и LD A,(BC) читают именно ROM[lowT]
  31++AC14              ;   нулевой результат после трёх SRL отвергается, повтор выполняется без ограничения числа попыток
  32++AC14              ;   оба ключа расстояния имеют одинаковый FirstWord, отличаются только словом текущего и случайного SecondWord
  33++AC14              ;   код FF от MeasureCoordinateDistance не отвергается и участвует в награде как число 255
  34++AC14              ;   старшее слово второго произведения не проверяется, максимальное 255*20*31 равно 158100 и может обернуть Reward
  35++AC14              ;   четыре промежуточных слова и смысл MessageIndex остаются неустановленными, физическая структура этого не скрывает
  36++AC14              ;   ROM из исследовательской модели не объявляется ROM эмулятора Unreal, нативный запуск генератора не подтверждён
  37++AC14              ; -----------------------------------------
  38++AC14                              ; чтение текущего первого слова ключа, оно остаётся общим для текущего и предлагаемого пункта
  39++AC14 2A 3F 98     Entry:          LD HL, (@SignatureInput.Entry.FirstWord)
  40++AC17                              ; сохранение первого слова в физическом состоянии предложения
  41++AC17 22 B0 98                     LD (@MissionOffer.Entry.FirstWord), HL
  42++AC1A                              ; чтение текущего второго слова для частичного пересева независимого потока 1
  43++AC1A ED 5B 41 98                  LD DE, (@SignatureInput.Entry.SecondWord)
  44++AC1E                              ; перезапись старших двух байтов Seed1, младший байт прежнего состояния не меняется
  45++AC1E ED 53 B0 A8                  LD (@RandomStates.Seed1.LowWord + 1), DE
  46++AC22                              ; расчёт следующего слова RNG с рабочими альтернативными HL, DE и BC
  47++AC22 CD 7B A8                     CALL @Station.NextRandom1.Entry
  48++AC25                              ; сохранение нового второго слова предлагаемого пункта до проверки тоннажа
  49++AC25 22 B2 98                     LD (@MissionOffer.Entry.SecondWord), HL
  50++AC28                              ; обнуление MessageIndex перед проверкой каждого нового кандидата
  51++AC28 AF                           XOR A
  52++AC29 32 BF 98                     LD (@MissionOffer.Entry.MessageIndex), A
  53++AC2C                              ; выбор рабочего BC генератора, B=0 и C=lowT дают адрес первого ROM-страничного блока
  54++AC2C D9                           EXX
  55++AC2D                              ; чтение ROM[lowT] как исходного байта для требуемого тоннажа
  56++AC2D 0A                           LD A, (BC)
  57++AC2E                              ; расчёт пятибитного тоннажа тремя логическими сдвигами ROM-байта
  58++AC2E CB 3F                        SRL A
  59++AC30 CB 3F                        SRL A
  60++AC32 CB 3F                        SRL A
  61++AC34                              ; проверка ненулевого тоннажа перед принятием кандидата
  62++AC34 FE 00                        CP #00
  63++AC36 CA 71 AC                     JP Z, @Station.GenerateMissionOffer.Retry                       ; переход, если ROM-байт дал нулевой тоннаж, повторить генерацию с новым младшим байтом Seed1
  64++AC39
  65++AC39                              ; сохранение принятого тоннажа 1..31 в физическом состоянии предложения
  66++AC39 32 BE 98                     LD (@MissionOffer.Entry.RequiredTonnage), A
  67++AC3C                              ; выбор KARTA в банке 1 для арифметики расстояния
  68++AC3C 3E 11                        LD A, #11
  69++AC3E CD 96 63                     CALL @Station.SelectRamBank.Entry
  70++AC41                              ; подготовка текущего ключа и перенос его в альтернативные DE и BC
  71++AC41 ED 5B 3F 98                  LD DE, (@SignatureInput.Entry.FirstWord)
  72++AC45 ED 4B 41 98                  LD BC, (@SignatureInput.Entry.SecondWord)
  73++AC49 D9                           EXX
  74++AC4A                              ; подготовка предлагаемого ключа в основных DE и BC по договору MeasureCoordinateDistance
  75++AC4A ED 5B B0 98                  LD DE, (@MissionOffer.Entry.FirstWord)
  76++AC4E ED 4B B2 98                  LD BC, (@MissionOffer.Entry.SecondWord)
  77++AC52                              ; расчёт масштабированного расстояния, FF переполнения здесь остаётся числовым множителем
  78++AC52 CD BA E7                     CALL @Map.MeasureCoordinateDistance.Entry
  79++AC55                              ; расширение байтового расстояния в положительное слово для первого умножения
  80++AC55 26 00                        LD H, #00
  81++AC57 6F                           LD L, A
  82++AC58                              ; выбор исходного коэффициента награды 20 за единицу расстояния и тоннажа
  83++AC58 11 14 00                     LD DE, @MissionOfferConst.RewardScale
  84++AC5B                              ; расчёт первого произведения distance*20 в младшем выходном слове DE
  85++AC5B CD 63 DB                     CALL @Map.MultiplySigned16.Entry
  86++AC5E                              ; расширение принятого тоннажа в положительный множитель HL
  87++AC5E 26 00                        LD H, #00
  88++AC60 3A BE 98                     LD A, (@MissionOffer.Entry.RequiredTonnage)
  89++AC63 6F                           LD L, A
  90++AC64                              ; расчёт полного произведения первого результата на требуемый тоннаж
  91++AC64 CD 63 DB                     CALL @Map.MultiplySigned16.Entry
  92++AC67                              ; сохранение только младшего слова награды, старшее HL не проверяется
  93++AC67 ED 53 BC 98                  LD (@MissionOffer.Entry.Reward), DE
  94++AC6B                              ; возврат станционного банка 0, основной AF заменяется статусом выбора страницы
  95++AC6B 3E 10                        LD A, #10
  96++AC6D CD 96 63                     CALL @Station.SelectRamBank.Entry
  97++AC70 C9                           RET
  98++AC71
  99++AC71                              ; повтор с новым младшим байтом Seed1, число попыток исходником не ограничивается
