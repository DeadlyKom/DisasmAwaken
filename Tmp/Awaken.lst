# file opened: Source/Controls/DivideByteFraction.asm
   1++D165                              module Controls
   2++D165                              module DivideByteFraction
   3++D165                              ; Документация [алгоритм и проверка](../../Docs/ControlsDivision.md)
   4++D165                              ; -----------------------------------------
   5++D165                              ; Подготовка делимого A*256 и последовательное исполнение делителя
   6++D165                              ; исходная запись 22, банк 1, смещения #1165..#1166
   7++D165                              ; In:
   8++D165                              ;   HL сохраняется, DE входных аргументов не задаёт, E обнуляется
   9++D165                              ;   BC задаёт B делитель, C сохраняется, AF задаёт A числитель перед масштабированием на 256
  10++D165                              ;   входные флаги не влияют на арифметический результат, на CPU-стеке внешний возврат
  11++D165                              ; Out:
  12++D165                              ;   HL сохранён, D содержит восьмибитовое частное, E=0, BC сохранён, A содержит байтовый остаток
  13++D165                              ;   при B!=0 и входном A<B результат совпадает с divmod(входной A*256,B)
  14++D165                              ;   при B=0 результат D=FF и A=00, делитель не вызывает ловушку или бесконечный цикл
  15++D165                              ;   при B!=0 и входном A>=B выполняется исходная восьмишаговая рекурсия с ограничением остатка до байта, точное целочисленное деление не обещается
  16++D165                              ;   F описывает финальный D, S,Z и биты 5,3 берутся из D, PV равен чётности D, H,N,C сброшены
  17++D165                              ;   HL', DE', BC', AF', IX и IY, I, IM и IFF сохраняются, SP=входной SP+2
  18++D165                              ; Corrupt:
  19++D165                              ;   DE, AF, R
  20++D165                              ; Note:
  21++D165                              ;   RAM не записывается, портов и дополнительных PUSH нет, исходный D заменяется маркером FE
  22++D165                              ;   D=11111110 совмещает семь оставшихся единиц маркера и накапливаемые биты частного, восьмой сдвиг выводит начальный нуль в Carry
  23++D165                              ;   все выходы RET NC проверяют конец восьми шагов по маркеру, а не корректность делителя
  24++D165                              ;   доказательство условий B!=0 и входного A<B в вызывающих геометрических процедурах остаётся отдельной задачей
  25++D165                              ;   после подготовки E=0 исполнение продолжается физически в DivideWordByByte
  26++D165                              ; -----------------------------------------
  27++D165                              ; масштабирование байтового числителя на 256 через нулевой младший байт делимого
  28++D165 1E 00        Entry:          LD E, #00
  29++D167                              ; JP @Controls.DivideWordByByte.Entry, продолжение в DivideWordByByte.asm
  30++D167
  31++D167                              endmodule
  32++D167                              endmodule
