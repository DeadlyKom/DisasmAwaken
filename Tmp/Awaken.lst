   1++DAB9                              module Controls
   2++DAB9                              module CompareComponents
   3++DAB9                              ; Документация [алгоритм и проверка](../../Docs/ControlsComponentCompare.md)
   4++DAB9                              ; -----------------------------------------
   5++DAB9                              ; Сравнение двух компонентов после перехода IY к следующей трёхбайтовой записи
   6++DAB9                              ; исходная запись 22, банк 1, смещения #1AB9..#1ADD
   7++DAB9                              ; In:
   8++DAB9                              ;   HL сохраняется, DE входных аргументов не задаёт, BC сохраняется, AF входных аргументов не задаёт
   9++DAB9                              ;   IX указывает опорный FComponent24, IY указывает предыдущую запись сравниваемой последовательности
  10++DAB9                              ;   банк 1 выбран, после IY+3 доступны поля Middle и High текущего FComponent24, индексы оборачиваются по слову
  11++DAB9                              ;   на CPU-стеке внешний возврат, дополнительный стек не требуется, IRQ не вмешиваются
  12++DAB9                              ; Out:
  13++DAB9                              ;   HL сохраняется, DE содержит D=High текущей записи AND HighMask и E=3, BC сохраняется
  14++DAB9                              ;   NZ возвращается при опорном High AND HighMask меньше DirectLimit либо при опорном 15-битовом ключе не меньше текущего
  15++DAB9                              ;   Z возвращается только при опорном High не меньше DirectLimit и меньшем опорном ключе, A=0 и F=44
  16++DAB9                              ;   при прямом допуске A=опорный High OR 01, F от OR, при большем High A=опорный High и F от CP D
  17++DAB9                              ;   при равных High и не меньшем опорном Middle A=опорный Middle OR 01, F от OR
  18++DAB9                              ;   HL', DE', BC', AF', IX, I, IM и IFF сохраняются, IY увеличивается на три, SP=входной SP+2
  19++DAB9                              ;   R получает 14 M1 при прямом допуске, 15 при большем опорном High, 16 при меньшем, 22 при сравнении Middle
  20++DAB9                              ; Corrupt:
  21++DAB9                              ;   DE, AF, IY, R
  22++DAB9                              ; Note:
  23++DAB9                              ;   ключ равен 256*(High AND HighMask)+Middle, Low и бит 7 High не участвуют в сравнении
  24++DAB9                              ;   бит 7 High здесь только исключён маской, его общий игровой смысл этим помощником не доказывается
  25++DAB9                              ;   IY увеличивается до проверки, а не только при принятом компоненте, записи RAM отсутствуют
  26++DAB9                              ;   векторный вызывающий D95F проверяет до трёх компонентов через CALL NZ, его общий алгоритм ещё не завершён
  27++DAB9                              ;   причина игрового выбора DirectLimit=0A остаётся вне локального договора
  28++DAB9                              ; -----------------------------------------
  29++DAB9                              ; поиск следующей трёхбайтовой записи, исходный IY указывает предыдущую запись последовательности
  30++DAB9 11 03 00     Entry:          LD DE, @FComponent24
  31++DABC FD 19                        ADD IY, DE
  32++DABE                              ; чтение старшей части текущего компонента без исключённого разряда 7
  33++DABE FD 7E 02                     LD A, (IY+#02)
  34++DAC1 E6 7F                        AND @ComponentCompareConst.HighMask
  35++DAC3 57                           LD D, A
  36++DAC4                              ; чтение старшей части опорного компонента с той же числовой маской
  37++DAC4 DD 7E 02                     LD A, (IX+#02)
  38++DAC7 E6 7F                        AND @ComponentCompareConst.HighMask
  39++DAC9                              ; проверка прямого допуска по малой старшей части опорного компонента
  40++DAC9 FE 0A                        CP @ComponentCompareConst.DirectLimit
  41++DACB 38 0C                        JR C, @Controls.CompareComponents.AcceptComponent               ; переход, если опорная старшая часть меньше DirectLimit, принять компонент через AcceptComponent
  42++DACD
  43++DACD                              ; проверка порядка старших частей двух усечённых ключей
  44++DACD BA                           CP D
  45++DACE 38 0C                        JR C, @Controls.CompareComponents.RejectComponent               ; переход, если опорная старшая часть меньше текущей, отклонить компонент через RejectComponent
  46++DAD0
  47++DAD0 C0                           RET NZ                                                          ; выход, если опорная старшая часть больше текущей, вернуть NZ и F от CP D
  48++DAD1
  49++DAD1                              ; проверка средних байтов только при равных старших частях, младшие байты не читаются
  50++DAD1 DD 7E 01                     LD A, (IX+#01)
  51++DAD4 FD BE 01                     CP (IY+#01)
  52++DAD7 38 03                        JR C, @Controls.CompareComponents.RejectComponent               ; переход, если опорный Middle меньше текущего Middle, отклонить компонент через RejectComponent
  53++DAD9
  54++DAD9                              ; формирование NZ с нечётным ненулевым A без унификации исходных путей возвращаемых F
  55++DAD9 F6 01        AcceptComponent:OR #01
  56++DADB C9                           RET
