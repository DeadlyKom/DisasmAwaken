# file opened: Source/Map/XorMapPointMarker.asm
   1++C231                              module Map
   2++C231                              module XorMapPointMarker
   3++C231              ; Документация [Map](../../Docs/FunctionDetails/Map.md)
   4++C231              ; Подробный разбор [упаковка точки, строгие границы и семь двухбайтовых строк](../../Docs/MapPointMarker.md)
   5++C231              ; -----------------------------------------
   6++C231              ; Отсечение и XOR семистрочного фазового маркера точки карты
   7++C231              ; исходная запись 7, файловые смещения #0231..#0324
   8++C231              ; In:
   9++C231              ;   HL - начало ресурса с восемью фазами по 16 байтов, первые 14 байтов каждой фазы доступны для чтения
  10++C231              ;   DE - первое слово точки, BC - второе, координаты X=256*E+C и Y=256*D+B до перестановки
  11++C231              ;   MapViewState содержит согласованные начала и размеры, для обычной области Width>=8, Height>=7 без оборачивания вычитаний
  12++C231              ;   MapScreenTables.RowHigh, RowLow и ColumnByte построены для этой области, KARTA выбран
  13++C231              ;   допущенный прямоугольник семи строк и двух байтов полностью лежит в доступном bitmap, стек и ресурс вне него
  14++C231              ; Out:
  15++C231              ;   вычисляет DX=(X-OriginX-3) modulo 65536 и DY=(Y-OriginY-3) modulo 65536
  16++C231              ;   при ненулевом старшем байте DX или DY, DXlow>=(Width-8) modulo 256 либо DYlow>=(Height-7) modulo 256 возвращает без записи
  17++C231              ;   на отказе HL=DY, DE=DX, BC исходный адрес ресурса, AF от проверки старших байтов либо последнего CP границы
  18++C231              ;   при допуске выбирает фазу DX AND 7 со смещением 16*(DX AND 7) от ресурса
  19++C231              ;   семь строк по два байта объединяются с bitmap операцией XOR, атрибуты не меняются
  20++C231              ;   при допуске HL=ресурс+смещение фазы+13, DE адрес второго байта седьмой строки, BC исходный ресурс
  21++C231              ;   AF при допуске содержит итоговый второй байт седьмой строки и логические флаги этого XOR
  22++C231              ;   все альтернативные и индексные регистры, I и IFF сохранены, SP обычного возврата равен входному SP+2
  23++C231              ; Corrupt:
  24++C231              ;   HL, DE, BC, AF
  25++C231              ; Note:
  26++C231              ;   равенство каждой границе отсекается отдельным RET Z, нельзя заменить сравнения нестрогими
  27++C231              ;   вычитания Width-8 и Height-7 байтовые, для нештатных малых размеров сохраняется их оборачивание
  28++C231              ;   адрес первой строки складывается из RowHigh[DY], RowLow[DY] и ColumnByte[DX], перенос младшего сложения в D не добавляется
  29++C231              ;   семь строк развёрнуты без счётчика, между ними применяется исходная схема экранного адреса Spectrum
  30++C231              ;   два последних байта каждой 16-байтовой фазы этим входом не читаются, их общее назначение не объявляется отсутствующим
  31++C231              ;   FMapPointMarkerFrame описывает максимальную глубину трёх сохранённых слов до отсечения, все они сняты перед любым RET
  32++C231              ; -----------------------------------------
  33++C231                              ; перестановка старших координатных байтов для получения полной координаты X в BC и Y в DE
  34++C231 78           Entry:          LD A, B
  35++C232 43                           LD B, E
  36++C233 5F                           LD E, A
