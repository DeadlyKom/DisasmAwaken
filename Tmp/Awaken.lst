  14++C49B              ;   страницы RowHigh и RowLow содержат 256 старших и младших байтов последовательных экранных строк без горизонтальной колонки
  15++C49B              ;   ColumnByte[i]=(исходная колонка+floor(i/8)) modulo 256, PixelMask[i]=80 SHR (i AND 7)
  16++C49B              ;   HL=F000, DE адрес строки после всех 256 переходов, B=0, C сохранён
  17++C49B              ;   A=исходная колонка+32, F=42, исходная колонка находится в диапазоне 0..31
  18++C49B              ;   AF'=80A3, HL', DE', BC', IX, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  19++C49B              ;   записаны ровно четыре страницы, пиксели экрана и соседние байты EDFF и F200 не меняются
  20++C49B              ; Corrupt:
  21++C49B              ;   HL, DE, BC только B, AF, AF'
  22++C49B              ; Note:
  23++C49B              ;   сначала вычисляется экранный адрес через страницы 82,83,84, горизонтальная колонка отделяется маской 1F
  24++C49B              ;   маска E0 оставляет только строковую часть младшего адресного байта для RowLow
  25++C49B              ;   адрес строки изменяется исходной схемой INC D, затем при D AND 7=0 добавление 20 к E и условное вычитание 8 из D
  26++C49B              ;   построение 256 строк не означает допустимость рисования всех 256 строк, видимая высота проверяется потребителями
  27++C49B              ;   EX AF,AF альтернативного набора хранит отдельно номер колонки и вращаемую маску 80
  28++C49B              ;   прибавления отступов байтовые с оборачиванием, нештатные входы в модели сохраняют фактические байты исходных lookup-страниц
  29++C49B              ; -----------------------------------------
