   4++DF7F              ; -----------------------------------------
   5++DF7F              ; Обновление счётчика нот канала A, перехода позиции и трёх указателей паттернов
   6++DF7F              ; исходная запись 10, файловые смещения #047F..#04E2
   7++DF7F              ; In:
   8++DF7F              ;   Unknown, регистровый контракт ещё не доказан
   9++DF7F              ; Out:
  10++DF7F              ;   исходный поток управления, включая переходы в соседние фрагменты
  11++DF7F              ; Corrupt:
  12++DF7F              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY, консервативная верхняя граница
  13++DF7F              ; Note:
  14++DF7F              ;   граница файла не доказывает границу логической процедуры
  15++DF7F              ;   состояние самомодификации и активной страницы учитывается отдельно
  16++DF7F              ;   счётчик текущей ноты находится по #DE1E, нулевой байт потока A требует следующей позиции
  17++DF7F              ;   список позиций заканчивается #FF, после него выбирается указатель петли из операнда #DF9F
  18++DF7F              ;   значение позиции задаёт индекс тройки указателей A, B, C, относительные адреса складываются с началом модуля
  19++DF7F              ;   указатель A сохраняется в #DF89, B и C в #E393 и #E3C4, общий размер тройки шесть байтов
  20++DF7F              ; -----------------------------------------
