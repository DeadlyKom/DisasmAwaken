   1++DDCA                              module Music
   2++DDCA                              module ReadGateTimingA
   3++DDCA              ; Документация [Music](../../Docs/FunctionDetails/Music.md)
   4++DDCA              ; -----------------------------------------
   5++DDCA              ; Чтение двух длительностей переключения канала A из потока паттерна
   6++DDCA              ; исходная запись 10, файловые смещения #02CA..#02CD
   7++DDCA              ; In:
   8++DDCA              ;   DE - адрес двух последовательных байтов длительностей канала A
   9++DDCA              ; Out:
  10++DDCA              ;   DE увеличен на два, A равен #06, длительности записаны в операнды #DE97 и #DE9F
  11++DDCA              ; Corrupt:
  12++DDCA              ;   DE, AF
  13++DDCA              ; Note:
  14++DDCA              ;   флаги сохраняются, #DE90 получает #06 и при следующем исполнении означает LD B,n вместо JR
  15++DDCA              ;   длительности далее копируются в счётчик и перезагрузочные значения по #E0D7, #E0E9 и #E0E5
  16++DDCA              ; -----------------------------------------
  17++DDCA                              ; чтение первой длительности канала A и переход к общей установке двух байтов
  18++DDCA 1A           Entry:          LD A, (DE)
  19++DDCB 13                           INC DE
  20++DDCC 18 04                        JR @Music.SetGateTimingA.Entry
  21++DDCE
  22++DDCE
  23++DDCE                              endmodule
  24++DDCE                              endmodule
