  10++C566              ;   длина не пересекает правый край строки, BC сохраняется, код развёртки доступен для записи
  11++C566              ; Out:
  12++C566              ;   HL, DE и BC сохранены, A - последний инвертированный экранный байт
  13++C566              ;   F=#12 OR (A AND #28), при длине больше одного S равен биту 7 младшего адреса последнего байта
  14++C566              ;   HorizontalSkip=4*(32-E), только E байтов строки инвертированы
  15++C566              ; Corrupt:
  16++C566              ;   AF
