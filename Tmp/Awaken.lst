   4++D532                              ; -----------------------------------------
   5++D532                              ; Табличная аппроксимация произведения байтов A и C через разность свёрнутых квадратов
   6++D532                              ; исходная запись 6, банк 4, файловые смещения #1532..#153E
   7++D532                              ; In:
   8++D532                              ;   HL - H=C3, страница исходной FoldedSquare127, младший L произвольный
   9++D532                              ;   DE - E рабочий выход таблицы, D сохраняемый контекст
  10++D532                              ;   BC - входной множитель находится в C, оба регистра сохраняются
  11++D532                              ;   AF - A первый знаковый байтовый множитель, входной F не является параметром
  12++D532                              ; Out:
  13++D532                              ;   HL - H=C3, L индекс суммы половин по точной формуле алгоритма
  14++D532                              ;   DE - D сохранён, E содержит значение таблицы по индексу разности половин, BC сохранён
  15++D532                              ;   AF - A разность двух табличных значений по модулю 256, F от последнего SUB, P/V=0 для исходной страницы C3
  16++D532                              ;   HL', DE', BC', AF', IX, IY, I, IFF и IM сохраняются, SP обычного возврата равен входному SP+2
  17++D532                              ;   память и порты не записываются, входной множитель C сохранён
  18++D532                              ; Corrupt:
  19++D532                              ;   HL, DE, AF
  20++D532                              ; Note:
  21++D532                              ;   обе арифметические половины округляются вниз, включая отрицательные нечётные значения
  22++D532                              ;   индекс разности равен SRA(A)-SRA(C) по модулю 256, индекс суммы получается добавлением полного исходного C
  23++D532                              ;   точная таблица T(i)=floor(min(i,255-i)^2/127), отрицательные индексы сворачиваются дополнением, а не модулем знакового числа
  24++D532                              ;   это аппроксимация произведения через разность квадратов, она не равна точному умножению с делением на 128
  25++D532                              ;   входной 80 обрабатывается исходными сдвигами и таблицей без отдельного исправления
  26++D532                              ;   договор доказан для исходной страницы C3, произвольная другая страница в H не подтверждается
  27++D532                              ; -----------------------------------------
  28++D532                              ; расчёт арифметической половины первого множителя с округлением вниз
  29++D532 CB 2F        Entry:          SRA A
  30++D534                              ; чтение второго множителя C перед вычислением его половины
  31++D534 69                           LD L, C
  32++D535                              ; расчёт арифметической половины второго множителя, отрицательные нечётные округляются вниз
  33++D535 CB 2D                        SRA L
  34++D537                              ; расчёт байтового индекса разности половин с исходным оборачиванием
  35++D537 95                           SUB L
  36++D538 6F                           LD L, A
  37++D539                              ; расчёт индекса суммы добавлением полного исходного второго множителя
  38++D539 81                           ADD A, C
  39++D53A                              ; поиск первого значения свёрнутого квадрата по индексу разности
  40++D53A 5E                           LD E, (HL)
  41++D53B 6F                           LD L, A
  42++D53C                              ; поиск второго значения по индексу суммы
  43++D53C 7E                           LD A, (HL)
  44++D53D                              ; расчёт разности квадратов, возвращаемой как байтовое приближение произведения
  45++D53D 93                           SUB E
  46++D53E C9                           RET
  47++D53F
  48++D53F                              endmodule
  49++D53F                              endmodule
