# file opened: Source/Station/ProcessMissionAction.asm
   1++6E9C                              module Station
   2++6E9C                              module ProcessMissionAction
   3++6E9C              ; Документация [Station](../../Docs/FunctionDetails/Station.md)
   4++6E9C              ; Подробный разбор [условия принятия, старшие байты отмены и общий стековый хвост](../../Docs/MissionAction.md)
   5++6E9C              ; -----------------------------------------
   6++6E9C              ; Проверка селектора и строки, принятие либо расторжение миссии с общей перерисовкой
   7++6E9C              ; исходная запись 4, файловые смещения #1148..#11ED
   8++6E9C              ; In:
   9++6E9C              ;   HL - запасная обёртка, DE - выбранный индекс, BC - контекст по RepaintAndFlag
  10++6E9C              ;   AF - A исходный селектор, действуют договоры RepaintAndFlag, callback и интерактивной геометрии
  11++6E9C              ;   для собственного действия выполнены договоры DrawItem31, DrawItem32, DrawItem00 и экранного обновления
  12++6E9C              ;   Row хранится в исходном операнде 6F54, текущий ключ и MissionOffer доступны
  13++6E9C              ;   для предупреждения и отмены GenerateMissionOffer завершает поиск ненулевого ROM-тоннажа, LANG доступен в банке 6
  14++6E9C              ;   стек вне экранов и банкового окна, HALT пробуждается с сохранением контекста
  15++6E9C              ; Out:
  16++6E9C              ;   при Carry после RepaintAndFlag немедленный возврат с его регистровыми результатами
  17++6E9C              ;   при возвращённом A не равном 1 только DEC A и CloseMenuOnRow, результат по его договору
  18++6E9C              ;   при возвращённом A=1 сохраняет шесть пар в FMissionActionFrame, дальнейшее восстановление относится к этому моменту
  19++6E9C              ;   при Row не равном 1 или совпавших ключах пропускает собственное принятие и отмену, но выполняет общий хвост
  20++6E9C              ;   при Row=1 и разных ключах ActiveCode=1 ведёт в CancelMission на этом же кадре
  21++6E9C              ;   при прочих кодах ActiveCode сравнивает вместимость с младшим байтом суммы используемого и требуемого тоннажа
  22++6E9C              ;   успех пишет ActiveCode=1, CompletionCode=0, байтовые суммы в 9852 и 9850, значение 0A в 9853
  23++6E9C              ;   отказ печатает предупреждение, ждёт два HALT, заменяет предложение генератором и выполняет общий хвост
  24++6E9C              ;   общий хвост вызывает BeginScreenUpdate, DrawItem31, DrawItem32, DrawItem00 и EndScreenUpdate
  25++6E9C              ;   HL, DE, B, IX и IY восстановлены из FMissionActionFrame перед CloseMenuOnRow
  26++6E9C              ;   C равен PointerY SHR 3, A=FF, F от CloseMenuOnRow, MissionHoverState.Row=FF
  27++6E9C              ;   при совпадении строк CloseMenuOnRow удаляет выбранный элемент через DropItemDraw, иначе список не меняется этим вызовом
  28++6E9C              ;   HL', DE', BC', AF' не восстанавливаются общим кадром и соответствуют вложенным игровым и графическим вызовам
  29++6E9C              ;   конечная страница 10, блокировка указателя снята EndScreenUpdate, I и IFF собственным кодом не меняются
  30++6E9C              ;   SP обычного возврата равен входному SP+2 при выполнении договоров вызываемых обработчиков
  31++6E9C              ; Corrupt:
  32++6E9C              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY по RepaintAndFlag, собственный кадр сохраняет шесть пар
  33++6E9C              ; Note:
  34++6E9C              ;   собственный FinishAction требует кадр от SaveContext, обычный CALL к этому хвосту недопустим
  35++6E9C              ;   на ветви принятия сравнивается обёрнутая байтовая сумма, перенос выше 255 не вызывает отдельного отказа
