  50++CA14
  51++CA14                              ; замена адреса ниже списка его исходной нижней границей
  52++CA14 EB                           EX DE, HL
  53++CA15 18 01                        JR @Map.RefreshSecondaryPointOrder.StoreCursor
  54++CA17
  55++CA17                              ; восстановление найденного адреса из неотрицательной разности
  56++CA17 19           RestoreCursor:  ADD HL, DE
  57++CA18                              ; сохранение ограниченного указателя до пересчёта количества
  58++CA18 22 09 63     StoreCursor:    LD (@SecondaryPointState.Cursor), HL
  59++CA1B                              ; поиск количества записей второго списка с шагом 5 и начальным B=0
