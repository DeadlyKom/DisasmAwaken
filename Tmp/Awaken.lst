  61++F171 0F                           RRCA
  62++F172 0F                           RRCA
  63++F173 0E 28                        LD C, #28
  64++F175 CD 88 F1                     CALL @Controls.DrawCounterNibble.Entry
  65++F178                              ; проверка переноса из третьей пары перед обновлением D
  66++F178 CB 50                        BIT 2, B
