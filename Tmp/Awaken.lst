   4++AE2A              ; Подробный разбор [вывод слова и статусы переноса](../../Docs/WordOutput.md)
   5++AE2A              ; -----------------------------------------
   6++AE2A              ; Печать до границы слова с отдельным статусом успешного переноса по ширине
   7++AE2A              ; исходная запись 4, файловые смещения #4E2A..#4E54
   8++AE2A              ; In:
   9++AE2A              ;   HL - начало текста, достигающего пробела, CR, LF либо отказа вывода
  10++AE2A              ;   TextWindow и исходные инструкции DrawGlyph подготовлены
  11++AE2A              ; Out:
  12++AE2A              ;   HL - после потреблённого ограничителя либо символа, при отказе ширины остаётся на этом символе
  13++AE2A              ;   DE - D сохранён, E=1 только при CR, иначе исходный E сохранён
  14++AE2A              ;   BC - сохранён, кроме отказа ширины, тогда B=Height, C=(прежний CursorY+8) по модулю 256
  15++AE2A              ;   AF - пробел даёт #2120, CR даёт #0100, вертикальный отказ даёт #0044
  16++AE2A              ;   LF даёт #0A4A, принятый переход строки даёт #0100, отказ перехода даёт #0043
  17++AE2A              ; Corrupt:
  18++AE2A              ;   HL, DE, BC, AF
  19++AE2A              ; Note:
  20++AE2A              ;   альтернативные и индексные регистры, I и IFF сохраняются, SP восстанавливается
  21++AE2A              ;   пробел, CR и LF потребляются, CR здесь не продвигает Y, а устанавливает E=1 для вызывающего кода
  22++AE2A              ;   отказ физического X с кодом 0 пропускает символ и продолжает печать, другие вертикальные отказы останавливают её
  23++AE2A              ;   нулевой код и остальные управляющие байты не обрабатываются отдельно, они проходят в DrawGlyph
  24++AE2A              ;   при отказе ширины вызывается AdvanceTextRow, принятый переход сбрасывает X и сдвигает Y, сам символ не повторяется внутри процедуры
  25++AE2A              ;   переход Y имеет байтовое переполнение, подробности в WordOutput.md
  26++AE2A              ;   разный статус переноса определяет решение вызывающего выравнивателя о продолжении, функции не взаимозаменяемы
  27++AE2A              ; -----------------------------------------
  28++AE2A                              ; чтение символа слова с предварительным продвижением указателя
  29++AE2A 7E           Entry:          LD A, (HL)
  30++AE2B 23                           INC HL
  31++AE2C                              ; проверка CR, который должен передать вызывающему признак E=1
  32++AE2C FE 0D                        CP @TextConst.CarriageReturn
  33++AE2E 28 1D                        JR Z, @Station.PrintWrapWord.CarriageReturn                     ; переход, если прочитан CR, вернуть E=1 без сдвига курсора
  34++AE30
  35++AE30                              ; проверка LF, завершающего текущий текст
  36++AE30 FE 0A                        CP @TextConst.LineFeed
  37++AE32 C8                           RET Z                                                           ; выход, если прочитан LF, флаги остаются от сравнения
  38++AE33
  39++AE33                              ; проверка пробела, завершающего слово без рисования самого пробела
  40++AE33 FE 20                        CP @TextConst.Space
  41++AE35 28 1C                        JR Z, @Station.PrintWrapWord.Space                              ; переход, если прочитан пробел, вернуть границу слова
  42++AE37
  43++AE37 CD 8D AE                     CALL @Station.DrawGlyph.Entry
  44++AE3A 38 EE                        JR C, @Station.PrintWrapWord.Entry                              ; переход, если глиф принят, читать следующий символ слова
  45++AE3C
  46++AE3C                              ; проверка кода отказа физического X
  47++AE3C A7                           AND A
  48++AE3D 28 EB                        JR Z, @Station.PrintWrapWord.Entry                              ; переход, если отказ физического X имеет код 0, пропустить этот символ
  49++AE3F
  50++AE3F                              ; проверка отказа ширины перед попыткой нового текстового ряда
  51++AE3F FE 03                        CP @GlyphStatus.Width
  52++AE41 20 0E                        JR NZ, @Station.PrintWrapWord.Stop                              ; переход, если отказ не связан с шириной, вернуть остановку
  53++AE43
  54++AE43                              ; возврат указателя к символу, который вызывающая сторона сможет повторить после переноса
  55++AE43 2B                           DEC HL
  56++AE44 CD 55 AE                     CALL @Station.AdvanceTextRow.Entry
  57++AE47                              ; формирование A=0 с сохранением Carry от AdvanceTextRow
  58++AE47 3E 01                        LD A, #01
  59++AE49 3D                           DEC A
  60++AE4A D8                           RET C                                                           ; выход, если переход строки отказал, A=0 и HL остаётся на символе
  61++AE4B
  62++AE4B                              ; формирование A=1 после принятого переноса, вызывающий код может продолжить печать
  63++AE4B 3C                           INC A
  64++AE4C C9                           RET
  65++AE4D
  66++AE4D AF           CarriageReturn: XOR A
  67++AE4E 3C                           INC A
  68++AE4F 5F                           LD E, A
  69++AE50 C9                           RET
  70++AE51
  71++AE51 AF           Stop:           XOR A
  72++AE52 C9                           RET
  73++AE53
  74++AE53 3C           Space:          INC A
