  44++DB6A 7B                           LD A, E
  45++DB6B 2F                           CPL
  46++DB6C 5F                           LD E, A
  47++DB6D 7A                           LD A, D
  48++DB6E 2F                           CPL
  49++DB6F 57                           LD D, A
  50++DB70 13                           INC DE
  51++DB71                              ; проверка знака левого операнда перед взятием модуля
  52++DB71 CB 7C        CheckLeftSign:  BIT 7, H
  53++DB73 28 07                        JR Z, @Map.MultiplySigned16.SelectKernel                        ; переход, если HL неотрицателен, оставить его модуль без изменений
  54++DB75
  55++DB75                              ; расчёт модуля отрицательного HL дополнительным кодом
  56++DB75 7D                           LD A, L
  57++DB76 2F                           CPL
  58++DB77 6F                           LD L, A
  59++DB78 7C                           LD A, H
  60++DB79 2F                           CPL
  61++DB7A 67                           LD H, A
  62++DB7B 23                           INC HL
