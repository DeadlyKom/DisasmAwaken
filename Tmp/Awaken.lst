  10++C87C              ;   StationState.PointerXY - видимые пиксельные координаты, карта владельцев и её пары индексов доступны
  11++C87C              ;   для допустимого владельца FInterfaceItem имеет Width=1..32,Height=1..24 и непустое пересечение с экраном
  12++C87C              ;   TrackState.FlagsCache задаёт запреты, вызывающий код подготавливает его отдельно от текущего Flags записи
  13++C87C              ;   таблицы адресов готовы, выполняются предусловия SuspendPointer и XorRectOutline, HALT получает корректное пробуждение
  14++C87C              ; Out:
  15++C87C              ;   HL, DE и BC сохранены, A исходный, IX сохранён
  16++C87C              ;   без выбранного действия F=AND(A), Carry=0, геометрия и PointerXY сохранены
  17++C87C              ;   при выполненном действии F=(AND_flags(A) AND #C4) OR (A AND #28) OR 1
