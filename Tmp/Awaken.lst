   3++AA1D              ; Подробный разбор [индекс банка 4](../../Docs/Bank4Index.md)
   4++AA1D              ; Сумма двух байтов банка 4 с возвратом банка языка 6
   5++AA1D              ; In:
   6++AA1D              ;   банк 4 загружен и содержит читаемые байты #E146 и #E148, #E147 также читается командой LD BC
   7++AA1D              ;   аппаратный порт и CurrentPage согласованы, bit5 снят, CPU-стек вне сменяемого окна
   8++AA1D              ;   продолжение после возврата находится в фиксированной памяти либо в банке 6
   9++AA1D              ; Out:
  10++AA1D              ;   HL, DE сохранены, BC - B=0, C=(банк4.E146 + банк4.E148) AND #FF
  11++AA1D              ;   AF - A=(входная CurrentPage AND #F8) OR #16, F от финального OR страницы, не от суммы индекса
  12++AA1D              ;   альтернативные и индексные регистры, I и IFF сохранены, SP восстановлен
  13++AA1D              ;   аппаратный порт и тень выбирают сначала (старое AND #F8) OR #14, затем (старое AND #F8) OR #16
  14++AA1D              ; Corrupt:
  15++AA1D              ;   BC, AF
  16++AA1D              ; Note:
  17++AA1D              ;   старший байт E147 загружается в B, затем явно отбрасывается, перенос суммы также не расширяет индекс
  18++AA1D              ;   старшие управляющие биты страницы сохраняются, исходный номер банка не восстанавливается
  19++AA1D              ;   назначение двух компонентов индекса в игровом состоянии ещё не доказано
  20++AA1D                              ; выбор банка 4 с ROM 1 для чтения двух компонентов индекса
  21++AA1D 3E 14        Entry:          LD A, #14
  22++AA1F CD 96 63                     CALL @Station.SelectRamBank.Entry
  23++AA22                              ; чтение первого компонента в C, старший прочитанный байт B затем отбрасывается
  24++AA22 ED 4B 46 E1                  LD BC, (#E146)
  25++AA26                              ; чтение второго байтового компонента индекса
  26++AA26 3A 48 E1                     LD A, (#E148)
  27++AA29                              ; расчёт суммы компонентов по модулю 256
  28++AA29 81                           ADD A, C
