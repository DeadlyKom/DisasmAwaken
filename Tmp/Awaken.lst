   1++CAB3                              module Controls
   2++CAB3                              module InitializeBufferPoints
   3++CAB3                              ; Документация [алгоритм и проверка](../../Docs/ControlsBufferPoints.md)
   4++CAB3                              ; -----------------------------------------
   5++CAB3                              ; Подготовка 35 координат Y,X с исходным ограничением диапазонов
   6++CAB3                              ; исходная запись 22, банк 1, смещения #0AB3..#0AE2
   7++CAB3                              ; In:
   8++CAB3                              ;   HL, DE, BC, AF входных аргументов не задают, начальное состояние берётся из Seed
   9++CAB3                              ;   банк 1 выбран, Seed и все 70 байтов ControlsBufferPoints доступны для записи
  10++CAB3                              ;   на CPU-стеке внешний возврат, ещё два байта используются настоящими CALL генератора
  11++CAB3                              ; Out:
  12++CAB3                              ;   HL=адрес после Point22, DE и BC сохранены, A=46, F=42
  13++CAB3                              ;   подготовлены 35 записей Y,X, Y=1..94, X=1..253, распределение неравномерное
  14++CAB3                              ;   Seed обновлён 70 раз, перед каждой парой сначала генерируется X, затем Y, физически сохраняются Y, затем X
  15++CAB3                              ;   HL', DE', BC' содержат последний результат генератора, A' содержит Y последней точки, F' только Carry последнего ограничения Y
  16++CAB3                              ;   IX и IY, I, IM и IFF сохраняются, SP=входной SP+2
  17++CAB3                              ; Corrupt:
  18++CAB3                              ;   HL, AF, HL', DE', BC', AF', 70 байтов точек, Seed, два байта CPU-стека, R
  19++CAB3                              ; Note:
  20++CAB3                              ;   X=0 заменяется на 2, X>=254 уменьшается на 2
  21++CAB3                              ;   Y сначала ограничивается AND 7F, нуль заменяется на 2, значения >=95 уменьшаются на 64
  22++CAB3                              ;   изменённые границы или равномерный генератор исправили бы оригинальный алгоритм, здесь они не вводятся
  23++CAB3                              ; -----------------------------------------
  24++CAB3                              ; выбор первой физической записи Y,X в таблице из 35 точек
  25++CAB3 21 00 C5     Entry:          LD HL, @ControlsBufferPoints.Point00
  26++CAB6                              ; создание горизонтальной координаты настоящим вызовом генератора
  27++CAB6 CD 8D CA     NextPoint:      CALL @Controls.NextBufferRandom.Entry
  28++CAB9                              ; проверка нулевой горизонтальной координаты перед заменой на 2
  29++CAB9 FE 01                        CP @BufferPointConst.MinCoordinate
