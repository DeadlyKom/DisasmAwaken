  16++A311              ;   если обработчик не последний, HL=последний-ожидаемый по модулю 65536, DE и BC сохранены, AF=#0044
  17++A311              ;   если первое попадание отвергнуто, HL=0, DE ограничение и отступ, B начало области, C=PointerY, AF=#0044
  18++A311              ;   если номер совпадает, HL=0, DE ограничение и отступ, B начало области, C=номер, A=прежний номер, F от CP C с Z=1
  19++A311              ;   при изменении HL, DE и BC соответствуют последнему XorPointerRow, AF - A итоговый D, F=0 с Z=0
  20++A311              ;   при изменении указатель восстановлен через ResumePointer, UpdateBlocked=0, AF' рабочий
