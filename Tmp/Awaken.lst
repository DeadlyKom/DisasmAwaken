  25++A7F5 2A 44 98     Entry:          LD HL, (@MapSelection.FirstWord)
  26++A7F8 ED 5B 46 98                  LD DE, (@MapSelection.SecondWord)
  27++A7FC                              ; объединение четырёх байтов ключа через XOR, порядок не влияет на результат
  28++A7FC 7C                           LD A, H
  29++A7FD AD                           XOR L
  30++A7FE AB                           XOR E
  31++A7FF AA                           XOR D
  32++A800                              ; выделение числового кода 0..7 из младших трёх битов XOR
  33++A800 E6 07                        AND @MapVariantConst.CountMask
  34++A802                              ; расчёт предварительного количества q-1, при q=0 получится FF со знаком
  35++A802 3D                           DEC A
  36++A803 F0                           RET P                                                           ; выход, если код q ненулевой, вернуть количество q-1 в диапазоне 0..6
  37++A804
  38++A804                              ; замена отрицательного результата FF на ноль для исходного кода q=0
  39++A804 AF                           XOR A
  40++A805 C9                           RET
  41++A806
  42++A806                              endmodule
  43++A806                              endmodule
