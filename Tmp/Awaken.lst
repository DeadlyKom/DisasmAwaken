   1++CEA4                              module Controls
   2++CEA4                              module FillEvenSpan
   3++CEA4                              ; Документация [алгоритм и проверка](../../Docs/ControlsEvenSpan.md)
   4++CEA4                              ; -----------------------------------------
   5++CEA4                              ; Обратное заполнение 2*A байтов через изменяемый JR в пределах страницы
   6++CEA4                              ; исходная запись 22, банк 1, смещения #0EA4..#0EB4
   7++CEA4                              ; In:
   8++CEA4                              ;   HL задаёт H страницы назначения, DE задаёт D как правую исключённую границу внутри страницы
   9++CEA4                              ;   AF задаёт A=0..15 как половину длины, IXL содержит байт заполнения
  10++CEA4                              ;   банк 1 выбран, код, стек и назначение доступны для записи и не перекрываются
  11++CEA4                              ;   на CPU-стеке внешний возврат, для сохранения HL нужны ещё два байта, IRQ не вмешиваются
  12++CEA4                              ; Out:
  13++CEA4                              ;   HL=256*входной H+входной D, DE и BC сохраняются
  14++CEA4                              ;   AF содержит A=Mode и F от AND A, Z проверяет нулевой Mode, H=1, N=0, Carry=0
  15++CEA4                              ;   при A=1..15 записаны 2*A байтов IXL справа налево, DEC L не переносит заём в H
  16++CEA4                              ;   HL', DE', BC', AF', IX и IY, I, IM и IFF сохраняются, SP=входной SP+2
  17++CEA4                              ;   R получает 6 M1 при A=0 либо 16+4*A M1 при A=1..15
  18++CEA4                              ; Corrupt:
  19++CEA4                              ;   HL, AF, операнд TailOffset, назначение, два байта CPU-стека, R
  20++CEA4                              ; Note:
  21++CEA4                              ;   нулевой счётчик не меняет RAM, A=80 также пропускает заполнение из-за нулевого результата ADD A,A
  22++CEA4                              ;   A=10 задаёт исходное смещение FE и зацикливает SelectTail, в этом примечании число шестнадцатеричное
  23++CEA4                              ;   прочие значения A вне договора, допустимость аргументов всех игровых вызывающих процедур отдельно не доказана
  24++CEA4                              ;   два исходных байта CEB5..CEB6 сохранены как неустановленная область, допустимые входы их не исполняют
  25++CEA4                              ; -----------------------------------------
  26++CEA4                              ; выбор правой исключённой границы в L без изменения H страницы назначения
  27++CEA4 6A           Entry:          LD L, D
  28++CEA5                              ; проверка удвоенной длины, A=0 и A=80 дают нулевой результат
  29++CEA5 87                           ADD A, A
  30++CEA6 28 4C                        JR Z, @Controls.FillEvenSpanTail.ReadMode                       ; переход, если удвоенная длина равна нулю, прочитать Mode через ReadMode без сохранения HL
  31++CEA8
  32++CEA8                              ; сохранение указателя с выбранным правым краем для общего POP HL после заполнения
  33++CEA8 E5                           PUSH HL
  34++CEA9                              ; вычисление смещения JR как 62-4*A, при A=1..15 выбираются хвосты длиной 2*A
  35++CEA9 87                           ADD A, A
  36++CEAA D6 3E                        SUB #3E
  37++CEAC ED 44                        NEG
  38++CEAE                              ; обновление существующего операнда TailOffset для выбора точки входа в цепочку
  39++CEAE 32 B4 CE                     LD (@ControlsEvenSpanState.TailOffset), A
  40++CEB1                              ; выбор байта заполнения из IXL перед динамическим переходом
  41++CEB1 DD 7D                        LD A, IXL
  42++CEB3                              ; переход по изменяемому TailOffset, исходное FE означает цикл без продвижения
  43++CEB3 18 FE        SelectTail:     JR @Controls.FillEvenSpan.SelectTail
  44++CEB5
  45++CEB5                              endmodule
  46++CEB5                              endmodule
