   5++7F35              ; -----------------------------------------
   6++7F35              ; Заливка статусного элемента и вывод полицейского статуса, денег, тоннажа и ранга
   7++7F35              ; исходная запись 4, файловые смещения #21E1..#2237
   8++7F35              ; In:
   9++7F35              ;   DrawItemState.Opcode00 равен 21 для работы либо C9 для отключения, Index00 содержит индекс FInterfaceItem
  10++7F35              ;   действует договор RegisterAndFillItem, исходная геометрия имеет видимое пересечение с экраном
  11++7F35              ;   TextIndex записи выбирает существующий LF-поток от EA89, разделитель SkipLfRecords равен LF
  12++7F35              ;   исходные тексты статуса EA3B и ранга доступны в банке станции 0, шрифт и текстовый код готовы
  13++7F35              ;   доступны байт Status984B, денежное слово 984E, байты тоннажа 9850 и 9851, счётчик RankState.Score
  14++7F35              ; Out:
  15++7F35              ;   регистрирует и заливает bitmap прямоугольника, TextWindow.Style=1, атрибуты не меняет
  16++7F35              ;   HL у поля Flags после RegisterAndFillItem, следующий байт TextIndex задаёт первую печатаемую запись
  17++7F35              ;   выбирает один из четырёх статусов по min(Status984B SHR 5,3), младшие пять бит для выбора не используются
  18++7F35              ;   после статуса продолжает исходный поток, печатает слово денег с бюджетом нулей A=0
  19++7F35              ;   ещё раз продолжает поток, печатает байт используемого тоннажа, двоеточие и байт вместимости
  20++7F35              ;   оба байта тоннажа передаются PrintMin2 как слова с нулевым старшим байтом
  21++7F35              ;   хвостовой вход PrintPlayerRank даёт окончательные HL, DE, BC и AF по его договору
  22++7F35              ;   HL', DE', BC', IX, IY, I и IFF сохранены, AF' соответствует RegisterAndFillItem
