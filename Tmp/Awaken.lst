  24++AE58 C6 08                        ADD A, @ScreenConst.PixelsPerChar
  25++AE5A 4F                           LD C, A
  26++AE5B 3A AB AE                     LD A, (@TextWindow.Height)
  27++AE5E 47                           LD B, A
  28++AE5F 79                           LD A, C
  29++AE60                              ; проверка строгой верхней границы относительного курсора
  30++AE60 B8                           CP B
  31++AE61 3F                           CCF
  32++AE62 D8                           RET C                                                           ; выход, если новая относительная строка не меньше высоты окна, курсор сохраняется
  33++AE63
  34++AE63                              ; обновление принятой строки и возврат курсора к началу окна по X
  35++AE63 32 21 63                     LD (@TextWindow.CursorY), A
  36++AE66 AF                           XOR A
  37++AE67 32 20 63                     LD (@TextWindow.CursorX), A
  38++AE6A C9                           RET
