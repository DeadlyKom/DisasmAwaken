   6++D1AC              ; Построение относительных точек и рисование открытой индексированной цепочки из N-1 отрезков
   7++D1AC              ; исходная запись 7, файловые смещения #11AC..#12ED
   8++D1AC              ; In:
   9++D1AC              ;   HL - начало пятибайтовых FStoredMapPoint, FirstWord содержит старшие X,Y, SecondWord младшие X,Y
  10++D1AC              ;   DE - FStoredMapOrder либо совместимый заголовок с N индексами, N=Layout AND 0F, известный экземпляр имеет ёмкость 10
  11++D1AC              ;   каждый индекс есть смещение 5*k выбранной точки, 0<=k<N, Variant в расчёте координат не используется
  12++D1AC              ;   MapViewState.OriginLow/OriginHigh задают вычитаемое начало, KARTA выбран, действуют условия RasterizeMapLine
  13++D1AC              ;   входные массивы не перекрывают F800, F900, рабочие поля таблицы и код, нужный текущему вызову
  14++D1AC              ; Out:
  15++D1AC              ;   N=0 или N=1 даёт ранний выход без изменения HL, DE, BC, альтернативных и индексных регистров
  16++D1AC              ;   у этого раннего выхода A=0, F=54 для N=0 и F=42 для N=1, рабочие поля и режим линии не меняются
  17++D1AC              ;   при N>=2 сформированы N FProjectedPoint по F800 с 16-битными X,Y относительно начала и исходными ClipCodes
  18++D1AC              ;   если все точки имеют общую внешнюю сторону, выполнен ранний возврат с обменёнными HL/DE/BC и HL'/DE'/BC'
  19++D1AC              ;   для этого выхода HL=F801+5*N, DE=входной DE', BC=(G SHL 8)|последний младший код, A=K SHL 4, F от AND F0
  20++D1AC              ;   HL'=входной DE, DE'=F800+5*N, BC'=(входной B SHL 8)|старший Y начала, A'=5*N, F'=42 OR((5*N)AND 28)
  21++D1AC              ;   иначе обработаны N-1 соседних пар индексов, автоматического ребра от последнего к первому нет
  22++D1AC              ;   внутренние пары переданы прямо в RasterizeMapLine, внешние проходят общий код отсечения, общий внешний бит пропускает пару
  23++D1AC              ;   у обычного окончания HL=входной DE+1+N, DE рабочий, BC=старший Y начала при B=0, AF рабочий
  24++D1AC              ;   HL'=F801+5*N, DE'=входной DE', BC'=(G SHL 8)|последний младший код, AF' рабочий
  25++D1AC              ;   IX=F800|последний индекс, IY сохранён, I и IFF сохранены, SP обычного возврата равен входному SP+2
  26++D1AC              ; Corrupt:
  27++D1AC              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, точные различия ранних выходов перечислены выше
  28++D1AC              ; Note:
  29++D1AC              ;   G есть OR всех полных ClipCodes, K есть AND их младших кодов, проверка K выполняется через дополненную старшую тетраду G
