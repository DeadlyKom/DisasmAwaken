   9++E14E                              ;   BC задаёт B как верхнюю строку Y, C как левую координату X, AF входных аргументов не задаёт
  10++E14E                              ;   банк 1 выбран, шесть байтов выбранной фазы доступны для чтения и не перекрываются с шестью целями записи
  11++E14E                              ;   на CPU-стеке внешний возврат, рамка и исполняемый код не перекрываются с целями, IRQ не вмешиваются
  12++E14E                              ; Out:
  13++E14E                              ;   HL указывает правый байт нижней третьей строки, DE=(входной DE+6*(X AND 7)+5) AND FFFF
  14++E14E                              ;   B=входной Y, C=2*(X AND 7), A содержит результат последнего OR, F соответствует этому OR, H, N, C сброшены
  15++E14E                              ;   HL', DE', BC', AF', IX, IY, I, IM и IFF сохраняются, SP=входной SP+2
  16++E14E                              ;   выполнены ровно шесть записей OR, никакие пиксели не очищаются и CPU-стек не записывается
  17++E14E                              ;   R получает 69 M1 при (Y AND 7)<6, 73 при (Y AND 3F)>=3E, иначе 76
  18++E14E                              ; Corrupt:
  19++E14E                              ;   HL, DE, BC в части C, AF, шесть байтов растра, R
  20++E14E                              ; Note:
  21++E14E                              ;   B и C байтовые, отсечение по ширине и высоте не выполняется, игровые вызывающие ограничивают координаты отдельно
  22++E14E                              ;   переход к правому байту использует INC L без переноса в H, столбец 31 сохраняет исходное нелинейное поведение
  23++E14E                              ;   переходы строк учитывают чередование страниц Spectrum, при Y>=192 затрагиваются атрибуты и следующая RAM
  24++E14E                              ;   адрес выбранной фазы и последовательные INC DE переходят через FFFF по модулю слова
  25++E14E                              ;   четыре исходных знака имеют ширину три пикселя и высоту три строки, пиксельный центр находится на X+1, Y+1
  26++E14E                              ;   общий алгоритм применим к шести масочным байтам выбранной фазы, перекрывающиеся ресурсы не входят в доказанный договор
  27++E14E                              ; -----------------------------------------
