  13++6547              ;   DE - адрес строки после восстановленных, B=0, C=255-2*VisibleRows, AF результат перехода строки
  14++6547              ; Corrupt:
  15++6547              ;   HL, DE, BC, AF
  16++6547              ; Note:
  17++6547              ;   все альтернативные и индексные регистры, I и IFF сохраняются, SP восстанавливается
  18++6547              ;   сохраняются и восстанавливаются два байта строки, независимо от однобайтового правого отсечения
  19++6547              ;   ноль VisibleRows не обрабатывается отдельно и запустил бы 256 итераций DJNZ
