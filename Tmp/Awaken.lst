   5++7A15              ; -----------------------------------------
   6++7A15              ; Обёртка рисования элемента 30 через изменяемый индекс и DrawCenteredItem
   7++7A15              ; исходная запись 4, файловые смещения #1CC1..#1CC6
   8++7A15              ; In:
   9++7A15              ;   DrawItemState.Index30 содержит актуальный индекс, исходный загрузчик записывает 30
  10++7A15              ;   DrawItemState.Opcode30 равен #21 для работы либо #C9 для отключения
  11++7A15              ;   при активном коде в окне #C000 выбрана страница станционного кода, действует полный договор DrawCenteredItem
  12++7A15              ;   на CPU-стеке находится адрес возврата вызывающей стороны
  13++7A15              ; Out:
  14++7A15              ;   при активном коде HL - индекс из DrawItemState.Index30, DE и BC сохранены
  15++7A15              ;   при активном коде AF - A=#C3, F от последнего текстового прохода общего рисователя
  16++7A15              ;   при отключённом коде обычный RET сохраняет все регистры и флаги, включая исходный HL
  17++7A15              ;   bitmap, карта владельцев, текстовое окно и рабочие регистры определяются DrawCenteredItem
  18++7A15              ; Corrupt:
  19++7A15              ;   HL, AF, HL', AF'
  20++7A15              ; Note:
  21++7A15              ;   до перехода в общий рисователь сама обёртка меняет только HL, флаги и стек не изменяет
  22++7A15              ;   непосредственное слово LD HL первоначально равно нулю в дисковом образе, это изменяемый код
  23++7A15              ;   DisableDrawList пишет в первый байт RET, EnableDrawList восстанавливает именно LD HL,nn без изменения слова индекса
  24++7A15              ;   индекс записывается исходным циклом #4257..#4275 по DrawHandler+1, поле TextIndex записи не меняется
  25++7A15              ;   JP передаёт исходный адрес возврата общему рисователю, дополнительного CALL здесь нет
  26++7A15              ;   H', DE', BC', IX, IY, I и IFF сохраняются по договору DrawCenteredItem
  27++7A15              ; -----------------------------------------
  28++7A15                              ; активный Opcode30 читает индекс Index30, временный RET отключает весь обработчик
  29++7A15 21 00 00     Entry:          LD HL, #0000
  30++7A18 C3 DF C2                     JP @Station.DrawCenteredItem.Entry
  31++7A1B
  32++7A1B                              endmodule
  33++7A1B                              endmodule
