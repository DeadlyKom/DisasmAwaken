  29++C01E DD 7E 00     FindCR:         LD A, (IX + @ScriptConst.Cursor)
  30++C021 DD 23                        INC IX
  31++C023                              ; проверка потреблённого символа на CR
  32++C023 FE 0D                        CP #0D
  33++C025 20 F7                        JR NZ, @Text.SkipLine.FindCR                                    ; переход, если прочитан не CR, продолжить пропуск
