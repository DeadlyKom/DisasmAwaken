  14++C5CD                              ;   AF - A=E, при снятом bit7 F=0, при установленном F=#90 OR (StockAndSaleBan AND #28)
  15++C5CD                              ;   BC, альтернативные регистры, IX, IY, I и IFF сохранены, память не изменяется
  16++C5CD                              ; Corrupt:
