   5++C00C              ; -----------------------------------------
   6++C00C              ; Восстановление стека сценария, чтение команды и выбор обработчика
   7++C00C              ; исходная запись 5, файловые смещения #000C..#001A
   8++C00C              ; In:
   9++C00C              ;   BC - C сохраняемый контекст, IX у следующего символа сценария
  10++C00C              ;   ScriptRuntimeState.SavedSP содержит доступный стек с возвратом, LANG выбран
  11++C00C              ;   при пропуске строки впереди существует CR, при команде действует договор её обработчика
  12++C00C              ; Out:
  13++C00C              ;   SP немедленно заменяется SavedSP, временные рамки предыдущей команды отбрасываются
  14++C00C              ;   NUL не потребляется, возврат с A=0, F=44, SP=SavedSP+2 и сохранёнными остальными парами
  15++C00C              ;   прочий первый байт потреблён, пробел передаёт управление SkipLine.Entry
  16++C00C              ;   CR передаёт управление SkipLine.AfterCR, прочий байт ищется среди 15 FScriptToken
  17++C00C              ;   при найденной команде HL=обработчик, DE=3, B=остаток с найденной записью, C сохранён
  18++C00C              ;   при совпадении A=младший байт обработчика, F от CP символа с собой, SP=SavedSP
  19++C00C              ;   неизвестный символ передаёт SkipLine.Entry с A=символ, HL=последняя запись, DE=3, B=0
  20++C00C              ;   при неизвестном символе F от последнего CP, SP=SavedSP-2 с возвратом FindToken на вершине
  21++C00C              ;   альтернативные регистры, IY, I и IFF сохранены до получателя управления
  22++C00C              ; Corrupt:
  23++C00C              ;   HL, DE, BC только B на поиске, AF, IX, SP
  24++C00C              ; Note:
  25++C00C              ;   ReadCommand сохраняет текущий SP, это внутренний вход после уже восстановленного стека
  26++C00C              ;   здесь описан выход до обработчика, SkipLine либо возврата, эффекты команд задаются отдельно
  27++C00C              ;   пробел означает пропуск остатка строки, а не обычный игнорируемый разделитель
  28++C00C              ; -----------------------------------------
  29++C00C                              ; восстановление стека сценария с отбрасыванием временных возвратов команды
  30++C00C ED 7B 1C C0  Entry:          LD SP, (@ScriptRuntimeState.SavedSP)
