  80++A055 08           CountRow:       EX AF, AF'
  81++A056                              ; расчёт оставшегося числа строк иконки
  82++A056 3D                           DEC A
  83++A057 C2 39 A0                     JP NZ, @Station.CopyWindowIcon.CopyRow                          ; переход, если скопированы ещё не все 32 строки, обработать следующую строку
  84++A05A
  85++A05A C9                           RET
  86++A05B
  87++A05B                              endmodule
  88++A05B                              endmodule
