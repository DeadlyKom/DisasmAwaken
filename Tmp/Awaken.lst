   1++D320                              module Controls
   2++D320                              module BuildCircleSpan
   3++D320                              ; Документация [алгоритм и проверка](../../Docs/ControlsCircleSpan.md)
   4++D320                              ; -----------------------------------------
   5++D320                              ; Построение адресов и включающих масок двух краёв сечения большого контура
   6++D320                              ; исходная запись 22, банк 1, смещения #1320..#133F
   7++D320                              ; In:
   8++D320                              ;   HL, DE, BC и AF входных аргументов не задают
   9++D320                              ;   банк 1 выбран, физические Flags и Radius, байты CenterY и CenterX доступны для чтения
  10++D320                              ;   общий Mode читается масочными помощниками, SavedB доступен для записи
  11++D320                              ;   на стеке внешний возврат, ещё два байта нужны последовательно для CALL и PUSH AF, IRQ не вмешиваются
  12++D320                              ; Out:
  13++D320                              ;   при Xl=(CenterX-Radius) AND FF, Xr=(CenterX+Radius) AND FF, Pl=8000+32*CenterY+(Xl DIV 8), Pr=8000+32*CenterY+(Xr DIV 8)
  14++D320                              ;   HL=Pr, D=Radius, E=LOW Pl, B=(FF << (7-(Xl AND 7))) AND FF, C=FF >> (Xr AND 7)
  15++D320                              ;   A=B, F=42, Z и N установлены, остальные биты F сброшены
  16++D320                              ;   HL', DE', BC' сохраняются кроме E'=0 и C'=(-Radius) AND FF, AF', IX и IY сохраняются
  17++D320                              ;   SavedB содержит левую маску B, I, IM и IFF сохраняются, SP=входной SP+2
  18++D320                              ;   R учитывает прямой путь и 1+(Xl AND 7) шагов левой маски и 8-(Xr AND 7) шагов правой маски
  19++D320                              ; Corrupt:
  20++D320                              ;   HL, DE, BC, AF, E', C', SavedB, два байта CPU-стека, R
  21++D320                              ; Note:
  22++D320                              ;   радиус, центр и переносы X не ограничиваются, вычисленные адреса не разыменовываются
  23++D320                              ;   обе маски включают свой край, последующий рисователь сохраняет их биты и заполняет открытый интервал
  24++D320                              ;   последний JP в BuildRightSpanMask использует внешний возврат этой процедуры, отдельного CALL справа нет
  25++D320                              ;   два временных байта сначала получают возврат D335, затем Xr и флаги ADD CenterX,Radius
  26++D320                              ;   влияние общего Mode на флаги уничтожено внутри помощников, F=42 не проверяет возвращаемую маску
  27++D320                              ; -----------------------------------------
  28++D320                              ; загрузка центральной строки и горизонтального центра сечения
  29++D320 ED 4B 83 D1  Entry:          LD BC, (@ControlsCircleSetupState.CenterY)
  30++D324                              ; загрузка Flags и Radius из физической записи проекции
  31++D324 ED 5B 7F D1                  LD DE, (@ControlsBodyProjection.Value.Flags)
  32++D328                              ; вычисление отрицательного радиуса для альтернативного состояния контура
