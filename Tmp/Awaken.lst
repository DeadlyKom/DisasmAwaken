  44++DB23 CD 35 AD                     CALL @Station.SkipJustifyRow.Entry
  45++DB26 D1                           POP DE
  46++DB27 13                           INC DE
  47++DB28 D2 13 DB                     JP NC, @Help.IndexTextLines.StoreLine                           ; переход, если строка закончилась переносом, требуется следующая
  48++DB2B
  49++DB2B                              ; обнуление остатка таблицы, исходный код требует от 1 до 1023 занятых слов
  50++DB2B D5                           PUSH DE
  51++DB2C DD E5                        PUSH IX
  52++DB2E                              ; расчёт числа свободных слов и перевод его в байтовый счётчик
  53++DB2E 21 00 04                     LD HL, @HelpLineConst.Capacity
  54++DB31 B7                           OR A
