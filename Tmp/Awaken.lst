   1++C870                              module Controls
   2++C870                              module CopyViewportToScreen
   3++C870                              ; Документация [алгоритм и проверка](../../Docs/ControlsBufferCopy.md)
   4++C870                              ; -----------------------------------------
   5++C870                              ; Перенос линейного растра 256 на 96 пикселей в верхнюю половину экрана
   6++C870                              ; исходная запись 22, банк 1, смещения #0870..#0881
   7++C870                              ; In:
   8++C870                              ;   HL, DE, BC, AF и альтернативные регистры, IX и IY входных аргументов не задают
   9++C870                              ;   8000..8BFF содержит 96 линейных растровых строк по 32 байта
  10++C870                              ;   банк 1 выбран, CONTROL0 и его изменяемые операнды доступны для записи
  11++C870                              ;   источник, экран и CPU-стек не перекрываются, источник не перекрывает код копировщика
  12++C870                              ;   на CPU-стеке находится внешний возврат, обработчик IRQ не должен использовать временный экранный SP
  13++C870                              ; Out:
  14++C870                              ;   3072 байта исходного растра перенесены в экранные строки y=0..95, все 32 байта каждой строки
  15++C870                              ;   HL=8C00, DE и BC содержат слова 8BF4..8BF5 и 8BF2..8BF3, A=00, F=42 OR (байт 8BF0 AND 01)
  16++C870                              ;   HL'=488F, DE'=F910, BC' содержит слово 8BFA..8BFB, A' содержит байт 8BF9
  17++C870                              ;   F' соответствует последнему ADD HL,F910 с сохранёнными S,Z,PV из байта 8BF8
  18++C870                              ;   IX содержит слово 8BF6..8BF7, IY слово 8BFE..8BFF, I, IM и IFF сохраняются
  19++C870                              ;   SavedStack содержит входной SP, RemainingPages содержит 01, внешний RET даёт SP=входной SP+2
  20++C870                              ; Corrupt:
  21++C870                              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY, 3072 байта экрана, три байта операндов и два байта CPU-стека, R
  22++C870                              ; Note:
  23++C870                              ;   атрибуты и нижние 96 растровых строк экрана сохраняются, пиксельные байты временно используются как F и F'
  24++C870                              ;   первая часть вызывает CopyScreenRows для восьми страниц, вторая продолжает его физически для четырёх
  25++C870                              ;   DI не выполняется, сохранение IFF не доказывает безопасность ISR при экранном SP
  26++C870                              ; -----------------------------------------
  27++C870                              ; подготовка адреса перед первой половиной верхней строки экрана
  28++C870 21 0F 40     Entry:          LD HL, #400F
  29++C873                              ; передача экранного адреса в альтернативный HL и выбор линейного источника
  30++C873 D9                           EXX
  31++C874 21 00 80                     LD HL, #8000
  32++C877                              ; выбор восьми 256-байтовых страниц для экранных строк 0..63
  33++C877 3E 08                        LD A, #08
  34++C879 CD 82 C8                     CALL @Controls.CopyScreenRows.Entry
  35++C87C                              ; обновление только H экранного адреса, L=0F после восьми страниц сохраняется
  36++C87C D9                           EXX
  37++C87D 26 48                        LD H, #48
  38++C87F D9                           EXX
  39++C880                              ; выбор ещё четырёх страниц для строк 64..95 перед физическим продолжением
  40++C880 3E 04                        LD A, #04
  41++C882                              ; JP @Controls.CopyScreenRows.Entry, продолжение в CopyScreenRows.asm
  42++C882
  43++C882                              endmodule
  44++C882                              endmodule
