   5++C685              ; -----------------------------------------
   6++C685              ; Создание захватывающего писателя семибитового поля через ReadCargoField
   7++C685              ; исходная запись 5, файловые смещения #0685..#06B5
   8++C685              ; In:
   9++C685              ;   HL' указывает на два доступных байта следующего слова выражения, действует входной договор ReadCargoField
  10++C685              ;   результат читателя HL должен быть адресом записываемого целевого байта, полученное значение доступно
  11++C685              ;   до Invoke нельзя создавать другой писатель того же общего шаблона, захваченные операнды общие
  12++C685              ;   Invoke принимает FFieldInvokeFrame и BC правый операнд, оператор возвращает DE через RET в банк LANG 6
  13++C685              ; Out:
  14++C685              ;   Entry - HL адрес от читателя, DE общий Invoke, BC от читателя, AF A=E читателя, F сохранён
  15++C685              ;   Entry - HL' увеличен на два, DE' содержит Invoke, BC', AF', IX, IY по договору читателя
  16++C685              ;   Entry обновляет общие операнды Target и InitialValue, само целевое поле не записывает
  17++C685              ;   Invoke передаёт оператору DE захваченное байтовое значение с нулевым D, BC правый операнд
  18++C685              ;   перед входом оператора CPU-стек FIndexedOperatorFrame, сохранены StoreReturn, SavedTarget и AfterStore
  19++C685              ;   Store возвращает HL адрес цели, BC как у оператора, DE с E=127 при D!=0 либо E AND 127 при D=0, D сохранён
  20++C685              ;   Store - AF A сохранённый байт, F от OR маркера с младшими семью разрядами
  21++C685              ;   SP после Entry равен входному SP+2, после Invoke либо отдельного Store входному SP+4
  22++C685              ; Corrupt:
  23++C685              ;   Entry - HL, DE, BC, AF, HL', DE', BC' только B, AF' и IX по договору читателя
  24++C685              ;   Invoke - HL, DE и регистры по договору оператора
  25++C685              ;   Store - HL, DE только E, AF
  26++C685              ; Note:
  27++C685              ;   целевой адрес и левый операнд захватываются при создании, маркер либо условие инверсии читается из памяти только в Store
  28++C685              ;   Invoke добавляет SavedTarget между StoreReturn и AfterStore, Store снимает этот адрес POP HL
  29++C685              ;   D!=0 выбирает E=127, но при D=0 значение E>=128 только маскируется, общего насыщения min(result,127) нет
  30++C685              ;   игровой смысл маркера и физические единицы веса отдельно не доказаны
  31++C685              ; -----------------------------------------
  32++C685                              ; получение адреса и текущего байта грузовой записи для захвата
  33++C685 CD 0A C3     Entry:          CALL @Text.ReadCargoField.Entry
  34++C688                              ; выбор E читателя как захваченного левого операнда, для груза bit7 может остаться
  35++C688 7B           Capture:        LD A, E
  36++C689                              ; обновление общего операнда Target адресом целевого байта
  37++C689 22 97 C6                     LD (@PackedWriterState.Target), HL
  38++C68C                              ; обновление общего InitialValue байтом левого операнда
  39++C68C 32 9A C6                     LD (@PackedWriterState.InitialValue), A
  40++C68F                              ; выбор общего Invoke семибитового писателя
  41++C68F 11 95 C6                     LD DE, @Text.PushCargo7BitWriter.Invoke
  42++C692 C3 B9 C1                     JP @Text.PushExpressionWord.Entry
  43++C695
  44++C695                              ; снятие адреса оператора из рамки вызова
  45++C695 D1           Invoke:         POP DE
  46++C696                              ; чтение захваченного адреса из изменяемого операнда Target
  47++C696 21 00 00                     LD HL, #0000
  48++C699                              ; чтение захваченного байтового левого операнда InitialValue
  49++C699 3E 00                        LD A, #00
  50++C69B                              ; сохранение Target на CPU-стеке до завершения операции
  51++C69B E5                           PUSH HL
  52++C69C                              ; выбор Store как аппаратного возврата оператора
  53++C69C 21 A5 C6                     LD HL, @Text.PushCargo7BitWriter.Store
  54++C69F                              ; создание шестибайтовой рамки FIndexedOperatorFrame
  55++C69F E5                           PUSH HL
  56++C6A0                              ; создание DE из захваченного левого байта с нулевым старшим байтом
  57++C6A0 6F                           LD L, A
  58++C6A1 26 00                        LD H, #00
  59++C6A3                              ; передача адреса оператора в HL и левого значения в DE
  60++C6A3 EB                           EX DE, HL
  61++C6A4 E9                           JP (HL)
  62++C6A5
  63++C6A5                              ; восстановление Target после RET оператора
  64++C6A5 E1           Store:          POP HL
  65++C6A6 7A                           LD A, D
  66++C6A7                              ; проверка ненулевого старшего байта результата перед выбором младших семи разрядов
  67++C6A7 B7                           OR A
  68++C6A8 28 02                        JR Z, @Text.PushCargo7BitWriter.MaskLow                         ; переход, если D равен нулю, использовать младший E после маскирования
  69++C6AA
  70++C6AA                              ; выбор E=127 при любом ненулевом D, старший D не изменяется
  71++C6AA 1E 7F                        LD E, #7F
  72++C6AC                              ; выбор младших семи разрядов E, значения 128..255 оборачиваются, не насыщаются
  73++C6AC 7B           MaskLow:        LD A, E
  74++C6AD E6 7F                        AND #7F
  75++C6AF 5F                           LD E, A
  76++C6B0                              ; чтение текущего маркера целевого байта в момент сохранения
  77++C6B0 7E                           LD A, (HL)
  78++C6B1                              ; выделение bit7 для объединения с новым семибитовым значением
  79++C6B1 E6 80                        AND #80
  80++C6B3                              ; создание записываемого байта и окончательных флагов
  81++C6B3 B3                           OR E
  82++C6B4 77                           LD (HL), A
  83++C6B5 C9                           RET
  84++C6B6
  85++C6B6                              endmodule
  86++C6B6                              endmodule
