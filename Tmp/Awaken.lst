   6++6364                              ; Переключение шаблона заполнения семи четырёхугольных и шести треугольных граней по двум опорным заголовкам
   7++6364                              ; исходная запись 4, файловые смещения #0610..#0641
   8++6364                              ; In:
   9++6364                              ;   подключён D3D в банке 4, заголовки граней PreviewFaceHeaders доступны для чтения и записи
  10++6364                              ;   Quad0 и Triangle0 являются двумя опорными байтами, допустимые игровые заголовки имеют ненулевой счётчик в младшей тетраде
  11++6364                              ; Out:
  12++6364                              ;   HL, DE и BC сохранены, AF - A исходный Triangle0 XOR 60, F от логического XOR этого значения
  13++6364                              ;   все семь Quad получают исходный Quad0 XOR 60, все шесть Triangle получают исходный Triangle0 XOR 60
  14++6364                              ;   альтернативные и индексные регистры, I, IFF и IM сохранены, SP обычного возврата равен входному SP+2
  15++6364                              ; Corrupt:
  16++6364                              ;   AF
  17++6364                              ; Note:
