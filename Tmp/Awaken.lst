   5++DB59              ; -----------------------------------------
   6++DB59              ; Специальный возврат со снятием трёх слов и установленным Carry
   7++DB59              ; исходная запись 7, файловые смещения #1B59..#1B62
   8++DB59              ; In:
   9++DB59              ;   SP указывает на FClipUnwindFrame, последовательно три снимаемых слова и настоящий адрес возврата
  10++DB59              ;   FirstWord передаёт A своим старшим байтом, SecondWord передаёт счётчик своим старшим байтом
  11++DB59              ;   ThirdWord является базой для возвращаемого HL, это описание фактического кадра без подмены обычным CALL
  12++DB59              ; Out:
  13++DB59              ;   A=high(FirstWord), BC=(high(SecondWord)-1)&255, HL=(ThirdWord+BC)&65535
  14++DB59              ;   Carry=1, S/Z/PV соответствуют DEC старшего байта SecondWord, H=N=0, биты 5 и 3 взяты из A
  15++DB59              ;   управление передано по ReturnAddress, SP=входной SP+8
  16++DB59              ;   DE, альтернативные регистры, IX, IY, I и IFF сохранены
  17++DB59              ; Corrupt:
  18++DB59              ;   HL, BC, AF, SP
  19++DB59              ; Note:
  20++DB59              ;   первые три слова намеренно удаляются, они не являются тремя обычными адресами CALL этой процедуры
  21++DB59              ;   владелец группового кадра и геометрическая причина этого выхода описываются вместе с обработчиками
  22++DB59              ; -----------------------------------------
  23++DB59                              ; снятие первого слова специального кадра, его старший байт становится возвращаемым A
  24++DB59 F1           Entry:          POP AF
