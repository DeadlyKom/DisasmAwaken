   5++43CF                              ; Создание четырёх страниц адресации линейного пиксельного буфера
   6++43CF                              ; исходная запись 17, смещения #0212..#023C, рабочий адрес #43CF
   7++43CF                              ; In:
   8++43CF                              ;   HL, DE, BC, AF входных аргументов не задают
   9++43CF                              ;   страницы 9400..97FF общей RAM доступны для записи, на CPU-стеке внешний возврат
  10++43CF                              ; Out:
  11++43CF                              ;   записаны 1024 байта, RowHigh[Y]=HIGH(8000+32*Y), RowLow[Y]=LOW(8000+32*Y)
  12++43CF                              ;   ColumnByte[X]=X DIV 8, ColumnMask[X]=80 >> (X AND 7), все индексы 0..255
  13++43CF                              ;   HL=9600, DE=A000, BC=0020, AF=2062
  14++43CF                              ;   HL', DE', BC' сохраняются, AF'=8083, IX и IY сохраняются
  15++43CF                              ;   I, IM и IFF сохраняются, портовых операций и дополнительных PUSH нет, SP=входной SP+2
  16++43CF                              ; Corrupt:
  17++43CF                              ;   HL, DE, BC, AF, AF', 1024 байта таблиц, R
  18++43CF                              ; Note:
  19++43CF                              ;   таблицы создаются во время исполнения, отдельная статическая копия в сборку не добавляется
  20++43CF                              ;   страницы имеют иное назначение в других фазах игры, этот договор относится к загрузке Action
  21++43CF                              ;   итоговый F=62 содержит бит 5 операнда CP 20, AF'=8083 отражает DEC H после последнего RRCA
  22++43CF                              ; -----------------------------------------
