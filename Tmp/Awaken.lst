   6++5CD1              ; Чтение 44 физических секторов через TR-DOS с возвратом на #6500
   7++5CD1              ; исходная запись 3, файловые смещения #0006..#001D
   8++5CD1              ; In:
   9++5CD1              ;   LoaderState.NextIntroBlock - слово начальной дорожки и сектора, TR-DOS доступен через #3D13
  10++5CD1              ; Out:
  11++5CD1              ;   перед входом TR-DOS HL=#6400, DE=NextIntroBlock, BC=#2C05, AF содержит прежний A и F=#22 плюс входной Carry, IY=#5C3A
  12++5CD1              ; Corrupt:
  13++5CD1              ;   HL, DE, BC, AF, IY, дальнейшие эффекты определяются TR-DOS
  14++5CD1              ; Note:
  15++5CD1              ;   DI запрещает прерывания, IM и I сам загрузчик не меняет
  16++5CD1              ;   SP получает #5FFF, на стек помещается #6500, при входе TR-DOS SP=#5FFD
  17++5CD1              ;   после чтения 44 физических секторов ожидается RET TR-DOS на InitializeIntro, прежний стек вызывающего кода не используется
  18++5CD1              ;   альтернативные регистры и IX сохраняются до передачи управления TR-DOS, после неё сохранение здесь не утверждается
  19++5CD1              ;   ошибка дискового чтения отдельно не проверяется, реальный ROM TR-DOS в изолированном тесте не исполняется
  20++5CD1              ; -----------------------------------------
  21++5CD1                              ; отключение прерываний перед заменой стека и чтением вступления
  22++5CD1 F3           Entry:          DI
  23++5CD2                              ; установка исходного рабочего стека, прежний стек BASIC больше не используется
  24++5CD2 31 FF 5F                     LD SP, @LoaderConst.StackTop
  25++5CD5 FD 21 3A 5C                  LD IY, @LoaderConst.SystemIY
  26++5CD9                              ; создание адреса возврата в начало вступления после дискового чтения
  27++5CD9 21 00 65                     LD HL, @Intro.InitializeIntro.Entry
  28++5CDC E5                           PUSH HL
  29++5CDD                              ; расчёт адреса загрузки на страницу ниже точки входа вступления
  30++5CDD 25                           DEC H
  31++5CDE                              ; чтение исходного слова дорожки и сектора из состояния загрузки
  32++5CDE ED 5B F4 5C                  LD DE, (@LoaderState.NextIntroBlock)
  33++5CE2 06 2C                        LD B, @LoaderConst.IntroSectors
  34++5CE4 0E 05                        LD C, @TrDos.ReadSectors
  35++5CE6 C3 13 3D                     JP @TrDos.Dispatch
  36++5CE9
  37++5CE9                              endmodule
  38++5CE9                              endmodule
