   3++4070              ; Документация [StationBoot](../../Docs/FunctionDetails/StationBoot.md)
   4++4070              ; -----------------------------------------
   5++4070              ; Загрузка банков карты, музыки, справки, 3D и языка, выбор фона, настройка устройств и запуск цикла станции
   6++4070              ; исходная запись 4, файловые смещения #0389..#05CD
   7++4070              ; In:
   8++4070              ;   ядро станции перенесено в #6322, загрузчик находится по исходному адресу #4000, TR-DOS доступен
   9++4070              ; Out:
  10++4070              ;   подключён банк 0, установлен IM 2, разрешены прерывания, управление передано #9A59
  11++4070              ; Corrupt:
  12++4070              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY, побочные эффекты загруженных модулей и TR-DOS
  13++4070              ; Note:
  14++4070              ;   банки 1, 3, 7, 4 и 6 получают карту, музыку, справку, D3D и язык соответственно
  15++4070              ;   из stscr выбирается один из 16 фонов по младшему полубайту R, чтение учитывает исходные физические сектора
  16++4070              ;   каждый обработчик рисования из таблицы #F0FD получает индекс элемента в операнд своей обёртки
  17++4070              ;   проверяются порты #1F, #FBDF и #FFDF с учётом сохранённых настроек, назначение остальных полей требует отдельного разбора
