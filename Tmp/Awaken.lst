   1++DB8C                              module Music
   2++DB8C                              module ReadEnvelopeSlide
   3++DB8C                              ; Документация [команда скольжения огибающей](../../Docs/MusicEnvelopeStaging.md)
   4++DB8C                              ; -----------------------------------------
   5++DB8C                              ; Чтение задержки и знакового слова шага, включение отложенного скольжения огибающей
   6++DB8C                              ; исходная запись 10, файловые смещения #008C..#009F
   7++DB8C                              ; In:
   8++DB8C                              ;   DE указывает на три доступных байта потока, задержка и младший, старший байты шага
   9++DB8C                              ;   HL, BC и AF не задают дополнительных аргументов, банк MUZ1 доступен для записи
  10++DB8C                              ; Out:
  11++DB8C                              ;   HL=слово шага, DE=входной DE+3, BC сохранён, A=06, F сохранён
  12++DB8C                              ;   альтернативные пары, IX, IY, I, IM и IFF сохранены, SP увеличен на два обычным RET
  13++DB8C                              ;   Delay получает первый байт, Step получает два следующих, SlideGate=06 включает отложенную команду
  14++DB8C                              ; Corrupt:
  15++DB8C                              ;   HL, DE, AF только A, Delay, Step, SlideGate, R и обычный адрес возврата со стека
  16++DB8C                              ; Note:
  17++DB8C                              ;   указатель DB8C физически записан в таблицах каналов A, B и C по DDCE, DDEE, DE0E
  18++DB8C                              ;   задержка и шаг копируются без нормализации, нулевые и отрицательные значения сохраняются
  19++DB8C                              ;   сам обработчик не меняет текущий SlideOffset, он применяет команду позже в StageEnvelopeAndNoise
  20++DB8C                              ; -----------------------------------------
  21++DB8C                              ; чтение байта задержки отложенного скольжения огибающей
  22++DB8C 1A           Entry:          LD A, (DE)
  23++DB8D 13                           INC DE
  24++DB8E                              ; сохранение задержки в изменяемом операнде Delay
  25++DB8E 32 74 DF                     LD (@MusicEnvelopeState.Delay), A
  26++DB91                              ; чтение младшего и старшего байтов шага с продвижением полного указателя потока
  27++DB91 EB                           EX DE, HL
  28++DB92 5E                           LD E, (HL)
  29++DB93 23                           INC HL
  30++DB94 56                           LD D, (HL)
  31++DB95 23                           INC HL
  32++DB96 EB                           EX DE, HL
  33++DB97                              ; сохранение слова шага в операнде PendingStep
  34++DB97 22 6E DF                     LD (@MusicEnvelopeState.Step), HL
  35++DB9A                              ; включение однократной команды, JR по SlideGate становится LD B,n той же длины
  36++DB9A 3E 06                        LD A, #06
  37++DB9C 32 6B DF                     LD (@MusicEnvelopeState.SlideGate), A
  38++DB9F C9                           RET
  39++DBA0
  40++DBA0                              endmodule
  41++DBA0                              endmodule
