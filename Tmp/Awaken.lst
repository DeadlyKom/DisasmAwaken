   4++C924              ; Подробный разбор [условие выбора, изменение C и возврат банка LANG](../../Docs/KeyChoice.md)
   5++C924              ; -----------------------------------------
   6++C924              ; Характеристика второго ключа при C=1 либо текущего ключа при остальных значениях
   7++C924              ; исходная запись 5, файловые смещения #0924..#0934
   8++C924              ; In:
   9++C924              ;   BC - C код выбора, 1 выбирает ключ #9844..#9848, остальные значения текущий ключ #983F..#9843
  10++C924              ;   LANG загружен в банк 6, он выбран в аппаратном порте и тени, bit5 порта снят
  11++C924              ;   стек находится вне сменяемого окна, выполняется договор банковых процедур характеристики
  12++C924              ; Out:
  13++C924              ;   HL, DE и AF содержат характеристику выбранного ключа по WorldSignature.md
  14++C924              ;   BC - B сохранён, C=(входной C-1) AND #FF, это изменение сохраняется после банковых вызовов
  15++C924              ;   HL', DE', BC', IX, IY, I и IFF сохранены, SP восстановлен относительно обычного CALL
  16++C924              ;   AF' содержит финальную страницу с банком 6 и ROM 1 и флаги её OR
  17++C924              ;   рабочий ключ изменяется, порт и его тень последовательно выбирают банки 1, 0 и 6
  18++C924              ; Corrupt:
  19++C924              ;   HL, DE, BC только C, AF, AF'
  20++C924              ; Note:
  21++C924              ;   C=0 превращается в #FF и выбирает текущий ключ, входной C не сохраняется
  22++C924              ;   других сравнений кода выбора нет, значения 2..255 также выбирают текущий ключ
  23++C924              ;   игровая роль второго ключа здесь не установлена, его формат подтверждён тремя загрузками
  24++C924              ;   основной AF результата не содержит флаги начального DEC C, его определяет выбранная характеристика
  25++C924              ; -----------------------------------------
  26++C924                              ; проверка выбора второго ключа вычетом единицы, C изменяется на всех путях
  27++C924 0D           Entry:          DEC C
  28++C925 C2 80 A4                     JP NZ, @Station.DescribeCurrentKeyForLang.Entry                 ; переход, если входной C отличался от 1, получить характеристику текущего ключа и вернуть банк 6
  29++C928
  30++C928                              ; чтение первого слова второго ключа из существующей области станции
