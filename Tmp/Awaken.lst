  20++7E53              ;   если 98AA не FF, байт 9906 увеличен на 30 по модулю 256, иначе сохранён
  21++7E53              ;   байты 983D и 983E переставлены, 512 байтов 983B..9A3A скопированы в 4000..41FF
  22++7E53              ;   256 байтов 7EC0..7FBF скопированы в 4200..42FF, HL=7FC0, DE=4300, BC=0
  23++7E53              ;   A равен исходному 983D, F сохраняет S,Z,C от проверки 98AA либо ADD счётчика, P/V=H=N=0
