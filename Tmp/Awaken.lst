  27++F143 0E 2F                        LD C, #2F
  28++F145 CD 88 F1                     CALL @Controls.DrawCounterNibble.Entry
  29++F148                              ; перестановка тетрад L для вывода старшей цифры той же пары
  30++F148 7D                           LD A, L
  31++F149 0F                           RRCA
  32++F14A 0F                           RRCA
  33++F14B 0F                           RRCA
