   1++DE1C                              module D3D
   2++DE1C                              module RasterizePreviewEdge
   3++DE1C                              ; Документация [формула точек, физические параметры, четыре ветви, режимы, точные регистры и проверка bitmap](../../Docs/PreviewEdgeRaster.md)
   4++DE1C                              ; -----------------------------------------
   5++DE1C                              ; Растровое ребро с исключённым концом, четырьмя ветвями, режимами XOR/OR/AND и точными флагами
   6++DE1C                              ; исходная запись 6, банк 4, файловые смещения #1E1C..#1F45
   7++DE1C                              ; In:
   8++DE1C                              ;   PreviewEdgeEndpoints.Value.StartPoint и EndPoint содержат слова, младший байт колонка, старший строка
   9++DE1C                              ;   PreviewEdgeMode.Value содержит согласованную пару A9/38 для XOR, B1/38 для OR либо A1/30 для AND
  10++DE1C                              ;   MaskOffset содержит B0 для XOR и OR, B8 для AND, исходные таблицы масок сохранены
  11++DE1C                              ;   PreviewLineTable.RowHigh, RowLow и Column подготовлены BuildSpriteLineTable в текущем банке 4
  12++DE1C                              ;   профиль требует попадания обоих концов и всех точек в bitmap 256 на 192 после добавления начала таблиц
  13++DE1C                              ;   CPU-стек не пересекает экран и изменяемый код, повторный вход в общий код opcode исключён
  14++DE1C                              ;   HL, DE, BC, AF не задают координаты, их входной контекст сохраняется только в указанных случаях раннего выхода
  15++DE1C                              ; Out:
  16++DE1C                              ;   для разных концов HL содержит адрес исключённого конца, DE содержит D=max(dx,dy), E=min(dx,dy), BC содержит B=0 и C маску конца
  17++DE1C                              ;   C является одноразрядной маской для XOR и OR либо её инверсией для AND
  18++DE1C                              ;   AF пологой ветви содержит A равный конечному экранному байту, F от последнего поворота маски, смены колонки либо строки
  19++DE1C                              ;   AF крутой ветви принадлежит расчёту последнего перехода строки, A не является возвращаемым пикселем
  20++DE1C                              ;   AF' содержит A'=floor(max(dx,dy)/2), F' точного последнего действия накопителя ошибки, маски либо колонки
  21++DE1C                              ;   полные формулы AF и AF' приведены в registers, row_context, column_context независимой модели
  22++DE1C                              ;   HL', DE', BC', IX, IY, I, IFF и IM сохраняются, SP после RET равен входному+2, CPU-стек не записывается
  23++DE1C                              ;   при совпавших словах концов HL=0, DE равен слову конца, BC, A и весь альтернативный набор сохранены, F=42
  24++DE1C                              ;   при непустом ребре меняются два opcode выбранной ветви и экранные байты, при совпавших концах записей нет
  25++DE1C                              ; Corrupt:
  26++DE1C                              ;   HL, DE, BC, AF, AF', два opcode выбранной ветви, затронутые экранные байты
  27++DE1C                              ; Note:
  28++DE1C                              ;   при разных строках начало выбирается по меньшей строке, при равных строках исходный порядок концов сохраняется
  29++DE1C                              ;   начальная точка включена, конечная исключена, равенство dx и dy выбирает пологую ветвь
  30++DE1C                              ;   пологая ветвь накапливает несколько пикселей байта в A и может повторно записывать неизменённый соседний байт
  31++DE1C                              ;   AND использует инверсную маску и заменяет исходный JR C на JR NC, оба изменяемых байта необходимы
  32++DE1C                              ;   не выровненное горизонтальное начало таблиц округляется вниз до байтовой колонки, остаток не добавляется в маску
  33++DE1C                              ;   сам код отсечения не выполняет, внеэкранные таблицы и неподготовленные opcode не входят в проверенный профиль
  34++DE1C                              ;   проверка включает настоящую подготовку таблиц, весь bitmap и точные основные и альтернативные AF, не аппаратные IRQ
