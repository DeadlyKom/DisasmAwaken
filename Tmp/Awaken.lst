   5++C26D              ; -----------------------------------------
   6++C26D              ; Чтение количества рынка либо точечного свойства c, s, m
   7++C26D              ; исходная запись 5, файловые смещения #026D..#0288
   8++C26D              ; In:
   9++C26D              ;   ScriptSelection.CargoRow и CargoBase доступны, IX у необязательного индекса либо точки
  10++C26D              ;   для обычного возврата суффикс отсутствует либо равен c, s, m, таблицы и код LANG доступны
  11++C26D              ;   HL и DE не содержат входных данных, действует договор ParseFieldSuffix и выбранного обработчика
  12++C26D              ; Out:
  13++C26D              ;   без суффикса HL=(#9555+2*индекс) AND #FFFF, DE=A количество AND #7F
  14++C26D              ;   без суффикса BC - B=0, C=(CargoRow+CargoBase) AND #FF, F от AND #7F
  15++C26D              ;   суффикс c возвращает DE текущую цену, s возвращает DE=1 при снятом bit7, иначе 0
  16++C26D              ;   суффикс m возвращает DE байтовую взвешенную сумму, его точный договор GetIndexedLoad
  17++C26D              ;   явный индекс равен (число-1) AND #FFFF, без числа индекс равен исходному C
  18++C26D              ;   суффиксные обработчики используют только младший байт индекса, прямое чтение количества полное слово
  19++C26D              ;   IX - первый непрочитанный символ, IY, I и IFF сохранены, SP при обычном возврате увеличен на 2
  20++C26D              ;   B'=3, C', DE', HL' сохранены, AF' изменяется только на пути взвешенной суммы
  21++C26D              ;   FieldSuffixState.DefaultTarget содержит ReadStock
  22++C26D              ; Corrupt:
  23++C26D              ;   HL, DE, BC, AF, BC' только B, AF' на пути m, IX
  24++C26D              ; Note:
  25++C26D              ;   ReadStock является отдельным внутренним входом с HL индексом, он не снимает слово индекса со стека
  26++C26D              ;   числовой индекс 0 без суффикса читает #9553, с суффиксом c читает #9754 из-за обрезания индекса до #FF
  27++C26D              ;   при неизвестном суффиксе DispatchToken передаёт управление SkipLine, обычного результата нет
  28++C26D              ;   полный контракт каждого результата и границы логического массива приведены в MarketField.md
  29++C26D              ; -----------------------------------------
