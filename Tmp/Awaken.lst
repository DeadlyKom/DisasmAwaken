  15++C9B9              ;   AF - A=max((((FirstWord.high XOR FirstWord.low XOR SecondWord.high XOR SecondWord.low) AND 7)-1),0)
  16++C9B9              ;   если XOR AND 7 равен 0, F=#44, если 1, F=#42, иначе F=#02, Z означает A=0
  17++C9B9              ;   рабочий FSignatureKey по #631C содержит состояние после Variant+1 шагов
