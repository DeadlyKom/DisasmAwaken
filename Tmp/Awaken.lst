   5++C0DB              ; -----------------------------------------
   6++C0DB              ; Запись байтовой взвешенной суммы в поле загрузки и продолжение сценария
   7++C0DB              ; исходная запись 5, файловые смещения #00DB..#00E6
   8++C0DB              ; In:
   9++C0DB              ;   HL - индекс для ComputeWeightedLoad, при обычном выборе команды T содержит адрес обработчика C0DB
  10++C0DB              ;   доступны таблицы и изменяемые операнды по договору ComputeWeightedLoad, LANG выбран
  11++C0DB              ; Out:
  12++C0DB              ;   хвостовой вход NextCommand, байт по 9850 получает вычисленный A
  13++C0DB              ;   HL, DE, BC, AF, AF альтернативного набора и три изменённых операнда по ComputeWeightedLoad
  14++C0DB              ;   HL, DE и BC альтернативного набора, IX, IY, I и IFF сохранены, SP перед NextCommand равен входному
  15++C0DB              ; Corrupt:
  16++C0DB              ;   HL, DE, BC, AF, AF'
  17++C0DB              ; Note:
  18++C0DB              ;   начальный LD DE,67AE не задаёт таблицу, ComputeWeightedLoad заменяет DE до первого использования
  19++C0DB              ;   команда не загружает индекс из текущего выбора, использует исходный полный HL
  20++C0DB              ;   нормальный диспетчер передаёт HL=C0DB, выбранный адрес 9852+2*C0DB равен 1A08 по модулю 65536
  21++C0DB              ;   1A08 не совпадает с 30 строками 9852..988C, поэтому обычная команда не добавляет единицу ни одной строке
  22++C0DB              ;   при прямом входе с иным HL прибавление выбранной строки остаётся действующим
  23++C0DB              ;   сумма байтовая с оборачиванием, игровые единицы трёх таблиц полностью не доказаны
  24++C0DB              ; -----------------------------------------
  25++C0DB                              ; загрузка исходного DE, который вызываемый ComputeWeightedLoad перезаписывает до использования
  26++C0DB 11 AE 67     Entry:          LD DE, #67AE
  27++C0DE                              ; расчёт взвешенной суммы по входному HL, обычный диспетчер оставляет здесь адрес команды
  28++C0DE CD 6F C8                     CALL @Text.ComputeWeightedLoad.Entry
  29++C0E1                              ; сохранение байтовой суммы, переносы выше восьмого разряда не сохраняются
  30++C0E1 32 50 98                     LD (#9850), A
  31++C0E4 C3 0C C0                     JP @Text.NextCommand.Entry
