   5++C642              ; -----------------------------------------
   6++C642              ; Создание указателя писателя слова по #984E
   7++C642              ; исходная запись 5, файловые смещения #0642..#0656
   8++C642              ; In:
   9++C642              ;   Entry принимает HL' следующую позицию стека выражений, доступны два байта записи
  10++C642              ;   для Invoke на CPU-стеке FFieldInvokeFrame, Operator адрес операции, AfterStore адрес продолжения
  11++C642              ;   Invoke принимает BC правый операнд, поле #984E доступно для чтения и записи
  12++C642              ;   оператор получает DE текущее значение, BC правый операнд, возвращает DE через RET с банком LANG 6
  13++C642              ;   Store можно вызвать отдельно с DE результатом и обычным адресом возврата
  14++C642              ; Out:
  15++C642              ;   Entry сохраняет HL, BC и AF, DE адрес Invoke, добавленный в стек выражений
  16++C642              ;   Entry увеличивает HL' на два, DE' становится адресом Invoke, BC', AF', IX, IY, I и IFF сохранены
  17++C642              ;   Invoke заменяет Operator в FFieldInvokeFrame адресом Store, образуя FFieldOperatorFrame, и входит в оператор через JP (HL)
  18++C642              ;   после Invoke и Store поле получает полное DE
  19++C642              ;   регистры после Invoke определяются оператором и Store, Store регистры не меняет
  20++C642              ;   SP после Entry либо отдельного Store равен входному SP+2, после полного Invoke равен входному SP+4
  21++C642              ; Corrupt:
  22++C642              ;   Entry - DE, HL', DE'
  23++C642              ;   Invoke - HL, DE и регистры по договору выбранного оператора
  24++C642              ;   Store - нет
  25++C642              ; Note:
  26++C642              ;   Entry не записывает целевое поле и не исполняет операцию, только добавляет статический указатель
  27++C642              ;   Invoke загружает текущее поле, а не значение на момент создания указателя, код писателя не генерируется заново
  28++C642              ;   байтовые Invoke читают слово, но обнуляют H, соседний байт поля не является частью операнда
  29++C642              ;   игровые единицы поля не выводятся из этой операции записи
  30++C642              ; -----------------------------------------
  31++C642                              ; выбор статического входа Invoke как значения писателя поля
  32++C642 11 48 C6     Entry:          LD DE, @Text.PushWordFieldWriter.Invoke
  33++C645                              ; добавление адреса Invoke в стек выражений без выполнения записи поля
  34++C645 C3 B9 C1                     JP @Text.PushExpressionWord.Entry
  35++C648
  36++C648                              ; снятие адреса оператора из FFieldInvokeFrame в DE
  37++C648 D1           Invoke:         POP DE
  38++C649                              ; выбор Store как возврата оператора
  39++C649 21 52 C6                     LD HL, @Text.PushWordFieldWriter.Store
  40++C64C                              ; замена слова Operator адресом Store, остальная рамка сохраняется
  41++C64C E5                           PUSH HL
  42++C64D                              ; чтение текущего значения целевого поля в HL перед обменом с адресом оператора
