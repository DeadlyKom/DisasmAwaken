  10++AE55              ; Out:
  11++AE55              ;   BC - B высота окна, C=(прежний CursorY+8) по модулю 256
  12++AE55              ;   при C<Height CursorY=C, CursorX=0, AF=#0044, иначе курсор сохранён, A=C и Carry установлен
  13++AE55              ;   при отказе F имеет S, Z и PV от CP(C,Height), биты 5 и 3 от C, Carry=1, H=N=0
  14++AE55              ; Corrupt:
  15++AE55              ;   BC, AF
  16++AE55              ; Note:
  17++AE55              ;   переполнение Y+8 не проверяется, например 250 переходит в 2 до сравнения высоты
  18++AE55              ;   HL, DE, альтернативные и индексные регистры, I и IFF сохраняются, SP восстанавливается
