  16++C3C5              ;   с точкой BC - B старший байт слова выбора, C=(младший_байт_выбора-1) AND #FF
  17++C3C5              ;   HL', DE' сохранены, BC' - B'=2, C' сохранён, AF' меняется при банковом запросе поля
  18++C3C5              ;   IX первый непрочитанный символ, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  19++C3C5              ; Corrupt:
  20++C3C5              ;   HL, DE, BC, AF, BC' только B, AF' на пути свойства, IX
  21++C3C5              ; Note:
  22++C3C5              ;   группа p/g возвращает Fingerprint, Region
  23++C3C5              ;   младший байт выбора 1 выбирает второй ключ, остальные текущий, значит явное число 2 выбирает второй
  24++C3C5              ;   путь без точки возвращает адрес таблицы в DE, а не числовую характеристику, исходный RET сохранён
  25++C3C5              ;   при неизвестном символе FindToken передаёт управление SkipLine без обычного результата
  26++C3C5              ;   игровые единицы параметров и роль второго ключа здесь не предполагаются
  27++C3C5              ; -----------------------------------------
  28++C3C5                              ; установка числа 2 свойств выбранной группы в альтернативном B
  29++C3C5 D9           Entry:          EXX
  30++C3C6 06 02                        LD B, #02
  31++C3C8 D9                           EXX
  32++C3C9                              ; выбор кода 1 по умолчанию, второй ключ
  33++C3C9 0E 01                        LD C, #01
  34++C3CB                              ; выбор адреса за одной записью до группы p/g
  35++C3CB 11 2E CA                     LD DE, #CA2E
