  43++A794 23                           INC HL
  44++A795 7E                           LD A, (HL)
  45++A796 23                           INC HL
  46++A797 66                           LD H, (HL)
  47++A798 6F                           LD L, A
  48++A799                              ; сохранение индекса для удаления после поиска адреса Flags
  49++A799 E5                           PUSH HL
