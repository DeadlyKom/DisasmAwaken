  15++4200              ;   затем банк 0 выбран через SelectRamBank, прямой OUT 18 включает теневой экран
  16++4200              ;   перед TR-DOS аппаратная страница 18, CurrentPage=10, нулевой байт записан только по 5000
  17++4200              ;   перед CALL TrDos.Dispatch A=0, BC=000E, HL=4251, DE=5CE6, IY=5C3A, 5CF9=0
