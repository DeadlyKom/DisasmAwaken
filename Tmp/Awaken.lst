  40++DFC6 3E 38                        LD A, @MapArcConst.TestSetBit
  41++DFC8 38 02                        JR C, @Map.DrawClippedMapArc.StoreTailMode                      ; переход, если бит 0 параметра установлен, записать четыре кода JR C
