  72++C4C4 5F                           LD E, A
  73++C4C5 38 04                        JR C, @Map.BuildMapScreenTables.NextRow                         ; переход, если добавление 20 переполнило E, высокий адрес уже перешёл в следующую треть
  74++C4C7
  75++C4C7                              ; возврат старшей части адреса после перехода строки без переноса младшего байта
  76++C4C7 7A                           LD A, D
  77++C4C8 D6 08                        SUB #08
