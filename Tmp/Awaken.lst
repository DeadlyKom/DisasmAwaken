# file opened: Source/D3D/DispatchPreviewClipSegment.asm
   1++EAB6                              module D3D
   2++EAB6                              module DispatchPreviewClipSegment
   3++EAB6                              ; Документация [перестановка двух полных записей, точный вход обработчика и общий эпилог CP 4](../../Docs/PreviewClipSegment.md)
   4++EAB6                              ; -----------------------------------------
   5++EAB6                              ; Перестановка внутреннего первого конца и табличное отсечение отдельного сегмента
   6++EAB6                              ; исходная запись 6, банк 4, файловые смещения #2AB6..#2B0F
   7++EAB6                              ; In:
   8++EAB6                              ;   HL, DE, BC и AF произвольный исходный контекст, параметры читаются из PreviewClipFirst и PreviewClipSecond
   9++EAB6                              ;   HL', DE', BC' сохраняются, AF' и IX рабочий контекст арифметики, IY сохраняется
  10++EAB6                              ;   два физических конца содержат слова координат и согласованные полные коды сторон
  11++EAB6                              ;   D3D подключён в банке 4, E011 настроил операнды границ, страницы CC/CD содержат исходные цели
  12++EAB6                              ;   под CPU-SP доступны байты трёх подставных возвратов и вложенных вызовов, обычный адрес возврата доступен
  13++EAB6                              ;   все фактически исполненные деления имеют ненулевой знаменатель и допустимое слово частного
  14++EAB6                              ; Out:
  15++EAB6                              ;   HL и BC обычного выхода равны контексту последнего действия обработчика, DE=Return, A=ByteCount, F от CP 4
  16++EAB6                              ;   специальный выход даёт HL=EBF2, DE рабочий, BC=00EA, AF=EBA9, A=EB не является размером
  17++EAB6                              ;   HL', DE', BC' сохранены, AF' и IX определяются исполненным путём, IY сохранён
  18++EAB6                              ;   при полном коде первого конца F0 две пятибайтовые записи меняются местами, иначе остаются на своих местах
  19++EAB6                              ;   BlockCode=1, ByteCount содержит размер результата 0, 2 или 4 в проверенной геометрической области
  20++EAB6                              ;   младшая тетрада SeenFlags может получать отметки углов, старшая сохраняется, выбранные кэши обновляются
  21++EAB6                              ;   SP после окончательного возврата равен входному+2, I, IFF и IM сохраняются
  22++EAB6                              ; Corrupt:
  23++EAB6                              ;   HL, DE, BC, AF, AF', IX по выбранному пути, оба конца при обмене, BlockCode, SeenFlags, ByteCount, кэши, страница C8 и CPU-стек
  24++EAB6                              ; Note:
  25++EAB6                              ;   непосредственно перед JP HL равен цели, DE=EB08, BC имеет входной C, B равен F0 при обмене либо входному B
  26++EAB6                              ;   входной AF обработчика содержит A=индекс таблицы, F=88 от INC H страницы CC в CD
  27++EAB6                              ;   индекс равен ((NOT код первого) AND F0) OR (код второго AND 0F) после возможной перестановки
  28++EAB6                              ;   три слова EB08 расположены под входным SP, обычный эпилог снимает два оставшихся слова, специальный снимает все три
  29++EAB6                              ;   CP 4 устанавливает Z только для двух точек, Carry устанавливается для размера 0 или 2
  30++EAB6                              ;   два внутренних конца дают одну выходную точку, размер 2 и Carry=1, полноценным отрезком такой результат не считается
  31++EAB6                              ;   состояние SeenFlags перед обработчиком сохраняется, оно здесь не обнуляется
  32++EAB6                              ;   префикс проверен в 20736 контекстах, геометрия в 534160 случаях, все конечные регистры всех путей не заявлены
  33++EAB6                              ; -----------------------------------------
  34++EAB6                              ; установка ненулевого режима, отдельные угловые точки сегменту не добавляются
  35++EAB6 3E 01        Entry:          LD A, @PreviewClipDispatchConst.BlockCorners
  36++EAB8 32 50 C2                     LD (@PreviewClipCorners.Value.BlockCode), A
  37++EABB                              ; проверка полного кода первого конца на точное внутреннее значение F0
  38++EABB 3A 30 C2                     LD A, (@PreviewClipFirst.Value.Outcode)
  39++EABE FE F0                        CP @PreviewClipDispatchConst.InsideCode
  40++EAC0 20 27                        JR NZ, @D3D.DispatchPreviewClipSegment.PickCase                 ; переход, если полный код первого конца не равен F0, сохранить порядок концов
  41++EAC2
  42++EAC2                              ; -----------------------------------------
  43++EAC2                              ; Обмен двух полных пятибайтовых записей
  44++EAC2                              ; -----------------------------------------
  45++EAC2                              ; сохранение внутреннего кода и перестановка кодов сторон
  46++EAC2 47                           LD B, A
  47++EAC3 3A 40 C2                     LD A, (@PreviewClipSecond.Value.Outcode)
  48++EAC6 32 30 C2                     LD (@PreviewClipFirst.Value.Outcode), A
  49++EAC9 78                           LD A, B
  50++EACA 32 40 C2                     LD (@PreviewClipSecond.Value.Outcode), A
  51++EACD                              ; обмен координатными словами колонок, флаги сравнения сохраняются
