  31++DB08 11 00 00                     LD DE, #0000
  32++DB0B AF                           XOR A
  33++DB0C 32 20 63                     LD (@TextWindow.CursorX), A
  34++DB0F DD 21 7C DB                  LD IX, @HelpLineCache.Line0000
  35++DB13                              ; запись рабочего адреса текущей строки в физическую двухбайтовую запись
  36++DB13 DD 75 00     StoreLine:      LD (IX+#00), L
  37++DB16 DD 74 01                     LD (IX+#01), H
  38++DB19 DD 23                        INC IX
  39++DB1B DD 23                        INC IX
