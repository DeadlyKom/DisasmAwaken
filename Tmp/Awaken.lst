  10++A9F3              ;   BC - сохраняемый контекст, повторный вход с изменением того же ключа отсутствует
  11++A9F3              ; Out:
  12++A9F3              ;   HL - прежнее SecondWord, DE новое смешанное SecondWord, BC сохранён
  13++A9F3              ;   AF - A XOR четырёх байтов обновлённого ключа, F от последнего XOR L
  14++A9F3              ;   FirstWord заменено прежним SecondWord, SecondWord обновлено по формуле WorldSignature.md
  15++A9F3              ;   альтернативные и индексные регистры, I и IFF сохранены, SP восстановлен
  16++A9F3              ; Corrupt:
  17++A9F3              ;   HL, DE, AF
  18++A9F3              ; Note:
  19++A9F3              ;   обмен слов не использует EXX, альтернативные пары не являются рабочим состоянием
  20++A9F3              ;   сложение FirstWord+#0101 оборачивается до прибавления SecondWord, лишний перенос этого первого шага теряется
  21++A9F3              ;   в ADC A,L участвует перенос последнего ADD HL,DE, перенос последующего ADD HL,BC в XOR не используется
  22++A9F3              ;   состояние #631C является повторным использованием существующей памяти загрузчика, новая память не выделяется
  23++A9F3              ;   период и статистическое качество шага не доказаны
  24++A9F3              ; -----------------------------------------
  25++A9F3                              ; сохранение BC, временная пара станет смешанной перестановкой байтов
  26++A9F3 C5           Entry:          PUSH BC
  27++A9F4                              ; чтение двух исходных слов рабочего FSignatureKey
  28++A9F4 2A 1C 63                     LD HL, (@SignatureState.WorkKey + FSignatureKey.FirstWord)
  29++A9F7 ED 5B 1E 63                  LD DE, (@SignatureState.WorkKey + FSignatureKey.SecondWord)
  30++A9FB                              ; перестановка байтов FirstWord во временный BC
  31++A9FB 4C                           LD C, H
  32++A9FC 45                           LD B, L
  33++A9FD                              ; расчёт FirstWord+#0101 по модулю 65536
  34++A9FD 23                           INC HL
  35++A9FE 24                           INC H
  36++A9FF                              ; расчёт суммы с SecondWord, этот перенос участвует в следующем ADC
  37++A9FF 19                           ADD HL, DE
  38++AA00                              ; расчёт нового младшего смешивающего байта из SecondWord.low и младшей суммы
  39++AA00 7B                           LD A, E
  40++AA01 8D                           ADC A, L
  41++AA02                              ; обновление C смешивающим байтом при сохранении B=FirstWord.low
  42++AA02 4F                           LD C, A
  43++AA03                              ; расчёт второй шестнадцатибитной суммы с переставленным старшим байтом
  44++AA03 09                           ADD HL, BC
  45++AA04                              ; расчёт нового SecondWord.low через XOR суммы, C и #75
  46++AA04 7D                           LD A, L
  47++AA05 A9                           XOR C
  48++AA06 EE 75                        XOR #75
  49++AA08                              ; передача прежнего SecondWord.low в новое FirstWord.low
  50++AA08 6B                           LD L, E
  51++AA09 5F                           LD E, A
  52++AA0A                              ; расчёт нового SecondWord.high через XOR старшей суммы, FirstWord.low и #A7
  53++AA0A 7C                           LD A, H
  54++AA0B A8                           XOR B
  55++AA0C EE A7                        XOR #A7
  56++AA0E                              ; передача прежнего SecondWord.high в новое FirstWord.high
  57++AA0E 62                           LD H, D
  58++AA0F 57                           LD D, A
  59++AA10                              ; обновление двух физических слов рабочего ключа
  60++AA10 22 1C 63                     LD (@SignatureState.WorkKey + FSignatureKey.FirstWord), HL
  61++AA13 ED 53 1E 63                  LD (@SignatureState.WorkKey + FSignatureKey.SecondWord), DE
  62++AA17                              ; расчёт возвращаемой XOR-свёртки четырёх обновлённых байтов
  63++AA17 7A                           LD A, D
  64++AA18 AB                           XOR E
  65++AA19 AC                           XOR H
  66++AA1A AD                           XOR L
  67++AA1B C1                           POP BC
  68++AA1C C9                           RET
