   8++E299              ; In:
   9++E299              ;   MapArcState.OffsetY, OffsetX, ReferenceX и StartY содержат текущие рабочие байты
  10++E299              ; Out:
  11++E299              ;   HL, DE сохранены, BC=OffsetX*256+OffsetY
  12++E299              ;   AF - A=StartY, F соответствует NEG от (ReferenceX+OffsetX)&255
  13++E299              ;   C'=(-(ReferenceX+OffsetX))&255, E'=StartY
  14++E299              ;   HL', D', B', AF', IX, IY, I и IFF сохранены
  15++E299              ;   входные поля не меняются, SP обычного возврата равен входному SP+2
  16++E299              ; Corrupt:
  17++E299              ;   BC, AF, C', E'
  18++E299              ; Note:
  19++E299              ;   первое ADD оборачивает сумму до NEG, флаги NEG сохраняются при последующем чтении StartY
  20++E299              ;   StartY далее участвует в рекурсии растрового ядра, его геометрическое вычисление вызывающим кодом ещё разбирается
  21++E299              ; -----------------------------------------
  22++E299                              ; загрузка двух рабочих смещений без изменения основных HL и DE
  23++E299 ED 4B AF DF  Entry:          LD BC, (@MapArcState.OffsetY)
