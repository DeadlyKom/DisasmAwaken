   1++D8E2                              module Map
   2++D8E2                              module ComputeTopClipProduct
   3++D8E2              ; Документация [Map](../../Docs/FunctionDetails/Map.md)
   4++D8E2              ; Подробный разбор [точный порядок множителей, 32-битная запись и унаследованный случай 8000](../../Docs/ClipProducts.md)
   5++D8E2              ; -----------------------------------------
   6++D8E2              ; Произведение (Y1-MinY)*(X1-X2) для верхней границы окна
   7++D8E2              ; исходная запись 7, файловые смещения #18E2..#1900
   8++D8E2              ; In:
   9++D8E2              ;   MinX, MinY, MaxX, MaxY обозначают изменяемые слова границ, исходно 0, 0, 255, 255
  10++D8E2              ;   D0C3 записывает четыре байтовых параметра как слова с нулевым старшим байтом
  11++D8E2              ;   MapClipWork.FirstPoint и SecondPoint содержат два знаковых 16-битных X,Y, ClipCodes не читается
  12++D8E2              ;   MapClipWork.TopProduct доступен для записи, KARTA выбран, действуют требования MultiplySigned16
  13++D8E2              ;   входные основные регистры не передают дополнительных аргументов
  14++D8E2              ; Out:
  15++D8E2              ;   перед умножением HL=(Y1-MinY) modulo 65536, DE=(X1-X2) modulo 65536
  16++D8E2              ;   HL возвращает старшее слово, DE младшее слово результата MultiplySigned16 с исходным особым случаем
  17++D8E2              ;   MapClipWork.TopProduct.LowWord получает DE, HighWord получает HL, порядок четырёх байтов младший вперёд
  18++D8E2              ;   BC, AF и IX соответствуют MultiplySigned16 для указанных операндов и исходного BC последнего вычитания
  19++D8E2              ;   для TopProduct исходный BC умножения равен MinY, для BottomProduct MaxY, для LeftProduct и RightProduct равен Y2
  20++D8E2              ;   все альтернативные регистры, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  21++D8E2              ;   исходные точки, ClipCodes и три других произведения не меняются
  22++D8E2              ; Corrupt:
  23++D8E2              ;   HL, DE, BC, AF, IX по MultiplySigned16
  24++D8E2              ; Note:
  25++D8E2              ;   настройка и проверенные фазы описаны в [MapRuntimeProfiles](../../Docs/MapRuntimeProfiles.md)
  26++D8E2              ;   обе разности оборачиваются до 16 бит перед знаковым умножением, широкий знаковый промежуточный результат вычитания не сохраняется
  27++D8E2              ;   порядок HL и DE существенен, второе DE=8000 и abs(HL)>=256 наследует особенность полного ядра
  28++D8E2              ;   формула заголовка описывает обычный случай, для исключения берётся фактический договор MultiplySigned16
  29++D8E2              ;   нулевые исходные экземпляры лежат в ячейках разнесённой таблицы, которые не выбираются допустимыми кодами
  30++D8E2              ;   это подготовка числителя пересечения, точный последующий договор деления и игровое отсечение описываются отдельно
  31++D8E2              ; -----------------------------------------
  32++D8E2                              ; подготовка первого вычитания для исходного порядка двух множителей
  33++D8E2 ED 4B 34 DE  Entry:          LD BC, (@MapClipWork.SecondPoint.X)
  34++D8E6 2A 2F DE                     LD HL, (@MapClipWork.FirstPoint.X)
  35++D8E9                              ; очистка Carry перед первым полным 16-битным вычитанием
  36++D8E9 B7                           OR A
  37++D8EA ED 42                        SBC HL, BC
  38++D8EC                              ; перенос первой разности во второй операнд DE умножения
  39++D8EC EB                           EX DE, HL
  40++D8ED                              ; подготовка второго вычитания для первого операнда HL
  41++D8ED 01 00 00                     LD BC, @MapClipConst.MinCoordinate
  42++D8F0 2A 31 DE                     LD HL, (@MapClipWork.FirstPoint.Y)
  43++D8F3 B7                           OR A
  44++D8F4 ED 42                        SBC HL, BC
  45++D8F6                              ; вычисление знакового 32-битного результата настоящим MultiplySigned16
  46++D8F6 CD 63 DB                     CALL @Map.MultiplySigned16.Entry
  47++D8F9                              ; сохранение младшего слова перед старшим в физическом FClipProduct
  48++D8F9 ED 53 6B DE                  LD (@MapClipWork.TopProduct.LowWord), DE
  49++D8FD 22 6D DE                     LD (@MapClipWork.TopProduct.HighWord), HL
  50++D900 C9                           RET
  51++D901
  52++D901                              endmodule
  53++D901                              endmodule
