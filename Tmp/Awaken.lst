   6++D2EE              ; Рисование отрезка Брезенхэма в режимах Clear, Set и Xor без последнего конца
   7++D2EE              ; исходная запись 7, файловые смещения #12EE..#1417
   8++D2EE              ; In:
   9++D2EE              ;   MapLineWork.Start и Finish содержат два байтовых X,Y, KARTA выбран
  10++D2EE              ;   MapScreenTables построены, реальные экранные координаты обоих концов и всех промежуточных точек лежат в bitmap
  11++D2EE              ;   Mode=ClearMode и MaskOffset=ClearMaskLow либо Mode=SetMode/XorMode и MaskOffset=SetMaskLow
  12++D2EE              ;   тело рисователя и соответствующие два байта выбранного ядра доступны для самомодификации
  13++D2EE              ; Out:
  14++D2EE              ;   при разных концах концы упорядочиваются по возрастанию Y, при равных Y порядок не меняется
  15++D2EE              ;   ровно M=max(abs(dx),dy) пикселей обработаны, начальный включён, последний после упорядочивания исключён
  16++D2EE              ;   HL - адрес исключённого конца, DE - D=M, E=min(abs(dx),dy), BC - B=0, C фазовая маска исключённого конца
  17++D2EE              ;   A'=floor(M/2), основные AF и альтернативный F' рабочие, выходной признак результата ими не задаётся
  18++D2EE              ;   при равных концах HL=0, DE содержит Finish как Y*256+X, BC и AF' сохранены, A входной, F=42
  19++D2EE              ;   HL', DE', BC', IX, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  20++D2EE              ;   исходные точки и Mode не меняются, при непустом отрезке записаны только PixelOpcode и ByteCrossOpcode выбранного ядра
  21++D2EE              ; Corrupt:
  22++D2EE              ;   HL, DE, BC, AF, AF' только при непустом отрезке
  23++D2EE              ; Note:
  24++D2EE              ;   ошибка изначально floor(M/2), после каждого пикселя вычитается малый шаг, заём исправляется добавлением M
  25++D2EE              ;   при abs(dx)=dy выбирается горизонтальное ядро, при M=0 ранний RET предотвращает цикл DJNZ с B=0
  26++D2EE              ;   таблицы не проверяются и дополнительного отсечения нет, нарушение экранных ограничений может затронуть другие области
