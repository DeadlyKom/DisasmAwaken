  26++DB5A C1                           POP BC
  27++DB5B                              ; снятие третьего слова как базы возвращаемого HL
  28++DB5B E1                           POP HL
  29++DB5C 48                           LD C, B
  30++DB5D                              ; расчёт байтового смещения из старшего байта второго снятого слова
  31++DB5D 0D                           DEC C
  32++DB5E 06 00                        LD B, #00
