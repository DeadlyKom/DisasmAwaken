   6++C626              ; Заполнение прямоугольника знакомест нулевыми или единичными пикселями без отсечения
   7++C626              ; исходная запись 4, файловые смещения #6626..#66AF
   8++C626              ; In:
   9++C626              ;   DE - D высота в знакоместах 1..24, E ширина в байтах 1..32, BC - B строка 0..23, C колонка 0..31
  10++C626              ;   B+D не больше 24, C+E не больше 32, таблицы #82..#84 подготовлены загрузчиком
  11++C626              ;   StationRaster.FillMode - бит 0, ноль выбирает #FF, единица выбирает #00, биты 7..1 не используются этим входом
  12++C626              ; Out:
  13++C626              ;   HL сохранён, DE - D равен нулю, E сохранён, BC сохранён
  14++C626              ;   AF - если B+D исходных параметров кратно восьми, A равен исходному C и F=#43, иначе A старший байт адреса следующей строки знакомест и F=#42
  15++C626              ;   прямоугольник записан в bitmap #4000..#57FF, атрибуты не изменены
  16++C626              ; Corrupt:
  17++C626              ;   DE, AF
  18++C626              ; Note:
  19++C626              ;   каждое знакоместо состоит из восьми пиксельных строк, ширина задаётся пропуском 2*(32-E) байтов развёрнутого блока
  20++C626              ;   в отличие от PrepareFrameRaster индексы здесь умножаются на восемь через SLA с отбрасыванием старших битов
  21++C626              ;   RectangleByte и RectangleSkip меняются на каждом входе, функция не реентерабельна
  22++C626              ;   все альтернативные и индексные регистры, I и IFF сохраняются, SP восстанавливается
  23++C626              ;   отсечения нет, нулевая ширина или высота и выход за экран не входят в подтверждённый контракт
