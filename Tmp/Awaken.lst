   5++C199              ; -----------------------------------------
   6++C199              ; Выбор первичной записи по индексу банка 4 либо коду FF
   7++C199              ; исходная запись 5, файловые смещения #0199..#01A6
   8++C199              ; In:
   9++C199              ;   A' - режим, 0 выбирает FF, любое ненулевое значение индекс SumBank4Index
  10++C199              ;   действует договор SumBank4Index с доступным банком 4 и возвратом LANG 6
  11++C199              ; Out:
  12++C199              ;   HL, DE сохранены, BC - B=0, C сумма компонентов банка 4 по модулю 256
  13++C199              ;   AF - A записан в #9849, он равен C при ненулевом режиме либо FF при нуле
  14++C199              ;   F от OR режима, Z показывает нулевой режим, а не нулевой записанный индекс
  15++C199              ;   AF' содержит финальную страницу и F банкового OR, HL', DE', BC', IX, IY, I и IFF сохранены
  16++C199              ;   SP обычного возврата равен входному SP+2, переключения банков выполняются даже при нулевом режиме
  17++C199              ; Corrupt:
  18++C199              ;   BC, AF, AF'
  19++C199              ; Note:
  20++C199              ;   байт выбора FF может также получиться из ненулевого режима и суммы FF, отдельного насыщения нет
  21++C199              ;   команда числовой аргумент не читает, IX сохраняется
