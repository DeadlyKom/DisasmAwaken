  13++E85D                              ;   BC=(high(SecondWord)-1) AND FF, старший B нулевой
  14++E85D                              ;   AF - A=high(FirstWord), Carry=1, S/Z/PV от DEC high(SecondWord), H=N=0, биты 5 и 3 из A
