  25++E021                              ;   FirstMode=1 пропускает первый знак, все остальные байты режима допускают его, ThirdGate=0 допускает третий после проверки второго
  26++E021                              ;   точный маркер отсутствия второго равен OR всех трёх его байтов с результатом 80, это не отдельная проверка SignSource=80
