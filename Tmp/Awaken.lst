   1++DBD9                              module D3D
   2++DBD9                              module ConfigurePreviewProjectionScale
   3++DBD9                              ; Документация [масштаб перспективы](../../Docs/PreviewProjectionScale.md)
   4++DBD9                              ; -----------------------------------------
   5++DBD9                              ; Настройка трёх последовательностей масштаба проекции по показателю заголовка модели
   6++DBD9                              ; исходная запись 6, банк 4, файловые смещения #1BD9..#1BE8
   7++DBD9                              ; In:
   8++DBD9                              ;   HL - адрес второго байта заголовка выбранной модели, младшие семь битов содержат показатель b
   9++DBD9                              ;   DE, BC, AF - входной контекст, младший C сохраняется
  10++DBD9                              ;   банк 4 доступен для записи, для безопасного исполнения потребителей b должен находиться в 1..6
  11++DBD9                              ;   SP указывает на обычный адрес возврата, повторный вход с изменением тех же операндов исключён
  12++DBD9                              ; Out:
  13++DBD9                              ;   HL и DE сохранены, B содержит исходный байт заголовка без бита 7, C сохранён
  14++DBD9                              ;   AF - A=(6-b) по модулю 256, F точного SUB 6,b
  15++DBD9                              ;   DepthSkip, FirstAxisSkip и SecondAxisSkip получают одинаковый байт 6-b
  16++DBD9                              ;   HL', DE', BC', AF', IX, IY, I, IFF и IM сохранены, SP после RET равен входному SP+2
  17++DBD9                              ;   помимо трёх изменяемых байтов память и порты не записываются
  18++DBD9                              ; Corrupt:
  19++DBD9                              ;   BC, AF, три операнда JR масштаба перспективы
  20++DBD9                              ; Note:
  21++DBD9                              ;   бит 7 заголовка не участвует в показателе, его роль передаётся отдельно через Flags очереди
  22++DBD9                              ;   при b=1..6 смещение равно 5..0 и пропускает часть пяти ADD HL,HL, масштаб равен 2^(b-1)
  23++DBD9                              ;   исходные JR содержат FE и до подготовки образуют самопереход, подготовка обязательна перед исполнением
  24++DBD9                              ;   процедура не проверяет допустимость b, при других значениях записывает обёрнутый байт без исправления
  25++DBD9                              ;   у всех 11 исходных моделей показатели равны 2 либо 3, безопасные 1..6 дополнительно проверены как допустимый формат
  26++DBD9                              ;   само деление перспективы и обход вершин локальной проверкой не подтверждены
  27++DBD9                              ; -----------------------------------------
  28++DBD9                              ; чтение показателя и старшего признака из заголовка выбранной модели
  29++DBD9 46           Entry:          LD B, (HL)
  30++DBDA                              ; исключение старшего признака из числового показателя масштаба
  31++DBDA CB B8                        RES @PreviewQueueConst.SecondKeyBit, B
  32++DBDC                              ; расчёт пропуска 6-b для трёх одинаковых последовательностей из пяти удвоений
  33++DBDC 3E 06                        LD A, @PreviewQueueBuildConst.ScaleStart
  34++DBDE 90                           SUB B
  35++DBDF                              ; обновление JR масштаба глубины перед её сложением с координатой объекта
  36++DBDF 32 20 DA                     LD (@PreviewProjectionScaleState.DepthSkip), A
  37++DBE2                              ; обновление JR масштаба первой проектируемой координаты
  38++DBE2 32 3B DA                     LD (@PreviewProjectionScaleState.FirstAxisSkip), A
  39++DBE5                              ; обновление JR масштаба второй проектируемой координаты
  40++DBE5 32 F9 DA                     LD (@PreviewProjectionScaleState.SecondAxisSkip), A
  41++DBE8 C9                           RET
  42++DBE9
  43++DBE9                              endmodule
  44++DBE9                              endmodule
