   6++C325              ; Запись выбранного ключа, поиск его пятого байта и центрирование карты
   7++C325              ; исходная запись 7, файловые смещения #0325..#0332
   8++C325              ; In:
   9++C325              ;   HL - второе слово выбираемого ключа, DE - первое слово, KARTA выбран
  10++C325              ;   действуют договоры ReadStoredMapVariant и CenterMapView, достижим конец первого списка либо совпадение
  11++C325              ; Out:
  12++C325              ;   MapSelection.FirstWord получает исходный DE, SecondWord получает исходный HL
  13++C325              ;   MapSelection.Variant получает пятый байт первой совпавшей записи либо ноль по ReadStoredMapVariant
  14++C325              ;   после поиска исходные HL и DE восстановлены со стека, затем выполняется последовательный CenterMapView
  15++C325              ;   x=256*входной E+входной L, y=256*входной D+входной H
  16++C325              ;   к каждой координате прибавлено FF00 OR ((0-floor(размер/2)) AND FF), результат обёрнут до 16 бит
  17++C325              ;   если Sign соответствующего обёрнутого результата установлен, координата заменена нулём
  18++C325              ;   HL упакован как старший Y и старший X, DE как младший Y и младший X
  19++C325              ;   OriginLow получает DE, OriginHigh получает HL, размеры Width и Height сохранены
  20++C325              ;   BC=FF00 OR ((0-floor(Height/2)) AND FF), A равен младшему байту окончательного Y
  21++C325              ;   F от последнего ADC для Y до отсечения, замена HL на 0 флагов не меняет
  22++C325              ;   все альтернативные регистры, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  23++C325              ;   IX у найденной записи либо ограничителя по ReadStoredMapVariant, прочие побочные записи поиска сохранены
  24++C325              ; Corrupt:
  25++C325              ;   HL, DE, BC, AF, IX
  26++C325              ; Note:
  27++C325              ;   два PUSH и два POP защищают исходный ключ от рабочих регистров поиска
  28++C325              ;   последовательный вход CenterMapView не создаёт нового адреса возврата
  29++C325              ;   окончательный F сообщает расчёт Y, его нельзя использовать как результат поиска сохранённой точки
