   3++A28F              ; Документация [Station](../../Docs/FunctionDetails/Station.md)
   4++A28F              ; Подробный разбор [байтовые координаты, доступная высота и строка указателя](../../Docs/RowSelection.md)
   5++A28F              ; -----------------------------------------
   6++A28F              ; Перевод числа строк в пиксели и ограничение доступной высотой элемента
   7++A28F              ; исходная запись 4, файловые смещения #428F..#42A3
   8++A28F              ; In:
   9++A28F              ;   DE - D запрошенное число восьмипиксельных строк, E пиксельный верхний отступ
  10++A28F              ;   IX - читаемая FInterfaceItem с байтовым Height в станционном банке 0
  11++A28F              ; Out:
  12++A28F              ;   HL и BC сохранены, E сохранён, A=(ROL8(Item.Height,3)-E-5) AND #F8
  13++A28F              ;   D=min(A,(входной D*8) AND #FF), F соответствует CP доступной высоты A и байтового запроса
  14++A28F              ;   Carry=1 означает уменьшение запроса, Carry=0 означает сохранение переведённого запроса
  15++A28F              ;   альтернативные и индексные регистры, I и IFF сохраняются, SP восстанавливается
  16++A28F              ; Corrupt:
  17++A28F              ;   DE, AF
  18++A28F              ; Note:
  19++A28F              ;   для штатных высот до 31 вращение Height эквивалентно умножению на восемь, у больших байтов старшие биты возвращаются в младшую тройку
  20++A28F              ;   у запроса D применяются SLA, старшие три разряда теряются, значение 32 превращается в нулевой запрос
  21++A28F              ;   вычитания E и 5 выполняются по модулю 256, недостаточная высота может обернуться большой доступной величиной
  22++A28F              ;   A всегда содержит доступную величину, даже когда возвращённый D меньше неё
  23++A28F              ;   память не меняется, минимальная допустимая геометрия проверяется не этим входом
  24++A28F              ; -----------------------------------------
  25++A28F                              ; чтение физической высоты элемента перед вычислением доступной области
  26++A28F DD 7E 03     Entry:          LD A, (IX + FInterfaceItem.Height)
  27++A292                              ; расчёт вращения Height на три бита, у высоты более 31 это не обычный сдвиг
  28++A292 07                           RLCA
  29++A293 07                           RLCA
  30++A294 07                           RLCA
  31++A295                              ; расчёт доступной высоты за вычетом верхнего отступа E
  32++A295 93                           SUB E
  33++A296                              ; вычет нижнего отступа перед округлением доступной высоты
  34++A296 D6 05                        SUB @RowSelectConst.BottomInset
  35++A298                              ; округление доступной байтовой высоты вниз к целому числу восьмипиксельных строк
  36++A298 E6 F8                        AND @RowSelectConst.CellMask
  37++A29A                              ; расчёт байтового пиксельного запроса из числа строк тремя SLA
  38++A29A CB 22                        SLA D
  39++A29C CB 22                        SLA D
  40++A29E CB 22                        SLA D
  41++A2A0                              ; проверка запроса относительно доступной высоты
  42++A2A0 BA                           CP D
  43++A2A1 D0                           RET NC                                                          ; выход, если доступная высота не меньше запроса, сохранить переведённый D
  44++A2A2
  45++A2A2                              ; ограничение возвращаемой высоты доступным числом пикселей
  46++A2A2 57                           LD D, A
  47++A2A3 C9                           RET
  48++A2A4
