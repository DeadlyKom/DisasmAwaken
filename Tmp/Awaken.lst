   5++A781              ; -----------------------------------------
   6++A781              ; Удаление разрешённых флагами элементов из текущего списка рисования
   7++A781              ; исходная запись 4, файловые смещения #4781..#47B6
   8++A781              ; In:
   9++A781              ;   физический список по #F3DE совпадает с текущим DrawListState.HeadOperand и заканчивается старшим байтом 1
  10++A781              ;   обёртки содержат индексы в +1,+2, доступны Flags соответствующих FInterfaceItem
  11++A781              ;   действует договор DropItemDraw, сдвиг 128 байтов вмещает остаток списка
  12++A781              ; Out:
  13++A781              ;   BC сохранён, IX указывает ограничитель после последнего оставленного обработчика
  14++A781              ;   HL - H=0, L остаток последнего указателя Flags, при исходно пустом списке L=#58
  15++A781              ;   DE - индекс последнего рассмотренного элемента, при пустом списке сохранён
  16++A781              ;   A - результат последней маски, при удалении 0, при пустом списке исходный A
  17++A781              ;   F - итоговый DEC H от H=1, Z=1, Carry сохранён от последней обработки
  18++A781              ;   периодический CALL получает EmptyCallback, при удалении EventEnabled=0
  19++A781              ;   альтернативные регистры, IY, I и IFF сохранены, SP восстановлен
  20++A781              ; Corrupt:
  21++A781              ;   HL, DE, AF, IX
  22++A781              ; Note:
  23++A781              ;   удаляются записи с Flags AND #C0=0 либо Flags AND #60=#60, остальные сохраняют порядок
  24++A781              ;   после удаления IX уменьшается на два, сдвинутый на его место элемент проверяется повторно
  25++A781              ;   это изменение списка с запросом перестроения, рисователи и callbacks закрытия не вызываются
  26++A781              ;   без совпадения физического и текущего списка алгоритм не имеет обещанного результата
  27++A781              ; -----------------------------------------
  28++A781                              ; выбор пустого периодического callback перед фильтром закрытия
  29++A781 21 58 9A     Entry:          LD HL, @Station.EmptyCallback.Entry
  30++A784                              ; сброс операнда периодического вызова MainLoop
  31++A784 22 89 9A                     LD (@MenuCommandState.PeriodicCall), HL
  32++A787                              ; поиск закрываемых элементов в физическом списке рисования
  33++A787 DD 21 DE F3                  LD IX, @StationState.DrawList
  34++A78B                              ; проверка старшего байта очередной обёртки на ограничитель списка
  35++A78B DD 66 01     NextDraw:       LD H, (IX + #01)
  36++A78E 25                           DEC H
  37++A78F C8                           RET Z                                                           ; выход, если старший байт указателя равен 1, список завершён
  38++A790
  39++A790                              ; восстановление старшего байта обёртки после проверки ограничителя
  40++A790 24                           INC H
  41++A791                              ; чтение указателя обёртки и индекса из её непосредственного операнда
  42++A791 DD 6E 00                     LD L, (IX + #00)
  43++A794 23                           INC HL
  44++A795 7E                           LD A, (HL)
  45++A796 23                           INC HL
  46++A797 66                           LD H, (HL)
  47++A798 6F                           LD L, A
  48++A799                              ; сохранение индекса для удаления после поиска адреса Flags
  49++A799 E5                           PUSH HL
  50++A79A                              ; поиск физического Flags элемента по индексу обёртки
  51++A79A CD EB 9E                     CALL @Station.GetItemFlags.Entry
  52++A79D                              ; проверка группы, нулевая старшая пара разрешает удаление
  53++A79D 7E                           LD A, (HL)
  54++A79E E6 C0                        AND @InterfaceFlags.CloseTopMask
  55++A7A0 D1                           POP DE
  56++A7A1                              ; переход указателя обхода к следующей паре списка
  57++A7A1 DD 23                        INC IX
  58++A7A3 DD 23                        INC IX
  59++A7A5 28 06                        JR Z, @Station.CloseAllItems.RemoveDraw                         ; переход, если Flags AND #C0 равен нулю, удалить элемент
  60++A7A7
  61++A7A7                              ; проверка совместно установленных битов 6 и 5 через инверсию Flags
  62++A7A7 7E                           LD A, (HL)
  63++A7A8 2F                           CPL
  64++A7A9 E6 60                        AND @InterfaceFlags.ClosePairMask
  65++A7AB 20 DE                        JR NZ, @Station.CloseAllItems.NextDraw                          ; переход, если хотя бы один из битов 6 и 5 сброшен, сохранить этот элемент
  66++A7AD
  67++A7AD                              ; удаление элемента со сдвигом оставшейся части списка
  68++A7AD CD 73 C8     RemoveDraw:     CALL #C873
  69++A7B0                              ; возврат к сдвинувшейся на прежнее место паре для повторной проверки
  70++A7B0 DD 2B                        DEC IX
  71++A7B2 DD 2B                        DEC IX
  72++A7B4 C3 8B A7                     JP @Station.CloseAllItems.NextDraw
