   5++E6C9                              ; Настройка ограниченного скольжения от прежней ноты к новой цели C
   6++E6C9                              ; исходная запись 10, файловые смещения #0BC9..#0BED
   7++E6C9                              ; In:
   8++E6C9                              ;   DE указывает на пять байтов, задержка, два пропускаемых байта, младший и старший байты шага
   9++E6C9                              ;   ожидающая нота содержит новую цель, текущая либо сохранённая прежняя нота содержит начало скольжения
  10++E6C9                              ; Out:
  11++E6C9                              ;   HL=адрес ожидающей ноты E2B9, DE=входной DE+5, B=0, C сохранён, F=44
  12++E6C9                              ;   целевая нота получает новую ожидающую ноту, ожидающая нота заменяется прежней, слово шага обновлено, смещение JR=0
  13++E6C9                              ;   A=новая целевая нота, задержка записана в текущий счётчик и перезагрузку, счётчик чередования обнулён
  14++E6C9                              ;   альтернативные пары сохранены
  15++E6C9                              ; Corrupt:
  16++E6C9                              ;   HL, DE, BC только B, AF, параметры скольжения, ожидающая и целевая нота, R
  17++E6C9                              ; Note:
  18++E6C9                              ;   два промежуточных байта только пропускаются, их значения не участвуют в расчёте
  19++E6C9                              ;   C восстанавливает прежнюю ноту из изменяемого операнда E6EC, заполненного декодером при постановке эффекта в стек
  20++E6C9                              ;   индексные регистры, I, IM и IFF сохранены, SP увеличен на два обычным RET
  21++E6C9                              ; -----------------------------------------
  22++E6C9                              ; Настройка ограниченного скольжения от прежней ноты к новой цели C
  23++E6C9 1A           Entry:          LD A, (DE)
  24++E6CA 13                           INC DE
  25++E6CB 32 9D E2                     LD (@MusicState.SlideCounterC), A
  26++E6CE 32 CC E2                     LD (@MusicState.SlideReloadC), A
  27++E6D1                              ; пропуск двух промежуточных байтов перед чтением знакового слова шага C
  28++E6D1 EB                           EX DE, HL
  29++E6D2 23                           INC HL
  30++E6D3 23                           INC HL
  31++E6D4 5E                           LD E, (HL)
  32++E6D5 23                           INC HL
  33++E6D6 56                           LD D, (HL)
  34++E6D7 23                           INC HL
  35++E6D8 EB                           EX DE, HL
  36++E6D9 22 A6 E2                     LD (@MusicState.SlideStepC), HL
  37++E6DC                              ; отключение чередования C и выбор пути ограничения целевой нотой
  38++E6DC AF                           XOR A
  39++E6DD 47                           LD B, A
  40++E6DE 32 D5 E2                     LD (@MusicGateState.CounterC), A
  41++E6E1 32 AD E2                     LD (@MusicState.SlideBranchC), A
  42++E6E4                              ; сохранение новой цели C перед восстановлением ноты, захваченной декодером
  43++E6E4 21 B9 E2                     LD HL, @MusicEffectState.CurrentNoteC
  44++E6E7 7E                           LD A, (HL)
  45++E6E8 32 B1 E2                     LD (@MusicEffectState.TargetNoteC), A
  46++E6EB                              ; восстановление прежней ноты C из изменяемого операнда, подготовленного декодером
  47++E6EB 36 00                        LD (HL), #00
  48++E6ED C9                           RET
  49++E6EE
  50++E6EE                              endmodule
  51++E6EE                              endmodule
