   6++CA04              ; Запрос перестроения и возврат исходного контекста с Carry после изменения геометрии
   7++CA04              ; исходная запись 4, файловые смещения #6A04..#6A10
   8++CA04              ; In:
   9++CA04              ;   SP указывает на ранее созданный FPointerGuardFrame, вложенных слов поверх него уже нет
  10++CA04              ; Out:
  11++CA04              ;   HL, DE, BC, IX и A восстановлены из кадра, F=(AND_flags(A) AND #C4) OR (A AND #28) OR 1
  12++CA04              ;   InterfaceState.EventEnabled=0, SP после RET соответствует исходному вызову
  13++CA04              ; Corrupt:
  14++CA04              ;   HL, DE, BC, AF, IX
  15++CA04              ; Note:
  16++CA04              ;   базовый кадр соответствует FPointerGuardFrame, SavedBC, SavedDE, SavedHL, SavedAF, SavedIX, ReturnAddress
