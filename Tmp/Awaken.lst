   1++6FC5                              module Station
   2++6FC5                              module DrawItem31
   3++6FC5              ; Документация [Station](../../Docs/FunctionDetails/Station.md)
   4++6FC5              ; Подробный разбор [полный проход рамки, банкового имени и печати](../../Docs/MissionNameDraw.md)
   5++6FC5              ; -----------------------------------------
   6++6FC5              ; Рамка элемента цели миссии, сброс строки наведения и печать сформированного имени
   7++6FC5              ; исходная запись 4, файловые смещения #1271..#1299
   8++6FC5              ; In:
   9++6FC5              ;   DrawItemState.Opcode31 равен 21 для работы либо C9 для отключения, Index31 актуальный индекс записи, загрузчик записывает 31
  10++6FC5              ;   при активном коде выполнен договор DrawCaptionItem, геометрия целиком видима, таблицы и свободная индексная пара подготовлены
  11++6FC5              ;   MissionOffer.Entry.FirstWord и SecondWord доступны, KARTA загружена в банк 1, действует BuildSystemName
  12++6FC5              ;   порт и CurrentPage согласованы, исходно выбраны станционный банк 0 и ROM 1, bit5 снят, стек вне банкового окна
  13++6FC5              ;   HALT рамки корректно пробуждается с сохранением контекста, первоначальный bootstrap уже завершён
  14++6FC5              ; Out:
  15++6FC5              ;   при активном коде прямоугольник зарегистрирован, рамка и заголовок соответствуют DrawCaptionItem
  16++6FC5              ;   MissionHoverState.Row=FF, TextWindow.Style=0, имя предлагаемого пункта записано в SystemNameState.Buffer
  17++6FC5              ;   последний PrintText использует сформированный LF-поток, HL его продолжение, DE адрес LF в буфере
  18++6FC5              ;   BC содержит десятки и единицы второго числового поля имени по BuildSystemName
  19++6FC5              ;   AF статус последнего PrintText, при завершении LF A=0A, F=4A
  20++6FC5              ;   HL'=MissionOffer.FirstWord AND F0FF, DE'=MissionOffer.SecondWord AND FFF0, BC'=входной основной BC
  21++6FC5              ;   AF' по DrawCaptionItem, последующие BuildSystemName и PrintText сохраняют его
  22++6FC5              ;   IX, IY, I и IFF сохранены при договоре пробуждения, SP обычного возврата равен входному SP+2
  23++6FC5              ;   страницы последовательно выбирают банк 1 и банк 0 через исходный интерфейс, старшие биты сохраняются, ROM 1 принудителен
  24++6FC5              ;   при Opcode31=C9 немедленный RET сохраняет регистры, операнды и буфер, тело рисователя не исполняется
  25++6FC5              ; Corrupt:
  26++6FC5              ;   HL, DE, BC, AF, HL', DE', BC', AF' по DrawCaptionItem, только при активной обёртке
  27++6FC5              ; Note:
  28++6FC5              ;   имя строится настоящим BuildSystemName с его обменом общих наборов и пропуском нулевых десятков
  29++6FC5              ;   явный LD HL,Buffer после возврата банка нужен, рабочий HL построителя указывает на исходный префикс
  30++6FC5              ;   Style=0 задаётся после рамки и остаётся на выходе, отбрасывание неуместившегося хвоста соответствует PrintText
  31++6FC5              ;   Row сбрасывается после перерисовки фона, чтобы новая подсветка не снимала старую полосу
  32++6FC5              ;   данный проход не принимает миссию и не начисляет награду, нажатие использует самостоятельный вход Handler+3
  33++6FC5              ; -----------------------------------------
  34++6FC5                              ; чтение изменяемого Index31, первый байт RET может отключить всю обёртку
  35++6FC5 21 00 00     Entry:          LD HL, #0000
  36++6FC8                              ; регистрация элемента, рамка и заголовок через полный DrawCaptionItem
  37++6FC8 CD 87 C2                     CALL @Station.DrawCaptionItem.Entry
  38++6FCB                              ; выбор отсутствующей прежней строки после замены фона элемента
  39++6FCB 3E FF                        LD A, @MissionHoverConst.NoRow
  40++6FCD                              ; сброс сохранённого Row наведения, предыдущая XOR-полоса больше не соответствует новому изображению
  41++6FCD 32 54 6F                     LD (@MissionHoverState.Row), A
  42++6FD0                              ; выбор режима без автоматического продолжения слишком длинного текста
  43++6FD0 AF                           XOR A
  44++6FD1 32 26 BD                     LD (@TextWindow.Style), A
  45++6FD4                              ; чтение обоих слов предлагаемого пункта из физического состояния миссии
  46++6FD4 2A B0 98                     LD HL, (@MissionOffer.Entry.FirstWord)
  47++6FD7 ED 5B B2 98                  LD DE, (@MissionOffer.Entry.SecondWord)
  48++6FDB                              ; выбор KARTA в банке 1 для формирования имени из упакованных полей
  49++6FDB 3E 11                        LD A, @SystemNameConst.MapPage
  50++6FDD CD 96 63                     CALL @Station.SelectRamBank.Entry
  51++6FE0                              ; построение LF-имени в общем буфере, основной набор регистров после вызова поменяется
  52++6FE0 CD AB E6                     CALL @Map.BuildSystemName.Entry
  53++6FE3                              ; возврат станционного банка 0 перед печатью
  54++6FE3 3E 10                        LD A, @StationIrqConst.StationPage
  55++6FE5 CD 96 63                     CALL @Station.SelectRamBank.Entry
  56++6FE8                              ; выбор именно общего буфера, возвращённый HL построителя указывает на другое место
  57++6FE8 21 0B 63                     LD HL, @SystemNameState.Buffer
  58++6FEB                              ; хвостовая печать имени с исходным адресом возврата вызывающего рисователя
  59++6FEB C3 08 BD                     JP @Station.PrintText.Entry
  60++6FEE
  61++6FEE                              endmodule
  62++6FEE                              endmodule
