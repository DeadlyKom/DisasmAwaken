   4++C653              ; Подробный разбор [оборачиваемые разности, строгое сравнение и самомодифицируемый минимум](../../Docs/MapDistanceMinimum.md)
   5++C653              ; -----------------------------------------
   6++C653              ; Обновление минимума квадрата расстояния от пары байтов до целевой точки
   7++C653              ; исходная запись 7, файловые смещения #0653..#0676
   8++C653              ; In:
   9++C653              ;   HL - адрес двух последовательных байтов X,Y, DE - D целевой Y, E целевой X
  10++C653              ;   MapDistanceState.Minimum содержит текущее беззнаковое слово минимума в операнде LD DE,nn
  11++C653              ;   KARTA выбран и доступен для самомодификации, обычный стек доступен
  12++C653              ; Out:
  13++C653              ;   dx=(X-E)&FF, dy=(Y-D)&FF, их модули берутся после знаковой интерпретации байтов
  14++C653              ;   q=abs(dx)^2+abs(dy)^2, 0<=q<=32768, сумма помещается в слово
  15++C653              ;   Carry=1 и Minimum=q только при q<входного Minimum, иначе Carry=0 и Minimum сохранён
  16++C653              ;   HL=входной HL+1 modulo 65536, DE и BC сохранены, AF - A=high(abs(dx)^2)
  17++C653              ;   при отказе F точно соответствует SBC HL,DE для q-Minimum с Carry=0
  18++C653              ;   при обновлении S,Z,P/V остаются от q-Minimum, H=N=0, Carry=1, биты 5 и 3 берутся из A
  19++C653              ;   HL'=q при обновлении, иначе (q-Minimum)&FFFF, DE'=входной Minimum, B'=0, C' сохранён
  20++C653              ;   AF' - A'=high(abs(dy)^2), F' соответствует логическим флагам low(abs(dy)^2), H=N=Carry=0
  21++C653              ;   IX, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  22++C653              ; Corrupt:
  23++C653              ;   HL, AF, HL', DE', BC' только B', AF', операнд Minimum при строгом улучшении
  24++C653              ; Note:
  25++C653              ;   разности оборачиваются до байта перед проверкой знака, это не неограниченное расстояние двух обычных экранных координат
  26++C653              ;   NEG от 80 оставляет 80, SumSquares8 принимает этот байт как беззнаковый модуль 128
  27++C653              ;   равное расстояние не обновляет минимум, вызывающий сохраняет первый встретившийся вариант
  28++C653              ;   HL остаётся на Y той же пары, процедура не переходит к следующей двухбайтовой записи
  29++C653              ;   сброс минимума выполняет SelectNearestMapVariant, [достижимость действий](../../Docs/StationEventActions.md)
  30++C653              ;   точные регистры и флаги учитывают фактический вызов SumSquares8 без подмены
  31++C653              ; -----------------------------------------
  32++C653                              ; чтение X кандидата и переход указателя на Y той же пары
  33++C653 7E           Entry:          LD A, (HL)
