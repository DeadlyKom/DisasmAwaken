   1++D0C3                              module Map
   2++D0C3                              module SetupMapRasterWindow
   3++D0C3              ; Документация [Map](../../Docs/FunctionDetails/Map.md)
   4++D0C3              ; Подробный разбор [69 изменяемых байтов и проверенные профили потребителей](../../Docs/MapRuntimeProfiles.md)
   5++D0C3              ; -----------------------------------------
   6++D0C3              ; Настройка границ отсечения, половин размеров и крайних адресов растрового окна
   7++D0C3              ; исходная запись 7, файловые смещения #10C3..#11AB
   8++D0C3              ; In:
   9++D0C3              ;   HL - H=MaxY, L=MaxX, DE - D=MinY, E=MinX, параметры беззнаковые байты
  10++D0C3              ;   MapScreenTables по EE00, EF00 и F000 построены, банк KARTA выбран и доступен для самомодификации
  11++D0C3              ;   исходный код, четыре угловые пары и все 69 назначений записей доступны, минимумы и максимумы не проверяются
  12++D0C3              ; Out:
  13++D0C3              ;   четыре угла получают пары MinX/MaxX и MinY/MaxY, произведения и выходные пересечения получают соответствующие границы
  14++D0C3              ;   пороги классификатора равны (MaxX+1)&FF и (MaxY+1)&FF, сравнение младшего Y с 192 в пересечениях не меняется
  15++D0C3              ;   HalfX=((MaxX+1)&FF) SHR 1, HalfY=(((MaxY+1)&FF) SHR 1) OR (80 при HalfX<2)
  16++D0C3              ;   операнды растрового ядра получают HalfX, HalfX-2 modulo 256, HalfY, MaxY и MaxX+1 modulo 256
  17++D0C3              ;   MapState.UpperRow=RowHigh[0]:RowLow[0], LowerRow=RowHigh[(MaxY+1)&FF]:RowLow[(MaxY+1)&FF]
  18++D0C3              ;   левые колонки получают ColumnByte[0], правые и колонки поиска получают ColumnByte[MaxX]
  19++D0C3              ;   HL=F000+MaxX, DE=MapState.UpperRow, BC - B сохранён, C=MaxX
  20++D0C3              ;   AF - A=ColumnByte[MaxX], F=B0 OR ((MaxY+1)&1)
  21++D0C3              ;   HL', DE', BC', AF', IX, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  22++D0C3              ; Corrupt:
  23++D0C3              ;   HL, DE, BC только C, AF, 69 байтов операндов и состояния окна
  24++D0C3              ; Note:
  25++D0C3              ;   после SUB 2 перенос не сбрасывается перед RRA для HalfY, при HalfX<2 он устанавливает бит 7
  26++D0C3              ;   проверены все пары максимальных границ при Min=0 и все пары минимальных границ при MaxX=239, MaxY=175
  27++D0C3              ;   механика настройки не доказывает корректность произвольного прямоугольника, классификатор не сдвигает нижний предел с нуля
  28++D0C3              ;   вызов из станционного действия установлен по [новым входам интерфейса](../../Docs/StationEventActions.md)
  29++D0C3              ;   точный каталог назначений, модели потребителей и их ограничения приведены в [фазах исполнения](../../Docs/MapRuntimeProfiles.md)
