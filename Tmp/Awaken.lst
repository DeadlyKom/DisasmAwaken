  31++A021 3A C7 AE                     LD A, (@TextWindow.OriginYLow)
  32++A024 C6 05                        ADD A, #05
  33++A026 6F                           LD L, A
  34++A027                              ; расчёт колонки начала иконки с отступом 5 от внутреннего начала X
  35++A027 3A BB AE                     LD A, (@TextWindow.OriginXLow)
  36++A02A C6 05                        ADD A, #05
  37++A02C 5F                           LD E, A
  38++A02D                              ; поиск старшего и младшего экранного адреса в исходных таблицах строк и колонок
  39++A02D 26 82                        LD H, #82
  40++A02F 56                           LD D, (HL)
  41++A030 24                           INC H
  42++A031 7E                           LD A, (HL)
  43++A032 24                           INC H
  44++A033 6B                           LD L, E
  45++A034                              ; расчёт младшего адреса первой строки как сумма строки и колонки
  46++A034 86                           ADD A, (HL)
  47++A035 5F                           LD E, A
  48++A036                              ; возврат источника после окончания расчёта назначения
  49++A036 E1                           POP HL
  50++A037                              ; создание отдельного счётчика 32 строк, далее он сохраняется обменом AF,AF'
  51++A037 3E 20                        LD A, #20
  52++A039                              ; сохранение счётчика и выбор рабочего AF для переноса одной строки
  53++A039 08           CopyRow:        EX AF, AF'
  54++A03A                              ; сохранение младшего адреса начала строки до четырёх LDI
  55++A03A 7B                           LD A, E
  56++A03B                              ; перенос четырёх последовательных байтов, возможный перенос DE через #FF не отменяется
  57++A03B ED A0                        LDI
  58++A03D ED A0                        LDI
  59++A03F ED A0                        LDI
  60++A041 ED A0                        LDI
  61++A043                              ; возврат младшего адреса и переход к следующей пиксельной строке через увеличение D
  62++A043 5F                           LD E, A
  63++A044 14                           INC D
  64++A045                              ; проверка границы восьмистрочного знакоместа по младшим трём разрядам D
  65++A045 7A                           LD A, D
  66++A046 E6 07                        AND #07
  67++A048 C2 55 A0                     JP NZ, @Station.CopyWindowIcon.CountRow                         ; переход, если D ещё не достиг границы знакоместа, продолжить счёт строк
  68++A04B
  69++A04B                              ; расчёт перехода младшего адреса к следующей строке знакомест
  70++A04B 7B                           LD A, E
  71++A04C C6 20                        ADD A, #20
  72++A04E 5F                           LD E, A
  73++A04F 38 04                        JR C, @Station.CopyWindowIcon.CountRow                          ; переход, если E+32 дало перенос, сохранить уже увеличенный старший адрес
  74++A051
  75++A051                              ; расчёт коррекции старшего адреса на минус восемь при переносе знакоместа без переполнения E
  76++A051 7A                           LD A, D
  77++A052 D6 08                        SUB #08
  78++A054 57                           LD D, A
