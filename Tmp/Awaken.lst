  25++E29D 3A BF DF                     LD A, (@MapArcState.ReferenceX)
  26++E2A0 80                           ADD A, B
  27++E2A1 ED 44                        NEG
  28++E2A3                              ; обновление C' с сохранением остальных альтернативных байтов
  29++E2A3 D9                           EXX
  30++E2A4 4F                           LD C, A
  31++E2A5                              ; загрузка StartY в альтернативный E, флаги предшествующего NEG сохраняются
  32++E2A5 3A B3 DF                     LD A, (@MapArcState.StartY)
  33++E2A8 5F                           LD E, A
  34++E2A9 D9                           EXX
  35++E2AA C9                           RET
  36++E2AB
