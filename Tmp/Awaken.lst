   3++ECF3                              ; Документация [вывод текстового окна](../../Docs/ControlsTextDisplay.md)
   4++ECF3                              ; -----------------------------------------
   5++ECF3                              ; Десятичный вывод байта с минимальной шириной два знака
   6++ECF3                              ; исходная запись 23, банк 1, смещения #1215..#1249
   7++ECF3                              ; In:
   8++ECF3                              ;   HL, DE, BC входных аргументов не задают, AF задаёт A=0..255, входные флаги не используются
   9++ECF3                              ;   выбран банк 1 с исходными CONTROL0 и CONTROL, код и экран доступны для записи
  10++ECF3                              ;   после InitializeTextWindow операнды прокрутки соответствуют окну x=160..255, y=144..189
  11++ECF3                              ;   на CPU-стеке лежит внешний возврат, вмешательство ISR в модель не включено
  12++ECF3                              ;   при прокрутке SP временно указывает на экран, обработчик прерываний не должен использовать этот SP
  13++ECF3                              ; Out:
  14++ECF3                              ;   выведено format(A, 02d), для 0..99 две цифры, для 100..255 три
  15++ECF3                              ;   TextColumn изменён настоящим рисователем, прокрутка возможна перед любой цифрой
  16++ECF3                              ;   IX сохраняется
  17++ECF3                              ;   HL' и IY сохраняются, I, IM и IFF сохраняются, банковых переключений и портовых операций нет
  18++ECF3                              ;   внешний RET задаёт SP=входной SP+2, сама процедура DI не выполняет
  19++ECF3                              ; Corrupt:
  20++ECF3                              ;   HL, DE, BC, AF, DE', BC', AF', R, экран, TextColumn, SavedScrollSP при прокрутке и CPU-стек
  21++ECF3                              ; Note:
  22++ECF3                              ;   разделитель после числа здесь не добавляется, дополнительную колонку оставляет ConsumeTextQueue
  23++ECF3                              ;   остаток сохраняется в B через PUSH BC и POP AF между выводом цифр
  24++ECF3                              ; -----------------------------------------
  25++ECF3                              ; проверка необходимости третьего десятичного разряда
  26++ECF3 FE 64        Entry:          CP #64
  27++ECF5 38 13                        JR C, @Controls.PrintByteDecimal.PrintLastTwo                   ; переход, если число меньше 100, вывести только десятки и единицы
  28++ECF7
  29++ECF7                              ; вычисление сотен последовательным вычитанием 100 с восстановлением остатка после заёма
  30++ECF7 0E 00                        LD C, #00
  31++ECF9 06 64                        LD B, #64
  32++ECFB 90                           SUB B
