# file opened: Source/Voxel/Multiply7BitWord.asm
   1++F931                              module Voxel
   2++F931                              module Multiply7BitWord
   3++F931              ; Документация [Voxel](../../Docs/FunctionDetails/Voxel.md)
   4++F931              ; -----------------------------------------
   5++F931              ; Умножение младших семи битов A на BC с результатом HL modulo #10000
   6++F931              ; исходная запись 21, файловые смещения #0D31..#0D56
   7++F931              ; In:
   8++F931              ;   BC - беззнаковое слово, AF - A множитель, учитываются только биты 6..0
   9++F931              ; Out:
  10++F931              ;   HL - ((A AND #7F) * BC) modulo #10000
  11++F931              ; Corrupt:
  12++F931              ;   HL, AF
  13++F931              ; Note:
  14++F931              ;   старший бит A пропускается двумя первыми RLA, это не полное умножение восьмибитного A
  15++F931              ;   DE, BC, альтернативные и индексные регистры сохраняются
  16++F931              ;   развёрнутый сдвиговый алгоритм содержит семь условных добавлений BC
  17++F931              ;   результат ограничен 16 битами, переносы сверх HL в результат не включаются
  18++F931              ; -----------------------------------------
  19++F931                              ; расчёт произведения по битам 6..0 A, старший бит множителя пропускается
  20++F931 21 00 00     Entry:          LD HL, #0000
