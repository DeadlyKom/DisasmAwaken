   1++AB1B                              module Action
   2++AB1B                              module SelectMemoryPage
   3++AB1B                              ; Документация [выбор страницы и активация параметров](../../Docs/ActionParameterActivation.md)
   4++AB1B                              ; -----------------------------------------
   5++AB1B                              ; Запись полного A в 7FFD с сохранением регистров и учётом блокировки
   6++AB1B                              ; исходная запись 17, общий код фиксированного банка 2, смещения #4B1B..#4B22
   7++AB1B                              ; In:
   8++AB1B                              ;   HL, DE и BC сохраняются, AF задаёт A как полный записываемый байт 7FFD, весь F сохраняется
   9++AB1B                              ;   сохранённый BC и внешний возврат находятся в сохраняющемся RAM-окне, рамка не перекрывает исполняемый код
  10++AB1B                              ;   на стеке внешний возврат, ещё два байта нужны для PUSH BC, IRQ не вмешиваются
  11++AB1B                              ; Out:
  12++AB1B                              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY, I, IM и IFF сохраняются
  13++AB1B                              ;   в порт 7FFD выдан ровно один байт A, при исходной блокировке записи выбранное отображение не меняется
  14++AB1B                              ;   SP=входной SP+2, R получает 6 M1, два байта перед входным SP содержат исходные C и B
  15++AB1B                              ; Corrupt:
  16++AB1B                              ;   два байта CPU-стека, управление 7FFD при разрешённой записи, R
  17++AB1B                              ; Note:
  18++AB1B                              ;   теневая программная копия 7FFD не записывается, BC восстанавливается после настоящего OUT
  19++AB1B                              ;   значение на шине порта и результат аппаратного переключения различаются при установленном бите блокировки
  20++AB1B                              ;   поведение исходной блокировки проверено моделью банка, нативный запуск и IRQ этим не доказываются
  21++AB1B                              ; -----------------------------------------
  22++AB1B                              ; сохранение BC в общей RAM до изменения выбранного верхнего окна
  23++AB1B C5           Entry:          PUSH BC
  24++AB1C                              ; подготовка полного адреса порта 7FFD без изменения F
  25++AB1C 01 FD 7F                     LD BC, #7FFD
  26++AB1F                              ; выдача A на шину 7FFD, исходная аппаратная блокировка может сохранить прежнее отображение
  27++AB1F ED 79                        OUT (C), A
  28++AB21                              ; восстановление BC из общей RAM без изменения AF
  29++AB21 C1                           POP BC
  30++AB22 C9                           RET
  31++AB23
  32++AB23                              endmodule
  33++AB23                              endmodule
