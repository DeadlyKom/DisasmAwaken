  29++C5D0                              ; выбор поля StockAndMark первой физической строки рынка
  30++C5D0 11 55 95                     LD DE, @MarketRows.Row00.StockAndMark
  31++C5D3                              ; расчёт двухбайтового смещения рыночной строки
  32++C5D3 29                           ADD HL, HL
  33++C5D4                              ; расчёт адреса StockAndMark выбранной строки
  34++C5D4 19                           ADD HL, DE
  35++C5D5                              ; выбор результата ложь до проверки старшего маркера
  36++C5D5 AF                           XOR A
  37++C5D6                              ; проверка bit7 StockAndMark, игровые единицы этого маркера не установлены
  38++C5D6 CB 7E                        BIT 7, (HL)
  39++C5D8 20 01                        JR NZ, @Text.IsMarketMarkClear.ReturnResult                     ; переход, если bit7 StockAndMark установлен, вернуть нулевой результат
  40++C5DA
  41++C5DA                              ; выбор результата истина при снятом старшем маркере
  42++C5DA 3C                           INC A
  43++C5DB                              ; возврат логического результата в DE с нулевым D
  44++C5DB 5F           ReturnResult:   LD E, A
  45++C5DC 16 00                        LD D, #00
  46++C5DE C9                           RET
