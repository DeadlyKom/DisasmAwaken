   1++D430                              module Map
   2++D430                              module BuildMapPointOutcodes
   3++D430              ; Документация [Map](../../Docs/FunctionDetails/Map.md)
   4++D430              ; Подробный разбор [пятибайтовая точка, разряды границ и оборачивание при количестве 0](../../Docs/MapPointOutcodes.md)
   5++D430              ; -----------------------------------------
   6++D430              ; Классификация рабочих точек по изменяемым верхним порогам и OR кодов границ
   7++D430              ; исходная запись 7, файловые смещения #1430..#148A
   8++D430              ; In:
   9++D430              ;   StopX и StopY обозначают байты изменяемых CP по D44D и D468, исходно оба FF
  10++D430              ;   после D0C3 StopX=(MaxX+1) AND FF, StopY=(MaxY+1) AND FF, минимумы не сдвигают нулевую нижнюю границу
  11++D430              ;   HL' - адрес байта описания количества, используется только младшая тетрада
  12++D430              ;   MapClipState.Points содержит доступные записи FProjectedPoint по пять байтов, KARTA выбран
  13++D430              ;   для обычного прохода количество N=1..15, поля X и Y читаются как знаковые 16-битные координаты
  14++D430              ;   при N=0 нужна вся доступная страница F800..F8FF, код обработает её с оборачиванием L
  15++D430              ; Out:
  16++D430              ;   в ClipCodes каждой обработанной записи записан младший код выхода и дополнение его разрядов в старшей тетраде
  17++D430              ;   разряды 0..3 означают соответственно X>=StopX, X<0, Y>=StopY и Y<0
  18++D430              ;   разряды 4..7 являются дополнениями соответствующих разрядов 0..3, точка внутри имеет ClipCodes=F0
  19++D430              ;   HL=F800+((5*N+1) AND FF), DE сохранён, B=5*N, C младший код последней обработанной точки
  20++D430              ;   AF содержит OR всех записанных ClipCodes и логические флаги этого OR
  21++D430              ;   HL', DE', BC' сохранены, AF' содержит A'=5*N и F' от CP A',B при равных значениях
  22++D430              ;   IX, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  23++D430              ;   при N=0 обработаны 256 циклических записей, итоговые N в формулах указателя и B остаются нулевыми
  24++D430              ; Corrupt:
  25++D430              ;   HL, BC, AF, AF'
  26++D430              ; Note:
  27++D430              ;   при положительных StopX и StopY внутри разрешены X=0..StopX-1 и Y=0..StopY-1, исходный профиль даёт 0..254
  28++D430              ;   нулевой Stop исключает все неотрицательные координаты данной оси, Max=255 не задаёт полный диапазон
  29++D430              ;   настройка и границы моделей описаны в [фазах исполнения](../../Docs/MapRuntimeProfiles.md)
  30++D430              ;   байт ClipCodes не является восемью независимыми флагами, старшая тетрада связана с младшей дополнением
  31++D430              ;   нулевой ClipCodes не формируется для обычной координаты, нейтральное DB 00 структуры не означает готовую классификацию
  32++D430              ;   при N=0 шаг по L равен пяти, обход посещает все 256 позиций страницы и меняет координаты будущих циклических записей
  33++D430              ;   известный прямой вызов из D1AC предварительно возвращается при количестве 0 и 1, другие возможные входы этим не исключаются
  34++D430              ;   это классификация рабочих координат, полный алгоритм последующего отсечения и проекции ещё разбирается
  35++D430              ; -----------------------------------------
  36++D430                              ; выбор старшего байта X первой рабочей записи FProjectedPoint
  37++D430 21 01 F8     Entry:          LD HL, @MapClipState.Points + FProjectedPoint.X + 1
  38++D433                              ; обнуление OR-накопителя в AF альтернативного набора
  39++D433 AF                           XOR A
  40++D434 08                           EX AF, AF'
  41++D435                              ; чтение младшей тетрады описания через альтернативный HL без изменения самого указателя
  42++D435 D9                           EXX
  43++D436 7E                           LD A, (HL)
  44++D437 D9                           EXX
  45++D438                              ; расчёт конечного байтового смещения как пять полей на каждую рабочую точку
  46++D438 E6 0F                        AND @MapClipConst.CountMask
  47++D43A 47                           LD B, A
  48++D43B 87                           ADD A, A
  49++D43C 87                           ADD A, A
  50++D43D 80                           ADD A, B
  51++D43E 47                           LD B, A
  52++D43F                              ; сброс четырёх признаков текущей точки перед проверкой координат
  53++D43F 0E 00        NextPoint:      LD C, #00
  54++D441                              ; проверка старшего байта X для отрицательного либо положительного выхода
  55++D441 7E                           LD A, (HL)
  56++D442 A7                           AND A
  57++D443 FA 53 D4                     JP M, @Map.BuildMapPointOutcodes.SetLeft                        ; переход, если X отрицателен, установить признак левой стороны
  58++D446
  59++D446 C2 58 D4                     JP NZ, @Map.BuildMapPointOutcodes.SetRight                      ; переход, если положительный старший байт X ненулевой, установить правую сторону
  60++D449
  61++D449                              ; проверка младшего X относительно изменяемого исключённого порога StopX при нулевом старшем байте
  62++D449 2D                           DEC L
