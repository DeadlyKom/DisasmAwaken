# file opened: Source/Music/ClearAyRegisters.asm
   1++DB7C                              module Music
   2++DB7C                              module ClearAyRegisters
   3++DB7C                              ; Документация [инициализация и глушение AY](../../Docs/MusicInitialization.md)
   4++DB7C                              ; -----------------------------------------
   5++DB7C                              ; Последовательная запись нуля в аппаратные регистры AY 13..0 без изменения RAM
   6++DB7C                              ; исходная запись 10, файловые смещения #007C..#008B
   7++DB7C                              ; In:
   8++DB7C                              ;   HL сохраняется, DE и BC аргументов не задают, AF задаёт сохраняемые A и входной Carry
   9++DB7C                              ;   выбран банк MUZ1, на CPU-стеке внешний возврат, портовая трасса рассматривается без вмешательства ISR
  10++DB7C                              ; Out:
  11++DB7C                              ;   HL сохранён, DE=0000, BC=BFFD, A сохранён, F=42 OR входной Carry
  12++DB7C                              ;   аппаратные регистры AY 13..0 получают ноль, каждому предшествует выбор номера через FFFD, данные идут через BFFD
  13++DB7C                              ;   ни один байт RAM не записывается, в том числе буфер AY, разрешения каналов и данные стека сохраняются
  14++DB7C                              ;   HL', DE', BC', AF', IX, IY, I, IM и IFF сохраняются, SP после RET равен входному SP+2
  15++DB7C                              ; Corrupt:
  16++DB7C                              ;   DE, BC, AF только по F, аппаратные AY, R
  17++DB7C                              ; Note:
  18++DB7C                              ;   это глушение портов, следующий PlayFrame может снова вывести звук из сохранённого состояния
  19++DB7C                              ;   DI здесь нет, остановкой кадров и режимом прерываний управляет вызывающий код
  20++DB7C                              ;   F создаётся последним DEC D от 1 к 0, Carry сохраняется от входа
  21++DB7C                              ;   вход Stop содержит только JR к ClearAyRegisters, отдельного вызова или рамки стека нет
  22++DB7C                              ; -----------------------------------------
  23++DB7C                              ; подготовка D=14 для обратного обхода аппаратных регистров и E=0 для записываемых данных
  24++DB7C 11 00 0E     Entry:          LD DE, #0E00
  25++DB7F                              ; расчёт номера очередного аппаратного регистра от 13 до 0
  26++DB7F 15           MuteNext:       DEC D
  27++DB80                              ; выбор регистра через FFFD и запись нуля через BFFD без изменения RAM-буфера
  28++DB80 01 FD FF                     LD BC, #FFFD
  29++DB83 ED 51                        OUT (C), D
  30++DB85 06 BF                        LD B, #BF
  31++DB87 ED 59                        OUT (C), E
  32++DB89 20 F4                        JR NZ, @Music.ClearAyRegisters.MuteNext                         ; переход, если номер только что обнулённого регистра ненулевой, продолжить очистку
  33++DB8B
  34++DB8B                              ; возврат с F=42 OR входной Carry и сохранённым A
  35++DB8B C9                           RET
  36++DB8C
  37++DB8C                              endmodule
  38++DB8C                              endmodule
  39++DB8C
