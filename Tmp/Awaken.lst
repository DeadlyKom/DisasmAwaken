  26++B517 F1                           POP AF
  27++B518 08                           EX AF, AF'
  28++B519                              ; восстановление FGlyphFrame.SavedHLAlt, SavedBCAlt и SavedDEAlt
  29++B519 E1                           POP HL
  30++B51A C1                           POP BC
  31++B51B D1                           POP DE
  32++B51C D9                           EXX
  33++B51D                              ; восстановление FGlyphFrame.SavedHL, SavedBC и SavedDE после обмена наборов
  34++B51D E1                           POP HL
  35++B51E C1                           POP BC
  36++B51F D1                           POP DE
  37++B520                              ; возврат по FGlyphFrame.ReturnAddress, весь шестнадцатибайтовый кадр снят со стека
  38++B520 C9                           RET
  39++B521
  40++B521                              endmodule
