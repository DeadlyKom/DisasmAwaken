   1++6000                              module Action
   2++6000                              module QueueNumberBank1
   3++6000                              ; Документация [межбанковые вызовы очереди](../../Docs/ActionTextQueueCalls.md)
   4++6000                              ; -----------------------------------------
   5++6000                              ; Передача байтового числа A в очередь Controls банка 1 с фиксированным возвратом страницы 10
   6++6000                              ; исходная запись 17, файловые смещения #023D..#024C
   7++6000                              ; In:
   8++6000                              ;   HL сохраняется, DE аргументов не задаёт, BC сохраняется, AF задаёт число A и сохраняемые флаги F
   9++6000                              ;   AF' задаёт сохраняемые F', входной A' не сохраняется
  10++6000                              ;   paging не заблокирован, банк 1 содержит Controls, его очередь и курсор удовлетворяют договору QueueNumber
  11++6000                              ;   код обёртки и SelectMemoryPage находятся ниже C000 и доступны при обоих значениях страницы
  12++6000                              ;   на стеке внешний возврат, доступны восемь дополнительных байтов ниже входного SP, вмешательство ISR не входит в договор
  13++6000                              ; Out:
  14++6000                              ;   HL сохранён, DE=0200 OR входной A, BC сохранён, A=10, F сохранены
  15++6000                              ;   HL', DE', BC' сохраняются, A'=11, F' сохранены, IX, IY, I, IM и IFF сохраняются
  16++6000                              ;   OUT 7FFD получает 11, реальный Controls.QueueNumber исполняется в банке 1, затем OUT 7FFD получает 10
  17++6000                              ;   на выходе выбрана полная страница 10, прежнее значение paging не восстанавливается
  18++6000                              ;   очередь обновлена либо молча отклонила запись по договору производителя, результат не возвращается флагами
  19++6000                              ;   SP после внешнего RET равен входному SP+2, следы CALL и сохранений остаются в RAM стека
  20++6000                              ; Corrupt:
  21++6000                              ;   DE, AF только по A, AF' только по A'
  22++6000                              ;   paging, очередь и курсор банка 1 при успехе, восемь байтов временного стека, R
  23++6000                              ; Note:
  24++6000                              ;   первый EX AF сохраняет число на время выбора банка, второй оставляет значение страницы 11 в альтернативном A
  25++6000                              ;   SelectMemoryPage сохраняет BC и не пишет теневую переменную страницы
  26++6000                              ;   локальная модель использует настоящие восемь банков и реальные вызовы, нативный запуск и IRQ не доказаны
  27++6000                              ; -----------------------------------------
  28++6000                              ; сохранение числа A в альтернативном AF перед загрузкой управляющего байта страницы
  29++6000 08           Entry:          EX AF, AF'
  30++6001                              ; выбор управляющего байта 11, Controls находится в банке 1
  31++6001 3E 11                        LD A, @ActionBankPage.Controls
  32++6003 CD 1B AB                     CALL @Action.SelectMemoryPage.Entry
  33++6006                              ; восстановление числа A, в A′ остаётся 11, F′ сохраняется
  34++6006 08                           EX AF, AF'
  35++6007                              ; передача числа в настоящий QueueNumber выбранного банка 1
  36++6007 CD 56 EC                     CALL @Controls.QueueNumber.Entry
  37++600A                              ; фиксированный возврат полной страницы 10, прежний paging не восстанавливается
  38++600A 3E 10                        LD A, @ActionBankPage.Runtime
  39++600C CD 1B AB                     CALL @Action.SelectMemoryPage.Entry
  40++600F C9                           RET
  41++6010
  42++6010                              endmodule
  43++6010                              endmodule
