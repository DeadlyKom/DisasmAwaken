   9++D350                              ;   DE - D=D1, входной E будет заменён начальной колонкой
  10++D350                              ;   BC - текущий экранный указатель, AF - A текущая строка Y
  11++D350                              ;   HL' - L' ошибка левого ребра, BC' его шаг, DE' и H' заменяются, AF' сохраняется
  12++D350                              ;   IX и IY текущие границы, RightVertex и LastIndex задают прямую цепочку в странице C8
  13++D350                              ;   следующее ребро имеет h>0, SP=FFE0, под ним доступны четыре байта временного стека
  14++D350                              ; Out:
  15++D350                              ;   HL - H сохранён, L равен входному D
  16++D350                              ;   DE - D сохранён, при abs(dx)<h E старая колонка, при длинном dx>=0 E=(q XOR 255), при длинном dx<0 E=(q XOR 255)>>1
  17++D350                              ;   q=abs(dx) DIV h, BC полностью сохранён
