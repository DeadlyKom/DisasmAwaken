   2++D9B0                              module BuildSmallBodyMasks
   3++D9B0                              ; Документация [алгоритм и проверка](../../Docs/ControlsSmallMasks.md)
   4++D9B0                              ; -----------------------------------------
   5++D9B0                              ; Подготовка строковых масок малой фигуры из упакованной затравки радиуса
   6++D9B0                              ; исходная запись 22, банк 1, смещения #19B0..#19DD
   7++D9B0                              ; In:
   8++D9B0                              ;   HL и DE входных аргументов не задают, BC задаёт сохраняемый C, AF задаёт A=2..8 как радиус
   9++D9B0                              ;   AF' задаёт A'=0 для Primary либо ненулевой A' для Alternate, исходный F сохраняется в альтернативном AF
  10++D9B0                              ;   банк 1 выбран, исходные затравки сохранены, Row00..Row0B доступны для записи
  11++D9B0                              ;   на CPU-стеке внешний возврат, дополнительный стек не используется, IRQ не вмешиваются
  12++D9B0                              ; Out:
  13++D9B0                              ;   HL указывает AlternateR0+радиус, DE содержит D=0 и E=радиус, BC содержит B=0 и исходный C
  14++D9B0                              ;   A=Packed альтернативной затравки AND PixelsMask, F соответствует AND A с H=1, N=0 и Carry=0
  15++D9B0                              ;   HL', DE', BC' сохраняются, AF' содержит исходный входной AF, IX и IY, I, IM и IFF сохраняются
  16++D9B0                              ;   SP=входной SP+2, R получает 20+[исходный селектор ненулевой]+5*t+3*радиус M1, t=Packed AND CountMask
  17++D9B0                              ;   сначала записаны t арифметически сдвигаемых масок и радиус копий последней, затем Row00 повторно заменена альтернативной маской
  18++D9B0                              ; Corrupt:
  19++D9B0                              ;   HL, DE, B, AF, AF', t+радиус байтов Row00..Row0B, R
  20++D9B0                              ; Note:
  21++D9B0                              ;   для исходных радиусов 2..8 t=floor(радиус/2), максимум записывается 12 разных байтов и 13 записей с повтором Row00
  22++D9B0                              ;   SRA сохраняет знаковый разряд маски, замена на SRL меняет исходные формы
  23++D9B0                              ;   альтернативная маска Row00 загружается независимо от выбранной затравки основной части
  24++D9B0                              ;   радиусы 0 и 1 вне договора, нулевой B не пропускает DJNZ и приводит к 256 проходам с выходом за область масок
  25++D9B0                              ;   соседние 20 исходных байтов после Row0B остаются неразобранными, их назначение не выводится из нулевого заполнения
  26++D9B0                              ;   известный прямой вызывающий UnknownD9DE отсекает радиусы вне 2..8 до CALL, полный рисователь ещё не разобран
  27++D9B0                              ; -----------------------------------------
  28++D9B0                              ; сохранение радиуса в E для индексации затравок и длины повторяемой части
  29++D9B0 5F           Entry:          LD E, A
  30++D9B1 16 00                        LD D, #00
  31++D9B3                              ; выбор базы Primary до проверки альтернативного селектора
  32++D9B3 21 7E D9                     LD HL, @ControlsSmallMaskSeeds.PrimaryR0
  33++D9B6                              ; сохранение исходного радиуса и F в альтернативном AF, получение селектора из A'
  34++D9B6 08                           EX AF, AF'
  35++D9B7                              ; проверка нулевого селектора для выбора затравки
  36++D9B7 A7                           AND A
  37++D9B8 28 03                        JR Z, @Controls.BuildSmallBodyMasks.SelectSeed                  ; переход, если селектор равен нулю, использовать Primary через SelectSeed
  38++D9BA
  39++D9BA                              ; выбор базы Alternate для любого ненулевого селектора
  40++D9BA 21 87 D9                     LD HL, @ControlsSmallMaskSeeds.AlternateR0
  41++D9BD                              ; поиск упакованной затравки с исходным радиусом
  42++D9BD 19           SelectSeed:     ADD HL, DE
  43++D9BE                              ; выделение числового количества сдвигов из разрядов 2..0 Packed
  44++D9BE 7E                           LD A, (HL)
  45++D9BF E6 07                        AND @SmallMaskConst.CountMask
  46++D9C1 47                           LD B, A
  47++D9C2                              ; выделение начальной пиксельной маски из разрядов 7..3 Packed
  48++D9C2 7E                           LD A, (HL)
  49++D9C3 E6 F8                        AND @SmallMaskConst.PixelsMask
  50++D9C5 21 90 D9                     LD HL, @ControlsSmallMaskRows.Row00
  51++D9C8                              ; создание последовательности строк арифметическим сдвигом маски, бит 7 сохраняется
  52++D9C8 77           ShiftMask:      LD (HL), A
  53++D9C9 23                           INC HL
  54++D9CA CB 2F                        SRA A
  55++D9CC 10 FA                        DJNZ @Controls.BuildSmallBodyMasks.ShiftMask
  56++D9CE
  57++D9CE                              ; подготовка числа повторов последней сдвинутой маски по исходному радиусу
  58++D9CE 43                           LD B, E
  59++D9CF                              ; заполнение продолжающей части неизменной сдвинутой маской
  60++D9CF 77           RepeatMask:     LD (HL), A
  61++D9D0 23                           INC HL
  62++D9D1 10 FC                        DJNZ @Controls.BuildSmallBodyMasks.RepeatMask
  63++D9D3
  64++D9D3                              ; поиск альтернативной затравки для обязательной замены Row00 независимо от первого выбора
  65++D9D3 21 87 D9                     LD HL, @ControlsSmallMaskSeeds.AlternateR0
  66++D9D6 19                           ADD HL, DE
  67++D9D7 7E                           LD A, (HL)
