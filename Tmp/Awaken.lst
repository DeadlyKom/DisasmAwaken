   3++E7CA                              ; Документация [точные флаги, оборачивание страницы, физические точки и углы после настоящей настройки](../../Docs/PreviewClipTail.md)
   4++E7CA                              ; -----------------------------------------
   5++E7CA                              ; Добавление угла снизу слева при нулевом запрете углов
   6++E7CA                              ; исходная запись 6, банк 4, файловые смещения #27CA..#27D4
   7++E7CA                              ; In:
   8++E7CA                              ;   HL, DE, BC сохраняемый контекст ветви отказа, AF не является параметром
   9++E7CA                              ;   PreviewClipCorners.Value.BlockCode проверяется целиком, нуль разрешает добавление угла
  10++E7CA                              ;   операнд D3DClipState.MaxXMinY содержит выбранные строку и колонку после ConfigurePreviewClip
  11++E7CA                              ;   ByteCount задаёт байтовый курсор, страница C8 доступна для записи
  12++E7CA                              ; Out:
  13++E7CA                              ;   при ненулевом BlockCode HL, DE и BC сохранены, A=BlockCode, F от AND A с H=1 и Carry=0
  14++E7CA                              ;   при нулевом BlockCode HL=C800+новый курсор, DE выбранное слово угла, BC сохранён
  15++E7CA                              ;   при добавлении A равен новому курсору, F от второго INC L с Carry=0 после AND A
  16++E7CA                              ;   HL', DE', BC', AF', IX, IY, I, IFF и IM сохранены, SP после RET равен входному+2
  17++E7CA                              ;   при отказе память сохранена, при разрешении записаны два байта угла и новый ByteCount
  18++E7CA                              ; Corrupt:
  19++E7CA                              ;   при отказе AF, при добавлении HL, DE, AF, два байта C8 и ByteCount
  20++E7CA                              ; Note:
  21++E7CA                              ;   направления угла относятся к физической строке FirstAxis и колонке SecondAxis
  22++E7CA                              ;   исходное слово LD DE сохранено, установщик меняет его операнд на месте, новая область памяти не создаётся
  23++E7CA                              ; -----------------------------------------
  24++E7CA                              ; чтение целого байта запрета углов без маскирования отдельных разрядов
  25++E7CA 3A 50 C2     Entry:          LD A, (@PreviewClipCorners.Value.BlockCode)
  26++E7CD                              ; проверка разрешения добавления выбранного угла
  27++E7CD A7                           AND A
  28++E7CE C0                           RET NZ                                                          ; выход, если BlockCode ненулевой, добавление угла подавлено
  29++E7CF
  30++E7CF                              ; чтение слова угла из изменяемого операнда MaxXMinY, исходные байты сохранены
  31++E7CF 11 00 00                     LD DE, #0000
  32++E7D2                              ; продолжение общей записи точки без дополнительного CPU-возврата
  33++E7D2 C3 4E E8                     JP @D3D.AppendPreviewClipPoint.Entry
  34++E7D5
  35++E7D5                              endmodule
  36++E7D5                              endmodule
  37++E7D5
