1156+ 0000
1157+ 0000                              ; Четыре физических байта шага сэмпла, сначала читаются как DE, затем как BC
1158+ 0000                              ; ShiftControl, схема разрядов 7..0:
1159+ 0000                              ;   7 6 5 4 3 2 1 0
1160+ 0000                              ;   A D S S S S S F
1161+ 0000                              ; A, обновить поправку уровня, D, единица увеличивает её, ноль уменьшает
1162+ 0000                              ; S, пятибитовый вклад огибающей, шумовой путь использует весь ShiftControl >> 1
1163+ 0000                              ; F, единица пропускает добавление маски огибающей к уровню
1164+ 0000                              ; LevelModes, схема разрядов 7..0:
1165+ 0000                              ;   7 6 5 4 3 2 1 0
1166+ 0000                              ;   E T S M V V V V
1167+ 0000                              ; E, вклад относится к огибающей, иначе к шуму, этот же бит попадает в старшую тройку микшера
1168+ 0000                              ; T, сохранять тональную поправку, S, сохранять шумовой либо огибающий вклад между кадрами
1169+ 0000                              ; M, бит младшей тройки микшера, V, базовый уровень 0..15
1170+ 0000                              ; нулевые управляющие байты задают базовый уровень 0 и режим шума без накопления
1171+ 0000                              struct FMusicSampleStep
1172+ 0000 ~            ShiftControl    db #00                                                          ; совмещённое управление уровнем, сдвигом и маской огибающей
1173+ 0000 ~            LevelModes      db #00                                                          ; базовый уровень, режим вклада и накопления, биты микшера
1174+ 0000 ~            ToneDelta       dw #0000                                                        ; знаковое слово текущей тональной поправки
1175+ 0000                              ends
1176+ 0000                              assert FMusicSampleStep == 4
