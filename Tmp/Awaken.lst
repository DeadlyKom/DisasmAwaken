   1++C882                              module Controls
   2++C882                              module CopyScreenRows
   3++C882                              ; Документация [алгоритм и проверка](../../Docs/ControlsBufferCopy.md)
   4++C882                              ; -----------------------------------------
   5++C882                              ; Стековый перенос страниц линейного растра в символьные строки экрана
   6++C882                              ; исходная запись 22, банк 1, смещения #0882..#0A8C
   7++C882                              ; In:
   8++C882                              ;   HL задаёт источник X, выровненный на 256 байтов, DE и BC входных аргументов не задают, AF задаёт A=n страниц
   9++C882                              ;   HL' задаёт адрес D последнего байта первой половины начальной экранной строки, DE', BC', AF', IX и IY аргументов не задают
  10++C882                              ;   n=1..8, начало приходится на символьную строку, все n строк помещаются в одну треть экрана
  11++C882                              ;   все 256*n байтов источника доступны, H источника не переполняется за доступную RAM
  12++C882                              ;   банк 1 выбран, CONTROL0 и его изменяемые операнды доступны для записи
  13++C882                              ;   источник, экран и CPU-стек не перекрываются, источник не перекрывает код копировщика
  14++C882                              ;   на CPU-стеке находится внешний возврат, обработчик IRQ не должен использовать временный экранный SP
  15++C882                              ; Out:
  16++C882                              ;   скопированы 256*n байтов, каждый экранный адрес записан ровно один раз
  17++C882                              ;   HL=X+256*n, DE и BC содержат слова по адресам P+4 и P+2, где P=X+256*n-16
  18++C882                              ;   A=00, F=42 OR (байт P AND 01), эти флаги получены DEC 1 в 0 с пиксельным Carry
  19++C882                              ;   HL'=D+32*n, DE'=F910, BC' содержит слово P+10, A' содержит байт P+9
  20++C882                              ;   F' получен последним ADD HL,F910, S,Z,PV сохранены из байта P+8, N=0, H,C и биты 5,3 отражают сложение
  21++C882                              ;   IX содержит слово P+6, IY слово P+14, I, IM и IFF сохраняются
  22++C882                              ;   SavedStack содержит входной SP, RemainingPages=01, RET даёт SP=входной SP+2
  23++C882                              ; Corrupt:
  24++C882                              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY, 256*n экранных байтов, SavedStack, RemainingPages, R
  25++C882                              ; Note:
  26++C882                              ;   дополнительных PUSH на CPU-стеке нет, PUSH и POP работают по временным экранным и исходным адресам
  27++C882                              ;   нулевой A не означает пустую операцию, уменьшение происходит после первого копирования, такой вход не входит в договор
  28++C882                              ;   переход через границу трети экрана и перекрытие источника с назначением не входят в договор
  29++C882                              ;   RemainingPages является операндом LD A,nn, SavedStack операндом LD SP,nn
  30++C882                              ; -----------------------------------------
  31++C882                              ; сохранение настоящего SP до назначения временных стеков источника и экрана
  32++C882 ED 73 8A CA  Entry:          LD (@ControlsBufferCopyState.SavedStack), SP
  33++C886                              ; сохранение числа оставшихся страниц до загрузки пикселей в AF и альтернативный AF
  34++C886 32 84 CA     CopyPage:       LD (@ControlsBufferCopyState.RemainingPages), A
