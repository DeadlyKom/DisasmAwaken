  48++D956 ED 53 77 DE                  LD (@MapClipWork.RightProduct.LowWord), DE
  49++D95A 22 79 DE                     LD (@MapClipWork.RightProduct.HighWord), HL
  50++D95D C9                           RET
  51++D95E
  52++D95E                              endmodule
  53++D95E                              endmodule
