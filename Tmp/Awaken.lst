   6++AA33                              ; исходная запись 4, файловые смещения #4A33..#4A3C
   7++AA33                              ; In:
   8++AA33                              ;   HL входа не является параметром, DE индекс выбранного элемента, BC сохраняемый контекст, AF селектор общего действия
   9++AA33                              ;   AF - A=0 выбирает попытку интерактивной геометрии, любой ненулевой A приводит к ActivateItem
