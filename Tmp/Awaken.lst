  28++D4EA 4F                           LD C, A
  29++D4EB                              ; вычисление X правого края как 128+Radius-WorkX по модулю байта
  30++D4EB 3E 80                        LD A, #80
  31++D4ED 82                           ADD A, D
  32++D4EE 90                           SUB B
  33++D4EF                              ; построение адреса и включающей маски правого края, SavedB получает WorkX
  34++D4EF CD 3C D5                     CALL @Controls.BuildRightSpanMask.Entry
  35++D4F2                              ; вычисление младшего адреса фиксированного левого столбца 1
