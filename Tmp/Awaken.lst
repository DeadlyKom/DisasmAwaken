  26++E6B6 EB                           EX DE, HL
  27++E6B7 5E                           LD E, (HL)
  28++E6B8 23                           INC HL
  29++E6B9 56                           LD D, (HL)
  30++E6BA 23                           INC HL
  31++E6BB EB                           EX DE, HL
  32++E6BC                              ; сохранение шага и выбор прямой перезагрузки счётчика после его применения
  33++E6BC 22 A6 E2                     LD (@MusicState.SlideStepC), HL
  34++E6BF 3E 1D                        LD A, #1D
  35++E6C1 32 AD E2                     LD (@MusicState.SlideBranchC), A
