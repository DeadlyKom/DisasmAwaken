# file opened: Source/D3D/BuildPreviewClipTopProduct.asm
   1++E5E8                              module D3D
   2++E5E8                              module BuildPreviewClipTopProduct
   3++E5E8                              ; Документация [производители четырёх кэшей, внутренние входы, разности слов, точные регистры и второй множитель 8000](../../Docs/PreviewClipProducts.md)
   4++E5E8                              ; -----------------------------------------
   5++E5E8                              ; Формирование кэша Top относительно границы с исходным порядком аргументов умножения
   6++E5E8                              ; исходная запись 6, банк 4, файловые смещения #25E8..#2606
   7++E5E8                              ; In:
   8++E5E8                              ;   HL, DE, BC и AF не являются параметрами полного Entry, два физических конца содержат координатные слова
   9++E5E8                              ;   граница подготовлена ConfigurePreviewClip, старший байт слова LD BC сохраняет исходный нуль
  10++E5E8                              ;   HL', DE', BC', AF' сохраняются, IX контекст коротких ветвей умножителя, IY сохраняется
  11++E5E8                              ;   SP указывает на CPU-возврат, под ним доступны четыре байта вложенного CALL и сохранённого AF
  12++E5E8                              ;   внутренний FromDelta принимает DE готовую разность колонок, слова колонок в этом входе не перечитываются
  13++E5E8                              ; Out:
  14++E5E8                              ;   HL и DE содержат старшее и младшее слова результата MultiplyPreviewSignedWords и записаны в кэш Top
  15++E5E8                              ;   BC определяется размерной ветвью и знаком умножителя, исходный BC его входа равен слово границы MinX0
  16++E5E8                              ;   AF - A равен XOR старших байтов двух аргументов, F от знакового XOR либо старшего SBC при отрицании результата
  17++E5E8                              ;   HL', DE', BC', AF' сохранены, IX сохранён короткими ветвями, длинной заменён младшим словом модуля, IY сохранён
  18++E5E8                              ;   I, IFF и IM сохранены, SP после RET равен входному+2, координатные записи не меняются
  19++E5E8                              ;   записаны четыре байта выбранного кэша и четыре байта под входным SP, другие кэши и промежутки не записываются
  20++E5E8                              ; Corrupt:
  21++E5E8                              ;   HL, DE, BC, AF, IX в длинной ветви, четыре байта кэша и четыре байта под CPU-SP
  22++E5E8                              ; Note:
  23++E5E8                              ;   первый аргумент HL равен FirstAxis первого конца минус MinX0, второй DE равен SecondAxis первого конца минус SecondAxis второго
  24++E5E8                              ;   каждая разность формируется отдельно по модулю 65536 с предварительным сбросом Carry
  25++E5E8                              ;   порядок аргументов менять нельзя, для двух длинных модулей и второго 8000 умножитель использует эффективный множитель 256
  26++E5E8                              ;   сам производитель не проверяет коды сторон или геометрическую допустимость, готовность кэша для следующего обработчика проверяется отдельно
  27++E5E8                              ; -----------------------------------------
  28++E5E8                              ; чтение колонок второго и первого конца для полной подготовки разности
  29++E5E8 ED 4B 3C C2  Entry:          LD BC, (@PreviewClipSecond.Value.SecondAxis)
  30++E5EC 2A 2C C2                     LD HL, (@PreviewClipFirst.Value.SecondAxis)
  31++E5EF                              ; сброс Carry перед разностью колонок без изменения A
  32++E5EF B7                           OR A
  33++E5F0                              ; расчёт разности колонок по модулю 65536
  34++E5F0 ED 42                        SBC HL, BC
  35++E5F2                              ; сохранение разности колонок как второго аргумента DE
  36++E5F2 EB                           EX DE, HL
  37++E5F3                              ; внутренний вход с готовым DE, чтение изменяемого слова граничной строки
