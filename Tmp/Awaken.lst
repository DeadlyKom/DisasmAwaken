   3++CE16                              ; Документация [алгоритм и проверка](../../Docs/ControlsPointRespawn.md)
   4++CE16                              ; -----------------------------------------
   5++CE16                              ; Возврат точки с чередованием сторон для неотрицательного индекса управляющей таблицы
   6++CE16                              ; исходная запись 22, банк 1, смещения #0E16..#0E5C
   7++CE16                              ; In:
   8++CE16                              ;   HL, DE, BC, AF входных аргументов не задают, используются PositivePhase, PositiveStep и PositiveYOffset
   9++CE16                              ;   PositiveStep=1..255, R задаёт начальный байт refresh, включая сохраняемый при увеличении бит 7
  10++CE16                              ;   банк 1 выбран, изменяемый фазовый операнд доступен для записи, на CPU-стеке внешний возврат
  11++CE16                              ;   формулы R и точные регистровые выходы проверены без вмешательства IRQ
  12++CE16                              ; Out:
  13++CE16                              ;   HL и B сохранены, DE содержит D=X и E=Y, C=PositiveStep, A=X
  14++CE16                              ;   PositivePhase заменён на исходный байт XOR 01, новое нулевое значение выбирает первую ветвь, любое ненулевое вторую
  15++CE16                              ;   v=MIN(первое чтение R MOD Step,94), первая ветвь Y=(v+YOffset) AND FF и X=HighX
  16++CE16                              ;   вторая ветвь Y=95-v и X=LowX, обе формулы X приведены в ControlsPointRespawn.md
  17++CE16                              ;   F соответствует последней проверке CP либо коррекции ADD/SUB координаты X, R включает все выполненные M1
  18++CE16                              ;   HL', DE', BC', AF', IX и IY, I, IM и IFF сохраняются, SP=входной SP+2
  19++CE16                              ; Corrupt:
  20++CE16                              ;   DE, BC в части C, AF, один фазовый байт, R
  21++CE16                              ; Note:
  22++CE16                              ;   дополнительных PUSH, CALL и портовых операций нет, изменяется только фазовый операнд
  23++CE16                              ;   при Step=0 цикл вычитания не продвигается и не возвращает управление, исходный нулевой шаг требует настройки вызывающим кодом
  24++CE16                              ;   Phase=00 и 01 чередуют ветви, произвольные старшие биты фазы сохраняются и могут запрещать первую ветвь
  25++CE16                              ;   HighX может дать 00 либо FE при произвольном R, границы начальной подготовки 35 точек сюда не переносятся
  26++CE16                              ;   название IndexPos/IndexNeg отражает бит 7 байтового индекса (-control) AND FF, а не знак неограниченного математического числа
  27++CE16                              ; -----------------------------------------
  28++CE16                              ; чтение фазового байта перед переключением младшего бита
  29++CE16 3E 00        Entry:          LD A, #00
  30++CE18                              ; переключение только младшего бита фазового селектора
  31++CE18 EE 01                        XOR #01
  32++CE1A                              ; сохранение новой фазы в исходном операнде LD A,nn
  33++CE1A 32 17 CE                     LD (@ControlsPointRespawnState.PositivePhase), A
  34++CE1D                              ; чтение шага, нулевой шаг создаёт непродвигающийся цикл
  35++CE1D 0E 00                        LD C, #00
  36++CE1F 20 1E                        JR NZ, @Controls.RespawnPointIndexPos.SecondSample              ; переход, если новая фаза ненулевая, выбрать второе сочетание сторон
  37++CE21
  38++CE21                              ; получение первого байта R для остатка по ненулевому шагу
  39++CE21 ED 5F                        LD A, R
  40++CE23                              ; проверка остатка относительно шага перед очередным вычитанием
  41++CE23 B9           FirstModulo:    CP C
  42++CE24 38 04                        JR C, @Controls.RespawnPointIndexPos.CapFirstY                  ; переход, если остаток меньше шага, ограничить вертикальную координату
  43++CE26
  44++CE26 91                           SUB C
  45++CE27 C3 23 CE                     JP @Controls.RespawnPointIndexPos.FirstModulo
  46++CE2A
  47++CE2A                              ; проверка ограничения остатка сверху значением 94
  48++CE2A FE 5E        CapFirstY:      CP #5E
  49++CE2C 38 02                        JR C, @Controls.RespawnPointIndexPos.OffsetFirstY               ; переход, если остаток меньше 94, не загружать ограничитель
  50++CE2E
  51++CE2E 3E 5E                        LD A, #5E
  52++CE30                              ; вычисление Y первой ветви с исходным байтовым смещением
  53++CE30 C6 00        OffsetFirstY:   ADD A, #00
  54++CE32 5F                           LD E, A
  55++CE33                              ; получение второго R и смещение горизонтальной координаты на 128
  56++CE33 ED 5F                        LD A, R
  57++CE35 C6 80                        ADD A, #80
  58++CE37                              ; проверка верхней границы смещённого X
  59++CE37 FE FE                        CP #FE
  60++CE39 38 02                        JR C, @Controls.RespawnPointIndexPos.AcceptFirstX               ; переход, если X меньше 254, сохранить координату без коррекции
  61++CE3B
  62++CE3B D6 01                        SUB #01
  63++CE3D                              ; возврат горизонтальной координаты в D, вертикальная уже находится в E
  64++CE3D 57           AcceptFirstX:   LD D, A
  65++CE3E C9                           RET
  66++CE3F
  67++CE3F                              ; получение первого R для отражённой вертикальной ветви
  68++CE3F ED 5F        SecondSample:   LD A, R
  69++CE41                              ; проверка остатка второй ветви относительно шага
  70++CE41 B9           SecondModulo:   CP C
  71++CE42 38 04                        JR C, @Controls.RespawnPointIndexPos.CapSecondY                 ; переход, если остаток меньше шага, ограничить его перед отражением
  72++CE44
  73++CE44 91                           SUB C
  74++CE45 C3 41 CE                     JP @Controls.RespawnPointIndexPos.SecondModulo
  75++CE48
  76++CE48                              ; проверка верхнего ограничения 94 для отражённой координаты
  77++CE48 FE 5E        CapSecondY:     CP #5E
  78++CE4A 38 02                        JR C, @Controls.RespawnPointIndexPos.MirrorSecondY              ; переход, если остаток меньше 94, сохранить его без загрузки ограничителя
  79++CE4C
  80++CE4C 3E 5E                        LD A, #5E
  81++CE4E                              ; вычисление отражённой координаты Y=95-остаток
  82++CE4E D6 5F        MirrorSecondY:  SUB #5F
  83++CE50 ED 44                        NEG
  84++CE52 5F                           LD E, A
  85++CE53                              ; получение второго R без горизонтального смещения
  86++CE53 ED 5F                        LD A, R
  87++CE55                              ; проверка нулевого X перед заменой на 1
  88++CE55 FE 01                        CP #01
  89++CE57 30 02                        JR NC, @Controls.RespawnPointIndexPos.AcceptSecondX             ; переход, если X не равен нулю, не выполнять прибавление 1
  90++CE59
  91++CE59 C6 01                        ADD A, #01
  92++CE5B                              ; возврат второго сочетания X в D и Y в E
  93++CE5B 57           AcceptSecondX:  LD D, A
  94++CE5C C9                           RET
  95++CE5D
  96++CE5D                              endmodule
  97++CE5D                              endmodule
