   1++C5E8                              module Map
   2++C5E8                              module SelectNearestMapVariant
   3++C5E8              ; Документация [Map](../../Docs/FunctionDetails/Map.md)
   4++C5E8              ; Подробный разбор [шесть курсоров, необычные количества и полная арифметика целевой пары](../../Docs/NearestMapVariant.md)
   5++C5E8              ; -----------------------------------------
   6++C5E8              ; Выбор первого ближайшего варианта карты по текущим парам координат
   7++C5E8              ; исходная запись 7, файловые смещения #05E8..#0652
   8++C5E8              ; In:
   9++C5E8              ;   HL - входная упакованная пара Origin, AF - A число вариантов, F не влияет на результат
  10++C5E8              ;   StationState.PointerXY содержит PointerWord, Cursor0..Cursor5 в MapVariantState указывают на доступные пары X,Y
  11++C5E8              ;   KARTA выбран и доступен для самомодификации, MapSelection.Variant доступен для записи, обычный стек доступен
  12++C5E8              ; Out:
  13++C5E8              ;   DE=Target=(PointerWord-(8*((Origin+0404)&FFFF)+0603))&FFFF, D целевой Y, E целевой X
  14++C5E8              ;   N=A при A=1..5, иначе N=6, рассмотрены первые N курсоров в исходном порядке
  15++C5E8              ;   MapDistanceState.Minimum содержит минимальную сумму квадратов знаковых байтовых разностей от Target
  16++C5E8              ;   HL=Cursor[N-1]+1 modulo 65536, BC - C индекс первого минимального варианта 0..N-1
  17++C5E8              ;   B=0 при N<6, иначе B=(входной A-5)&FF, A и MapSelection.Variant равны C
  18++C5E8              ;   при N<6 F=42 OR Carry последнего сравнения, при N=6 F сохранён от последнего UpdateMapDistanceMinimum
  19++C5E8              ;   HL', DE', BC', AF' соответствуют последнему UpdateMapDistanceMinimum, B'=0, C' сохранён
  20++C5E8              ;   IX, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  21++C5E8              ; Corrupt:
  22++C5E8              ;   HL, DE, BC, AF, HL', DE', BC' только B', AF', Minimum и MapSelection.Variant
  23++C5E8              ; Note:
  24++C5E8              ;   первый кандидат всегда уменьшает начальное FFFF, поскольку сумма квадратов не превышает 32768
  25++C5E8              ;   при равных расстояниях индекс не меняется, получается первый из ближайших кандидатов
  26++C5E8              ;   количество 0 не означает пустой список, оно и любое A>=6 приводят к рассмотрению шести курсоров
  27++C5E8              ;   Origin складывается и масштабируется целым словом, переносы между координатными байтами не разделяются
  28++C5E8              ;   курсорные операнды и исходные пары не меняются, формат остальной части потоков ещё разбирается
  29++C5E8              ;   помощник расстояния учитывает знаковые байтовые разности, [его отдельный договор](../../Docs/MapDistanceMinimum.md)
  30++C5E8              ;   достижимость восстановлена через [действия интерфейса](../../Docs/StationEventActions.md)
  31++C5E8              ; -----------------------------------------
  32++C5E8                              ; чтение текущей упакованной позиции указателя для преобразования в координаты вариантов
  33++C5E8 ED 5B 07 63  Entry:          LD DE, (@StationState.PointerXY)
