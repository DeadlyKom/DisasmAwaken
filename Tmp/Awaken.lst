  10++6757              ;   AF - A содержит верхний предел X, который сохраняется во временном L
  11++6757              ; Out:
  12++6757              ;   BC - координаты после шага вправо, DE сохраняется, AF рабочий
  13++6757              ;   H сохраняется, L содержит входной верхний предел X
  14++6757              ; Corrupt:
  15++6757              ;   HL, BC, AF
  16++6757              ; Note:
