# file opened: Source/Controls/QueueNumber.asm
   1++EC56                              module Controls
   2++EC56                              module QueueNumber
   3++EC56                              ; Документация [производитель текстовой очереди](../../Docs/TextQueueProducer.md)
   4++EC56                              ; -----------------------------------------
   5++EC56                              ; Подготовка числовой записи типа 2 из A и продолжение в производителе текстовой очереди
   6++EC56                              ; исходная запись 23, банк 1, файловые смещения #1178..#117A
   7++EC56                              ; In:
   8++EC56                              ;   HL сохраняется, DE входных аргументов не задаёт, формируется слово 0200 OR A
   9++EC56                              ;   BC сохраняется, AF задаёт A исходного байтового числа и сохраняется целиком
  10++EC56                              ;   выбран банк 1 с CONTROL0 и CONTROL, код и таблица доступны для записи, WriteCursor указывает Slot00..Slot0F либо End
  11++EC56                              ;   HighKind=00 является концом кольца, HighKind=01 свободной записью, поиск ограничен 16 чтениями
  12++EC56                              ;   на CPU-стеке находится внешний возврат, требуется ещё шесть байтов для сохранённых HL, BC и AF
  13++EC56                              ;   локальный договор не включает вмешательство ISR, процедура сама DI не выполняет
  14++EC56                              ; Out:
  15++EC56                              ;   HL сохранён, DE=0200 OR входной A, BC и AF сохранены
  16++EC56                              ;   при найденном HighKind=01 записаны D и E, WriteCursor получает адрес после двух байтов записи
  17++EC56                              ;   маркер HighKind=00 переносит поиск на Slot00 и тоже расходует одну из 16 попыток
  18++EC56                              ;   если за 16 чтений свободная запись не найдена, очередь и WriteCursor не меняются, признака отказа в регистрах нет
  19++EC56                              ;   рамка сохранённых регистров остаётся в RAM стека, внешний RET задаёт SP=входной SP+2
  20++EC56                              ;   HL', DE', BC', AF', IX, IY, I, IM и IFF сохраняются, портов ввода и вывода нет
  21++EC56                              ; Corrupt:
  22++EC56                              ;   DE при QueueNumber, шесть байтов рамки CPU-стека, найденная запись и WriteCursor при успехе, R
  23++EC56                              ; Note:
  24++EC56                              ;   запись хранит D перед E, указатель строки физически big endian, это два байтовых поля, не DW little endian
  25++EC56                              ;   тип 02 потребитель передаёт десятичному выводу байта, это число с минимальной шириной два знака, не код символа
  26++EC56                              ;   D=00 и D=01 не проверяются производителем, такая запись при дальнейшем чтении означает маркер либо свободное место
  27++EC56                              ;   при старте на End и единственном свободном Slot0F поиск возвращает отказ, исходная особенность не исправлена
  28++EC56                              ;   QueueNumber не делает CALL к QueueTextItem, исполнение продолжается физически, см. TextQueueProducer.md
