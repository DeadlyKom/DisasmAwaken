# file opened: Source/Controls/FillInteriorRowsUp.asm
   1++D208                              module Controls
   2++D208                              module FillInteriorRowsUp
   3++D208                              ; Документация [алгоритм и проверка](../../Docs/ControlsInteriorRows.md)
   4++D208                              ; -----------------------------------------
   5++D208                              ; Заливка внутренних 30 байтов строк вверх с ограничением верхним краем
   6++D208                              ; исходная запись 22, банк 1, смещения #1208..#1210
   7++D208                              ; In:
   8++D208                              ;   HL и DE входного положения не задают, DE сохраняется, AF задаёт A=0..95 как первую строку
   9++D208                              ;   BC задаёт B=0..255 как число строк, исходный C заменяется строкой A
  10++D208                              ;   IX задаёт IXL как рисунок заполнения и IXH как XOR двух чередующихся рисунков
  11++D208                              ;   банк 1 выбран, код, буфер 8000..8BFF и CPU-стек доступны для записи и не перекрываются
  12++D208                              ;   на CPU-стеке внешний возврат, ещё шесть байтов нужны для SavedDE, SavedAF, SavedBC, IRQ не вмешиваются
  13++D208                              ; Out:
  14++D208                              ;   число заполненных строк n=min(B, A+1), в каждой меняются только столбцы 1..30
  15++D208                              ;   HL=8000+32*входной A+31-32*n, DE сохраняется, BC=входной B:входной A
  16++D208                              ;   AF содержит входную строку A и F от AND Mode, Z относится к Mode, а не к байту возвращаемого A
  17++D208                              ;   IXH сохраняется, IXL меняется на входной IXL XOR IXH только при нечётном n
  18++D208                              ;   HL', DE', BC', AF', IY, I, IM и IFF сохраняются, SP=входной SP+2
  19++D208                              ;   при B=0 R получает 29 M1, иначе 30+75*n минус один при остановке по краю
  20++D208                              ; Corrupt:
  21++D208                              ;   HL, BC, AF, IXL, RowStep, BoundaryLimit, BoundaryBranch, шесть байтов CPU-стека, внутренние столбцы строк, R
  22++D208                              ; Note:
  23++D208                              ;   при B=0 буфер и IXL не меняются, операнды и сохранённая рамка всё равно записываются
  24++D208                              ;   после последней строки IXL переключается даже при немедленном выходе по границе
  25++D208                              ;   верхняя граница задаётся CP 80 и JR C, нижняя CP 8C и JR NC, это изменение кода, не только числа
  26++D208                              ;   полоса использует линейный растр по 32 байта, преобразование в нелинейный экран выполняется отдельно
  27++D208                              ; -----------------------------------------
  28++D208                              ; сохранение номера первой строки в C до чтения Mode для исходного набора F
  29++D208 4F           Entry:          LD C, A
  30++D209 3A 8C D1                     LD A, (@ControlsInteriorRowsState.Mode)
  31++D20C                              ; проверка нулевого Mode для возврата его Z после заливки
  32++D20C A7                           AND A
  33++D20D 79                           LD A, C
  34++D20E C3 8A D5                     JP @Controls.PrepareInteriorSpan.FillRowsUp
  35++D211
  36++D211                              endmodule
  37++D211                              endmodule
  38++D211
