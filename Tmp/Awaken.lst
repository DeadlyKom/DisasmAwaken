  10++7D77              ;   DrawItemState.Opcode35 равен #21 для работы либо #C9 для отключения
  11++7D77              ;   при активном коде в окне #C000 выбрана страница станционного кода, действует полный договор DrawCenteredItem
  12++7D77              ;   на CPU-стеке находится адрес возврата вызывающей стороны
  13++7D77              ; Out:
  14++7D77              ;   при активном коде HL - индекс из DrawItemState.Index35, DE и BC сохранены
  15++7D77              ;   при активном коде AF - A=#C3, F от последнего текстового прохода общего рисователя
  16++7D77              ;   при отключённом коде обычный RET сохраняет все регистры и флаги, включая исходный HL
