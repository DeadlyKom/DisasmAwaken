  36++ED00
  37++ED00 80                           ADD A, B
  38++ED01 47                           LD B, A
  39++ED02 79                           LD A, C
  40++ED03                              ; преобразование количества сотен в код ASCII
  41++ED03 C6 30                        ADD A, #30
  42++ED05                              ; сохранение остатка в B на CPU-стеке на время рисования цифры
  43++ED05 C5                           PUSH BC
  44++ED06 CD C4 EF                     CALL @Controls.PrintTextGlyph.Entry
  45++ED09 F1                           POP AF
