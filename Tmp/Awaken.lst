   1++D30B                              module Controls
   2++D30B                              module ReadByteSquare
   3++D30B                              ; Документация [алгоритм и проверка](../../Docs/ControlsSquares.md)
   4++D30B                              ; -----------------------------------------
   5++D30B                              ; Чтение 16-битного квадрата байтового индекса из двух физических плоскостей
   6++D30B                              ; исходная запись 22, банк 1, смещения #130B..#1313
   7++D30B                              ; In:
   8++D30B                              ;   HL сохраняется, DE входных аргументов не задаёт, BC сохраняется, AF задаёт A как индекс 0..255 и входной Carry
   9++D30B                              ;   банк 1 выбран, исходные Low00..LowFF и High00..HighFF таблицы квадратов сохранены
  10++D30B                              ;   на CPU-стеке внешний возврат, ещё два байта нужны для сохранения HL, IRQ не вмешиваются
  11++D30B                              ; Out:
  12++D30B                              ;   HL сохраняется, DE=входной A*входной A, BC и A сохраняются
  13++D30B                              ;   F=80 OR входной Carry из-за INC H от C3 до C4, это не флаги числа DE
  14++D30B                              ;   HL', DE', BC', AF', IX и IY, I, IM и IFF сохраняются, SP=входной SP+2, R получает восемь M1
  15++D30B                              ; Corrupt:
  16++D30B                              ;   DE, F, два байта CPU-стека, R
  17++D30B                              ; Note:
  18++D30B                              ;   два байта результата находятся в разных страницах по одному индексу, физически это не таблица слов DW
  19++D30B                              ;   Carry сохраняется и используется вызывающим SqrtSquareDiff в исходном SBC
  20++D30B                              ; -----------------------------------------
  21++D30B                              ; сохранение исходного HL на время обращения к двум разрядным плоскостям
  22++D30B E5           Entry:          PUSH HL
  23++D30C                              ; поиск младшего байта квадрата в странице ControlsSquareTable.Low00
  24++D30C 26 C3                        LD H, @ControlsSquareConst.LowPage
  25++D30E 6F                           LD L, A
  26++D30F 5E                           LD E, (HL)
  27++D310                              ; выбор той же позиции в следующей странице High00, INC H сохраняет входной Carry
  28++D310 24                           INC H
  29++D311 56                           LD D, (HL)
  30++D312 E1                           POP HL
  31++D313 C9                           RET
  32++D314
  33++D314                              endmodule
  34++D314                              endmodule
