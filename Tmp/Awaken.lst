   2++C1EC                              module ReadSecondWeight
   3++C1EC              ; Документация [Text](../../Docs/FunctionDetails/Text.md)
   4++C1EC              ; Подробный разбор [байтовая сумма, прямой вес и флаги инверсии](../../Docs/WeightFields.md)
   5++C1EC              ; -----------------------------------------
   6++C1EC              ; Чтение кодированного веса второго набора либо его свойства s или n
   7++C1EC              ; исходная запись 5, файловые смещения #01EC..#0200
   8++C1EC              ; In:
   9++C1EC              ;   IX - начало необязательного индекса либо точки, доступна выбранная строка и компонента смещения соответствующего набора
  10++C1EC              ;   первый набор использует GetEquipIndex, второй SumSecondaryIndex, индекс по умолчанию их младший байт
  11++C1EC              ;   при обычном возврате суффикс отсутствует либо равен s или n, применяется ParseFieldSuffix
  12++C1EC              ; Out:
  13++C1EC              ;   без точки HL=(база 98F6 + индекс) AND #FFFF, DE=A декодированный вес 0..127
  14++C1EC              ;   без точки BC содержит исходный байтовый индекс с B=0, он не меняется при явном числе
  15++C1EC              ;   без точки F от OR A исходного байта при bit7=0, иначе от CPL после OR A исходного байта
  16++C1EC              ;   при исходном FF результат ноль, но Z=0, при исходном 00 результат ноль и Z=1
  17++C1EC              ;   с суффиксом s результат CheckThresholdSet30 либо CheckThresholdSet14, n результат HasActiveNeighbor либо HasSecondActiveNeighbor
  18++C1EC              ;   HL', DE' сохранены, BC' - B'=2, C' сохранён, AF' меняется только при банковом запросе s
  19++C1EC              ;   IX - первый непрочитанный символ, IY, I и IFF сохранены, SP обычного возврата равен входному SP+2
  20++C1EC              ;   FieldSuffixState.DefaultTarget содержит локальный ReadDirect
  21++C1EC              ; Corrupt:
  22++C1EC              ;   HL, DE, BC, AF, BC' только B, AF' на пути s, IX
  23++C1EC              ; Note:
  24++C1EC              ;   явное число преобразуется в (число-1) AND #FFFF, прямое чтение не обрезает индекс повторно
  25++C1EC              ;   для байта с bit7=1 используется XOR FF, не абсолютная величина знакового числа
  26++C1EC              ;   CPL сохраняет S/Z/PV от OR исходного байта, устанавливает H/N, X/Y берёт из инвертированного результата
  27++C1EC              ;   общий ReadAtBase первого входа принимает полный HL индекс и DE произвольную базу
  28++C1EC              ;   неизвестный суффикс передаёт управление SkipLine, полного обычного результата тогда нет
  29++C1EC              ;   смысл компонентов вторичного индекса и игровые единицы весов ещё не доказаны
  30++C1EC              ; -----------------------------------------
  31++C1EC                              ; установка числа двух свойств s и n второго набора
  32++C1EC D9           Entry:          EXX
  33++C1ED 06 02                        LD B, #02
  34++C1EF D9                           EXX
  35++C1F0                              ; выбор адреса за одной записью до свойств второго набора
  36++C1F0 11 F2 C9                     LD DE, #C9F2
  37++C1F3                              ; получение вторичного индекса суммой исходных компонент
  38++C1F3 CD 0C C9                     CALL @Text.SumSecondaryIndex.Entry
  39++C1F6                              ; выбор прямого чтения веса второго набора
  40++C1F6 21 FC C1                     LD HL, @Text.ReadSecondWeight.ReadDirect
  41++C1F9 C3 EE C7                     JP @Text.ParseFieldSuffix.Entry
  42++C1FC
  43++C1FC                              ; выбор второй базы весов перед общим декодированием
  44++C1FC 11 F6 98     ReadDirect:     LD DE, #98F6
  45++C1FF 18 DA                        JR @Text.ReadEquipmentWeight.ReadAtBase
