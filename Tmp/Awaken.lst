  35++C5D4                              ; расчёт адреса StockAndSaleBan выбранной строки
  36++C5D4 19                           ADD HL, DE
  37++C5D5                              ; выбор результата ложь до проверки старшего маркера
  38++C5D5 AF                           XOR A
  39++C5D6                              ; флаг, запрет продажи StockAndSaleBan выбирает ложь для штрафной ветви сценария
  40++C5D6 CB 7E                        BIT @MarketRowConst.SaleBanBit, (HL)
  41++C5D8 20 01                        JR NZ, @Text.IsMarketSaleLegal.ReturnResult                     ; переход, если bit7 StockAndSaleBan установлен, вернуть нулевой результат
  42++C5DA
