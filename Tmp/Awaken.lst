  53++DE31 18 29                        JR @Music.TickDispatch.ApplyVolume
  54++DE33
  55++DE33                              ; сброс курсоров сэмпла и орнамента, накопителей шума и огибающей, счётчиков скольжения и чередования
  56++DE33 32 FA DF                     LD (@MusicChannelAState.SampleCursor), A
