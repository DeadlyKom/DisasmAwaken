   5++D518                              ; Табличная аппроксимация произведения байтов A и E через разность свёрнутых квадратов
   6++D518                              ; исходная запись 6, банк 4, файловые смещения #1518..#1524
   7++D518                              ; In:
   8++D518                              ;   HL - H=C3, страница исходной FoldedSquare127, младший L произвольный
   9++D518                              ;   DE - E рабочий выход таблицы, входной множитель находится в E
  10++D518                              ;   BC - сохраняемый контекст
  11++D518                              ;   AF - A первый знаковый байтовый множитель, входной F не является параметром
  12++D518                              ; Out:
  13++D518                              ;   HL - H=C3, L индекс суммы половин по точной формуле алгоритма
  14++D518                              ;   DE - D сохранён, E содержит значение таблицы по индексу разности половин, BC сохранён
  15++D518                              ;   AF - A разность двух табличных значений по модулю 256, F от последнего SUB, P/V=0 для исходной страницы C3
  16++D518                              ;   HL', DE', BC', AF', IX, IY, I, IFF и IM сохраняются, SP обычного возврата равен входному SP+2
  17++D518                              ;   память и порты не записываются, входной множитель E заменён первым табличным значением
  18++D518                              ; Corrupt:
  19++D518                              ;   HL, DE, AF
  20++D518                              ; Note:
  21++D518                              ;   обе арифметические половины округляются вниз, включая отрицательные нечётные значения
  22++D518                              ;   индекс разности равен SRA(A)-SRA(E) по модулю 256, индекс суммы получается добавлением полного исходного E
  23++D518                              ;   точная таблица T(i)=floor(min(i,255-i)^2/127), отрицательные индексы сворачиваются дополнением, а не модулем знакового числа
  24++D518                              ;   это аппроксимация произведения через разность квадратов, она не равна точному умножению с делением на 128
  25++D518                              ;   входной 80 обрабатывается исходными сдвигами и таблицей без отдельного исправления
  26++D518                              ;   договор доказан для исходной страницы C3, произвольная другая страница в H не подтверждается
  27++D518                              ; -----------------------------------------
  28++D518                              ; расчёт арифметической половины первого множителя с округлением вниз
  29++D518 CB 2F        Entry:          SRA A
  30++D51A                              ; чтение второго множителя E перед вычислением его половины
  31++D51A 6B                           LD L, E
  32++D51B                              ; расчёт арифметической половины второго множителя, отрицательные нечётные округляются вниз
  33++D51B CB 2D                        SRA L
  34++D51D                              ; расчёт байтового индекса разности половин с исходным оборачиванием
  35++D51D 95                           SUB L
  36++D51E 6F                           LD L, A
  37++D51F                              ; расчёт индекса суммы добавлением полного исходного второго множителя
  38++D51F 83                           ADD A, E
  39++D520                              ; поиск первого значения свёрнутого квадрата по индексу разности
  40++D520 5E                           LD E, (HL)
  41++D521 6F                           LD L, A
  42++D522                              ; поиск второго значения по индексу суммы
  43++D522 7E                           LD A, (HL)
  44++D523                              ; расчёт разности квадратов, возвращаемой как байтовое приближение произведения
  45++D523 93                           SUB E
  46++D524 C9                           RET
  47++D525
  48++D525                              endmodule
  49++D525                              endmodule
