   9++C849              ;   DE - шестнадцатибитное смещение от найденного разделителя FE
  10++C849              ;   BC - B число разделителей FE, C сохраняемый контекст, AF - A число разделителей FF
  11++C849              ;   нулевой A либо B означает 256 повторений соответствующего поиска
  12++C849              ;   таблица читается начиная с #9A49, все требуемые разделители должны существовать
  13++C849              ;   для обычного табличного поиска каждый разделитель найден до полного оборота адресов и код LANG доступен для записи
  14++C849              ; Out:
  15++C849              ;   HL - (адрес найденного FE + входной DE) AND #FFFF, DE сохранён
  16++C849              ;   BC - B=0, C сохранён, AF - A=#FE, флаги от последнего ADD HL,DE
  17++C849              ;   S/Z/PV сохраняются от последнего CPIR, при найденном FE S=0, Z=1
  18++C849              ;   PV=1, если после последнего поиска BC ядра не нулевой, H/C от сложения адреса и DE, N=0
  19++C849              ;   альтернативные регистры, IX, IY, I и IFF сохранены, SP восстановлен
  20++C849              ;   операнды GroupCount и RecordCount содержат исходные A и B
  21++C849              ; Corrupt:
  22++C849              ;   HL, BC только B, AF
  23++C849              ; Note:
  24++C849              ;   каждый CPIR начинает с BC=0, внутренний предел составляет 65536 сравнений, внешний B хранится на CPU-стеке
  25++C849              ;   при отсутствии разделителя CPIR не возвращает отдельную ошибку, внешний цикл всё равно продолжает поиск
  26++C849              ;   требование существования разделителей ограничивает смысл табличного результата, исходный код проверки не добавляет
  27++C849              ;   смещение отсчитывается от самого FE после DEC HL, не от следующего байта
  28++C849              ;   повторный вход с другими счётчиками до завершения нарушает самомодифицированные операнды
