  20++CCAF              ;   альтернативные и индексные регистры, I и IFF сохраняются, SP восстанавливается
  21++CCAF              ;   SetBandFillMode при бите 0 FillMode переходит в ResetBandMode, дополнительного CALL не создаёт
  22++CCAF              ;   восстановление всегда задаёт исходный режим, не сохраняет произвольные прежние цели
  23++CCAF              ;   эффект относится к последующим DrawBandFrame, рамка и пиксели здесь не рисуются
  24++CCAF              ; -----------------------------------------
  25++CCAF                              ; выбор обычного установщика для строки 11 перед чтением режима заливки
  26++CCAF 11 C0 C1     Entry:          LD DE, @Station.SetOutlinePattern.Entry
  27++CCB2                              ; проверка бита 0 FillMode с сохранением остальных разрядов в результате RRA
  28++CCB2 3A B4 99                     LD A, (@StationRaster.FillMode)
  29++CCB5 1F                           RRA
  30++CCB6 38 1C                        JR C, @Station.ResetBandMode.Entry                              ; переход, если бит 0 FillMode установлен, восстановить обычный режим рамки
  31++CCB8
  32++CCB8                              ; сохранение обычной боковой линии 11 и выбор заполненного узора для остальных изменяемых участков
  33++CCB8 ED 53 F2 C0                  LD (@StationRaster.BandLine11), DE
  34++CCBC 11 CF C1                     LD DE, @Station.SetCutoutPattern.Entry
  35++CCBF ED 53 3E C1                  LD (@StationRaster.BandBottom0), DE
  36++CCC3 ED 53 F8 C0                  LD (@StationRaster.BandLine12), DE
  37++CCC7 ED 53 FF C0                  LD (@StationRaster.BandSides), DE
  38++CCCB ED 53 44 C1                  LD (@StationRaster.BandBottom1), DE
  39++CCCF ED 53 95 C0                  LD (@StationRaster.BandDefault), DE
  40++CCD3 C9                           RET
  41++CCD4
  42++CCD4                              endmodule
  43++CCD4                              endmodule
