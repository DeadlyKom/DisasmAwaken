  27++C5E2 CD 6F C8                     CALL @Text.ComputeWeightedLoad.Entry
  28++C5E5                              ; передача итогового байта в DE с нулевым старшим байтом
  29++C5E5 5F                           LD E, A
  30++C5E6 16 00                        LD D, #00
  31++C5E8 C9                           RET
