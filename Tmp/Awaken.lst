  23++C199                              ; получение индекса банка 4 даже для нулевого режима выбора
  24++C199 CD 1D AA     Entry:          CALL @Station.SumBank4Index.Entry
  25++C19C                              ; получение режима из альтернативного A после банкового запроса
  26++C19C 08                           EX AF, AF'
  27++C19D                              ; проверка ненулевого режима выбора записи
  28++C19D B7                           OR A
  29++C19E                              ; выбор суммы C как записываемого индекса без изменения флагов режима
  30++C19E 79                           LD A, C
  31++C19F 20 02                        JR NZ, @Text.SetPrimarySelection.StoreSelection                 ; переход, если режим ненулевой, записать индекс банка 4
  32++C1A1
  33++C1A1                              ; выбор кода FF при нулевом режиме
  34++C1A1 3E FF                        LD A, #FF
  35++C1A3                              ; обновление первичного байта выбора без изменения F
  36++C1A3 32 49 98     StoreSelection: LD (#9849), A
  37++C1A6 C9                           RET
